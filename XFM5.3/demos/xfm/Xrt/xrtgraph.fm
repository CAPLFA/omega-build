                    }
                } y
                widget XtXrtGraph {
                    flag {
                        mapped
                        autosize
                        autopos
                    }
                    createproc {
                        global text;\
global handle;\
global text_visible;\
text = 0;\
handle = 0;\
text_visible = 0;
                    }
                    resources {
                        xrtYMax = 400.00
                        xrtYMin = 0
                        xrtXPrecision = 0
                        xrtXNum = 1
                        xrtYNum = 100.00
                        xrtYTick = 20
                        topAttachment = attach_form
                        topOffset = 10
                        leftAttachment = attach_form
                        leftOffset = 10
                        rightAttachment = attach_form
                        rightOffset = 10
                        bottomAttachment = attach_widget
                        bottomOffset = 10
                        bottomWidget = x
                        shadowThickness = 0
                        xrtGraphBorder = Border3dIn
                        translations = #override\
<Btn1Down> : eval("global grabbed;
	global movingset;
	global movingpoint;
	where = XrtPickEvent (self,XRT_DATASET1,$,XrtPickResult (0),XRT_POINTFOCUS);
	if (where == XRT_RGN_IN_GRAPH && XrtPickDistance (XrtPickResult (0)) < 5) {
		if (FmGrabPointer (self,True,True,'crosshair',$) == GrabSuccess) {
			grabbed = True;
			movingset = XrtPickSet (XrtPickResult (0));
			movingpoint = XrtPickPoint (XrtPickResult (0));
		}
	}\n")\
<Btn1Up> : eval("global grabbed;
	global movingset;
	global movingpoint;
	if (grabbed) {
		FmUngrabPointer (self,$);
		grabbed = False;
		where = XrtMapEvent (self,XRT_DATASET1,$,XrtMapResult (0));
		if (where == XRT_RGN_IN_GRAPH) {
			XrtDataHandle data_handle = XrtDataHandle(self:xrtData);
			if (XrtDataHandleSetPoint (data_handle,movingset,movingpoint,
					 XrtMapXValue (XrtMapResult (0)),
					 XrtMapYValue (XrtMapResult (0))))
				self:xrtData = XrtData(data_handle);
		}
	}
	")\
<Btn3Down> : eval("global Boolean text_visible;
	global XrtTextHandle text_handle;
	if (text_handle == 0) {
		text_handle = XrtTextAreaCreate(self);
		String the_strings[Int];
		the_strings = new_array();
		the_strings[0] = 'Set this text';
		the_strings[1] = 'with Button 3';
		the_strings[3] = NULL;
		XrtProperty prop;
		XrtTextAreaSetValues(text_handle, XRT_TEXT_STRINGS, data(the_strings), NULL);
		destroy(the_strings);
	}
	r = XrtPickEvent (self,XRT_DATASET1,$,XrtPickResult(0),XRT_POINTFOCUS);
	if (r == XRT_RGN_IN_GRAPH && XrtPickDistance (XrtPickResult (0)) <= 5) {
		XrtTextAreaSetValues(text_handle, 
				XRT_TEXT_ATTACH_TYPE, XRT_TEXT_ATTACH_DATA, 
				XRT_TEXT_ATTACH_DATASET, XRT_DATASET1, 
				XRT_TEXT_ATTACH_SET, XrtPickSet (XrtPickResult (0)), 
				XRT_TEXT_ATTACH_POINT, XrtPickPoint (XrtPickResult (0)), 
				NULL);
		if (!text_visible) {
			text_visible = True;
			XrtTextAreaSetValues(text_handle, XRT_TEXT_IS_SHOWING, text_visible, NULL);
		}
	} else {
		if (text_visible) {
			text_visible = False;
			XrtTextAreaSetValues(text_handle, XRT_TEXT_IS_SHOWING, text_visible, NULL);
		}
	}
	
	")\
<Btn1Motion> : eval("global grabbed;
	global movingset;
	global movingpoint;
	if (grabbed) {
		where = XrtMapEvent (self,XRT_DATASET1, $, XrtMapResult (0));
		if (where == XRT_RGN_IN_GRAPH) {
			XrtDataHandle data_handle = XrtDataHandle(self:xrtData);
			if (XrtDataHandleSetPoint (data_handle, movingset, movingpoint,
					 XrtMapXValue (XrtMapResult (0)),
					 XrtMapYValue (XrtMapResult (0))))
				self:xrtData = XrtData(data_handle);
		}
	}
	")
                        xrtData = xrtgraph.data
                        xrtXTick = 1
                    }
                } graph
            }
        } XmForm0
    }
} ApplicationShell1
