widget ApplicationShell {
    flag {
        mapped
    }
    resources {
        x = 248
        y = 51
        width = 407
        height = 403
        title = XRT/graph Example
    }
    children {
        widget XmForm {
            flag {
                mapped
            }
            resources {
                x = 0
                y = 0
                width = 407
                height = 403
            }
            children {
                widget XmPushButton {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        labelString = New Array
                        marginHeight = 3
                        marginWidth = 5
                        fontList = *helvetica-bold-r-*-14-*
                        topAttachment = attach_none
                        leftAttachment = attach_form
                        leftOffset = 10
                        bottomAttachment = attach_form
                        bottomOffset = 10
                        activateCallback = XrtDataHandle data_handle;\
data_handle = XrtDataHandle(parent.graph:xrtData);\
if (data_handle != NULL) {
	parent.graph:xrtData = NULL;
	XrtDataDestroy (data_handle);\
}\
s = parent.set:value;\
n = atoi (s);\
free (s);\
if (n < 1)
	 n = 1;\
parent.graph:xrtData = XrtData(XrtDataCreate (XRT_DATA_ARRAY, n, 0));
                    }
                } array
                widget XmPushButton {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        labelString = New General
                        marginHeight = 3
                        marginWidth = 5
                        fontList = *helvetica-bold-r-*-14-*
                        topAttachment = attach_opposite_widget
                        topWidget = array
                        leftAttachment = attach_widget
                        leftOffset = 10
                        leftWidget = array
                        activateCallback = XrtDataHandle data_handle;\
data_handle = XrtDataHandle(parent.graph:xrtData);\
if (data_handle != NULL) {
	parent.graph:xrtData = NULL;
	XrtDataDestroy (data_handle);\
}\
s = parent.set:value;\
n = atoi (s);\
free (s);\
if (n < 1)
	 n = 1;\
parent.graph:xrtData = XrtData(XrtDataCreate (XRT_DATA_GENERAL, n, 0));
                    }
                } general
                widget XmPushButton {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        labelString = Draw
                        marginHeight = 3
                        marginWidth = 5
                        fontList = *helvetica-bold-r-*-14-*
                        topAttachment = attach_opposite_widget
                        topWidget = array
                        leftAttachment = attach_none
                        rightAttachment = attach_form
                        rightOffset = 10
                        activateCallback = XrtResetDefaultPS() ; XrtFmDrawPS (parent.graph,"xrtoutput.ps",True);
                    }
                } draw
                widget XmPushButton {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        labelString = Save
                        marginHeight = 3
                        marginWidth = 5
                        fontList = *helvetica-bold-r-*-14-*
                        topAttachment = attach_opposite_widget
                        topWidget = array
                        leftAttachment = attach_none
                        rightAttachment = attach_widget
                        rightOffset = 10
                        rightWidget = draw
                        activateCallback = XrtDataHandleOutputData (XrtDataHandle(parent.graph:xrtData),"outputdata",True);
                    }
                } save
                widget XmSeparator {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        topAttachment = attach_none
                        leftAttachment = attach_form
                        rightAttachment = attach_form
                        bottomAttachment = attach_widget
                        bottomOffset = 10
                        bottomWidget = array
                    }
                } sep
                widget XmPushButton {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        labelString = Add
                        marginHeight = 1
                        marginWidth = 3
                        fontList = *helvetica-bold-r-*-12-*
                        topAttachment = attach_none
                        leftAttachment = attach_none
                        rightAttachment = attach_form
                        rightOffset = 10
                        bottomAttachment = attach_widget
                        bottomOffset = 13
                        bottomWidget = sep
                        activateCallback = s = parent.x:value;\
x = ConvertString (parent.graph,s,"Float");\
free (s);\
XrtDataHandle data_handle;\
data_handle = XrtDataHandle(parent.graph:xrtData);\
if (XrtDataGetType (data_handle) == XRT_DATA_ARRAY) {
	s = parent.y:value;\
	y = ConvertString (parent.graph,s,"Float");\
	free (s);\
	Float the_y [Int];\
	the_y = new_array();\
	Int i;\
	for (i = 0 ; i < XrtDataGetNSets(data_handle) ; i = i + 1 )
		the_y [i] = y;\
	if (!XrtArrDataAppendPts (data_handle,Float(x),FloatTable(data(the_y))))
		printf ("failed\n");\
	destroy(the_y);\
} else {
	s = parent.set:value;\
	n = atoi(s);\
	free (s);\
	s = parent.y:value;\
	y = ConvertString (parent.graph,s,"Float");\
	free (s);\
	if (!XrtGenDataAppendPt (data_handle,n,Float(x),Float(y)))
		printf ("failed\n");\
}\
parent.graph:xrtData = XrtData(data_handle);\
parent.x:value = "";\
parent.y:value = "";
                    }
                } add
                widget XmLabel {
                    flag {
                        mapped
                        autosize
