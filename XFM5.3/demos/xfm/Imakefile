bootxfm::
	cd config; $(MAKE) -f Makefile.ini clean; $(MAKE) -f Makefile.ini BOOTSTRAPCFLAGS="$(BOOTSTRAPCFLAGS)"
	-$(MV) Makefile Makefile.bak
	config/imake $(IMAKE_DEFINES) -Iconfig/
	$(MAKE) Makefile
	$(MAKE) Makefiles

