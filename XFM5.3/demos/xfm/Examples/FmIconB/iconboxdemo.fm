                                    children {
                                        widget XmLabel {
                                            flag {
                                                mapped
                                                autosize
                                            }
                                            resources {
                                                x = 0
                                                y = 0
                                                alignment = alignment_beginning
                                                labelString = This is a demo of two unique OpenMotif Widgets: the Icon Button and Icon Box.\
\
Labels, Push Buttons, and Toggle Buttons are limited because these\
widgets only allow EITHER labels OR pixmaps on the face but NOT BOTH.\
Icon Buttons relieve the developer of this restriction, allowing both, or either,\
pixmaps and labels on its face.\
\
Row Column and Form from Motif make it difficult to produce "matrix", or \
"cell oriented" layouts (in which the height and width are the same).\
The Icon Box places a constraint on all of its children, making each child\
the same width and height. Moreover, the Icon Box lets the developer\
specify which cell in the Icon Box each child should go.
                                            }
                                        } infolabel
                                    }
                                } scrollExplain
                            }
