                                        iconPlacement = icontop
                                        pixmap = ../pixmaps/crab.xpm
                                        activateCallback = function None showthisbutton(String className,String strplace,Widget w){\
\
String msg;\
msg = String (XtMalloc(255));\
\
sprintf(msg,"This is an %s inside an Icon Box.\
\
It was created using the following resource settings:\
\
iconPlacement	= %s\
cellX		= %d\
cellY		= %d", className, strplace, w:cellX, w:cellY);\
\
parent.parent.parent.parent.xmDialogShell0.showcode:messageString = msg;\
\
show(parent.parent.parent.parent.xmDialogShell0.showcode);\
\
XtFree(msg);\
};\
\
function String getIconPlacement(Widget w){\
XmIconPlacement place;\
String strplace; \
\
place = w:iconPlacement;\
\
if(place==XmIconTop) strplace="XmIconTop";\
else if(place==XmIconLeft) strplace="XmIconLeft";\
else if(place==XmIconRight) strplace="XmIconRight";\
else if(place==XmIconBottom) strplace="XmIconBottom";\
else if(place==XmIconOnly) strplace="XmIconOnly";\
else if(place==XmIconNone) strplace="XmIconNone";\
\
return (strplace);\
};\
\
String strplace;\
String className;\
\
strplace=getIconPlacement(self);\
className="XmIconButton";\
\
showthisbutton(className,strplace,self);
                                    }
                                } XmIconTop
