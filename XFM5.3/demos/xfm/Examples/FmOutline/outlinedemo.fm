                        labelString = The OpenMotif Outline Widget displays hierarchical data in an outline layout with a Motif\
look and feel. The Outline widget displayed below has several Motif PushButtons (the\
Outline can accept any type of widget); press one to add a new child.\
\
The Outline Widget uses "constraints" to arrange the children with the right layout.\
To see the code to generate the tree below, press "Show Layout Code...".\
\
The toggles below set different resources on the Outline widget itself.\
\
Press "Other Resources..." for more information on the various resources.
                        marginHeight = 10
