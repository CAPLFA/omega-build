                                autopos
                                menu_pulldown
                            }
                            resources {
                            }
                            children {
                                widget XmPushButton {
                                    flag {
                                        mapped
                                        autosize
                                        autopos
                                        gadget
                                    }
                                    resources {
                                        labelString = On This Demo...
                                        activateCallback = function String LoadFile(String);\
String help_text = LoadFile("README");\
if(!help_text){
	root*alert_box:Error("Cannot load help file");
	return();\
}\
root*help_box:Help("This Demo", help_text);\
XtFree(help_text);
                                    }
                                } ondemo
                            }
                        } helpPulldown
                        widget XmCascadeButton {
                            flag {
                                mapped
                                autosize
                                autopos
                                gadget
                            }
                            resources {
                                labelString = Help
