                    children {
                        widget XmText {
                            flag {
                                mapped
                            }
                            activevalue {
                                name = text
                                get = @ = self:value;
                                set = self:value = @;\
self:@textModified = 0;
                                type = String
                                storage = object
                                automatic = TRUE
                            }
                            activevalue {
                                name = textModified
                                type = Int
                                storage = object
                                automatic = TRUE
                            }
                            resources {
                                x = 0
                                y = 0
                                width = 414
                                height = 242
                                scrollVertical = true
                                editMode = multi_line_edit
                                valueChangedCallback = self:@textModified = True;
                            }
                        } text
                    }
                } text_scroll
            }
        } mainwin
    }
} test
