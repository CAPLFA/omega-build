widget ApplicationShell {
    flag {
        mapped
    }
    activevalue {
        name = CurrentFile
        get = if(!@ || equal(@, "")){
	@ = "unnamed";\
}
        set = if(!@ || equal(@, "")){
	self:title = "Edit: unnamed";
	return();\
}\
String buf = XtMalloc(512);\
sprintf(buf, "Edit: %s", @);\
self:title = buf;
        type = String
        automatic = TRUE
    }
    resources {
        x = 559
        y = 79
        width = 433
        height = 292
        title = Edit
    }
    children {
        widget XmMainWindow {
            flag {
                mapped
            }
            resources {
                x = 0
                y = 0
                width = 433
                height = 292
            }
            children {
                widget XmRowColumn {
                    flag {
                        mapped
                        menu_bar
                    }
                    createproc {
                        /* DO NOT EDIT THIS LINE */ self:menuHelpWidget = self.help;
                    }
                    resources {
                        x = 0
                        y = 0
                        width = 433
                        height = 31
                    }
                    children {
                        widget XmRowColumn {
                            flag {
                                mapped
                                autosize
                                autopos
                                menu_pulldown
                            }
                            resources {
                            }
                            children {
                                widget XmPushButton {
                                    flag {
                                        mapped
                                        autosize
                                        autopos
                                        gadget
                                    }
                                    resources {
                                        labelString = Open...
                                        activateCallback = function String LoadFile(String filename);\
\
String filename = root*fsbox:GetFileName(root:@CurrentFile, "*");\
if(!filename)
	return();\
String text = LoadFile(filename);\
if(!text){
	root*alert_box:Error("Cannot load file");
	XtFree(text);\
} else {
	root*text:@text = text;
	XtFree(text);
	root:@CurrentFile = filename;\
}
                                    }
                                } open
                                widget XmPushButton {
                                    flag {
                                        mapped
                                        autosize
                                        autopos
                                        gadget
                                    }
                                    resources {
                                        labelString = Save
                                        activateCallback = function Int SaveFile(String filename, String text);\
\
String filename = root:@CurrentFile;\
\
if(!filename)
	return();\
\
String text = root*text:@text;\
Int status = SaveFile(filename, text);\
XtFree(text);\
if(status == 0){
	root*alert_box:Error("Cannot save file");\
}
                                    }
                                } save
                                widget XmPushButton {
                                    flag {
                                        mapped
                                        autosize
                                        autopos
                                        gadget
                                    }
                                    resources {
                                        labelString = Save As...
                                        activateCallback = function Int SaveFile(String filename, String text);\
\
String filename = root*fsbox:GetFileName(root:@CurrentFile, "*");\
if(!filename)
	return();\
\
String text = root*text:@text;\
Int status = SaveFile(filename, text);\
XtFree(text);\
if(status == 0){
	root*alert_box:Error("Cannot save file");\
} else {
	root:@CurrentFile = filename;\
}
                                    }
                                } saveas
                                widget XmSeparator {
                                    flag {
                                        mapped
                                        autosize
                                        autopos
                                        gadget
                                    }
                                    resources {
                                    }
                                } sep
                                widget XmPushButton {
                                    flag {
                                        mapped
                                        autosize
                                        autopos
                                        gadget
                                    }
                                    resources {
                                        labelString = Quit
                                        activateCallback = if(root*text:@textModified){
	sure = root*alert_box:Question("Text has been modified\
Quit anyway ?");
	if(!sure)
		return();\
}\
Exit(0);
                                    }
                                } quit
                            }
                        } filePulldown
                        widget XmCascadeButton {
                            flag {
                                mapped
                                autosize
                                autopos
                                gadget
                            }
                            resources {
                                labelString = File
                                subMenuId = parent.filePulldown
                            }
                        } file
                        widget XmRowColumn {
                            flag {
