widget SessionShell {
    flag {
        mapped
    }
    createproc {
        XmTabSide a;\
a = self*xmTabStack0:tabSide;\
if(a == XmTABS_ON_TOP)\
self*top:set = set;\
else if(a == XmTABS_ON_BOTTOM)\
self*bottom:set = set;\
else if(a == XmTABS_ON_LEFT)\
self*left:set = set;\
else if(a == XmTABS_ON_RIGHT)\
self*right:set = set;\
\
TabStyle b;\
b = self*xmTabStack0:tabStyle;\
if( b == XmTABS_BEVELED)\
self*beveled:set = set;\
else if( b == XmTABS_ROUNDED)\
self*rounded:set = set;\
else if( b == XmTABS_SQUARED)\
self*squared:set = set;\
\
TabOrientation c;\
c = self*xmTabStack0:tabOrientation;\
if(c == XmTAB_ORIENTATION_DYNAMIC)\
self*orientationdynamic:set=set;\
else if(c == XmTABS_RIGHT_TO_LEFT)\
self*right2left:set=set;\
else if(c == XmTABS_LEFT_TO_RIGHT)\
self*left2right:set=set;\
else if(c == XmTABS_TOP_TO_BOTTOM)\
self*top2bottom:set=set;\
else if(c == XmTABS_BOTTOM_TO_TOP)\
self*bottom2top:set=set;\
\
TabMode d;\
d = self*xmTabStack0:tabMode;\
if(d == XmTABS_BASIC)\
self*basic:set = set;\
else if(d == XmTABS_STACKED)\
self*stacked:set = set;\
else if(d == XmTABS_STACKED_STATIC)\
self*stacked_static:set = set;
    }
