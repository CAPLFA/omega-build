                                width = 138
                                height = 31
                                entryLabelType = pixmap
                                entryLabelPixmap = phone.bm
                                validateCallback = XmDataFieldCallbackStruct cbs=@;\
validate_data(self,cbs);
                                pictureErrorCallback = picture_error(self);
                            }
                        } phone
                    }
                } column
                widget XmPushButton {
                    flag {
                        mapped
                    }
                    resources {
                        x = 3
                        y = 260
                        width = 288
                        height = 38
                        activateCallback = exit(0);
                    }
                } quit
