	function None StopBall();
	Int first;
	if (first == 0) {
	first = 1;
	FmSetActiveValue(parent.si,"interval");
	FmSetActiveValue(parent.sdx,"dx");
	FmSetActiveValue(parent.sdy,"dy");
	}
	Boolean started;
	if(started){
		StopBall();
		self:labelString = 'start';
		started = false;
	} else {
		GetActiveValue(parent.ws,String(0));
		MoveBall(parent.ws);
		self:labelString = 'stop';
		started = true;
	}
