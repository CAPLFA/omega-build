                widget XmNotebook {
                    flag {
                        mapped
                    }
                    activevalue {
                        name = ModifPage
                        set = self:@currentPage = @;\
XmString xmstrtmp;\
String buf;\
Int cur = self:@currentPage;\
Page page_current = getPageCurrent(self);\
Int cur1 = cur + 1;\
if(cur <= self:@maxpages)\
 self.scrolltext:pageNumber = cur1;\
\
if(page_current)\
{\
 if(page_current->page)
	self.scrolltext.text:value = page_current->page;\
  else\
        self.scrolltext.text:value = "";\
  if(page_current->label)
	buf = page_current->label;\
   else\
   {
	buf = XtMalloc(80);
	sprintf(buf, "Page %d (Bad Page)", cur1);\
   }\
}\
else\
{\
  self.scrolltext.text:value = "";\
  sprintf(buf, "Page %d (Bad Page)", cur1);\
}\
 xmstrtmp = XmStringCreateLocalized(buf);\
self.scrolltext.text:topCharacter = page_current->lasttoppos;\
self.scrolltext.text:cursorPosition = page_current->lastcursorpos;\
self.label:pageNumber = self:@currentPage + 1;\
self.label:labelString = xmstrtmp;\
XmStringFree(xmstrtmp);
                        type = Int
                        usage = face
                    }
