            createproc {
                function None valuechanged( XmSpinBoxCallback calldata){\
\
 if(calldata->widget ==  root*Day)\
  root*BBoard:@dy = calldata->position + 1;\
  else if (calldata->widget == root*MonthSB)\
  root*BBoard:@mn = calldata->position;\
  else if (calldata->widget == root*YearSB)\
  root*BBoard:@yr = calldata->position + 1992;\
  else if (calldata->widget == root*Hour)\
  root*BBoard:@hr = calldata->position;\
  else if (calldata->widget == root*Minute)\
  root*BBoard:@mi = calldata->position;\
\
};\
\
function tm fctTime(Widget w);\
function XmStringTable getMonths();\
function Int getMonth();\
XmStringTable strtable;\
\
fctTime(self);\
\
root*Day:position = PositionValue(self:@dy);\
root*Day:minimumValue = 1;\
root*Day:maximumValue = 31;\
\
strTable = getMonths();\
\
root*MonthSB:values = strTable;\
root*MonthSB:position = PositionValue(self:@mn);\
\
root*YearSB:position = PositionValue( self:@yr);\
\
root*Hour:position = PositionValue(self:@hr);\
\
root*Minute:position = PositionValue(self:@mi);
