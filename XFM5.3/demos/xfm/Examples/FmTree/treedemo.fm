                                height = 548
                                background = floralwhite
                                nodeStateCallback = if(parent.xmFrame0.xmPanedWindow0.xmForm0.xmColumn2.NodeStateToggle:set==XmSET){\
XmHierarchyNodeStateData data= $;\
String str;\
String buf;\
buf = XtMalloc(100);\
Widget w;\
w = data->widget;\
str = GetString(w:labelString);\
\
if(data->state == XmOpen)\
        sprintf(buf, "%s has switched to the XmOpen state.", str);\
else if (data->state == XmClosed)\
        sprintf(buf, "%s has switched to the XmClosed state.", str);\
else if (data->state == XmAlwaysOpen)\
        sprintf(buf, "%s has switched to the XmAlwaysOpen state.", str);\
else if (data->state == XmHidden)\
        sprintf(buf, "%s has switched to the XmHidden state.", str);\
else\
        sprintf(buf, "%s has switched node state.", str);\
\
self.xmDialogShell0.nodechange:messageString = buf;\
show(self.xmDialogShell0.nodechange);\
}
                                allowResize = true
                                skipAdjust = true
