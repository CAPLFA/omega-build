                                            createproc {
                                                global Widget widget_current;\
global Widget widget_label;\
global Widget group;\
group = self;\
widget_label = self.Node_Widget;\
\
function None get_widget_current(){\
widget_current = self;\
widget_label:labelString = Name(self);\
if(self:parentNode){\
show(group.xmColumn4);\
}else{\
hide(group.xmColumn4);\
}\
\
if(widget_current:lineStyle == LineSolid)\
group.xmColumn4.linestyleOM:menuHistory=group.xmColumn4.popup_linestylePM.linestylePM.solid;\
else if(widget_current:lineStyle == LineOnOffDash)\
group.xmColumn4.linestyleOM:menuHistory=group.xmColumn4.popup_linestylePM.linestylePM.onoffdash;\
else\
group.xmColumn4.linestyleOM:menuHistory=group.xmColumn4.popup_linestylePM.linestylePM.doubledash;\
\
};\
\
function None change_line_style(){\
widget_current:lineStyle = Name(self);\
};
