widget SessionShell {
    flag {
        mapped
    }
    createproc {
        Widget tree_init = self.xmPanedWindow0.xmPanedWindow1.tree_widget;\
\
self*HNSpaceScale:value = tree_init:horizontalNodeSpace;\
self*VNSpaceScale:value = tree_init:verticalNodeSpace;\
self*VDeltaScale:value = tree_init:verticalDelta;\
self*HDeltaScale:value = tree_init:horizontalDelta;\
\
if(tree_init:compressStyle == XmTreeCompressNone)\
self*compressStyleOM:menuHistory = self*none;\
elsef if(tree_init:compressStyle == XmTreeCompressLeaves)\
self*compressStyleOM:menuHistory = self*leaves;\
else\
self*compressStyleOM:menuHistory = self*all;\
\
if(tree_init:connectStyle == XmTreeDirect)\
self*connectStyleOM:menuHistory = self*direct;\
else\
self*connectStyleOM:menuHistory = self*ladder;\
\
if(tree_init:orientation == XmHORIZONTAL)\
self*orientationOM:menuHistory = self*horizontal;\
else\
self*orientationOM:menuHistory = self*vertical;
    }
