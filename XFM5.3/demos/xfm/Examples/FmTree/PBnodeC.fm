widget XmPushButton {
    flag {
        autosize
    }
    activevalue {
        name = background_av
        get = @=self:background;
        set = self:background=@;
        type = Pixel
        storage = object
        automatic = TRUE
        usage = class
        default_type = String
        default_value = moccasin
    }
    createproc {
        if(self:parentNode){\
 Widget w;\
 w = self:parentNode;\
 if(w:nodeState == XmAlwaysOpen){\
  w:nodeState = XmOpen;\
}\
}
    }
    resources {
        x = 0
        y = 0
        activateCallback = extern function None get_widget_current();\
get_widget_current();
        translations = #override
	<Btn3Down>:	eval("popup=NameToWidget(self, '*popupMenu0');if(popup){MenuPosition(popup, $);ManageChild(popup);}")
        background = moccasin
    }
    children {
        widget XmRowColumn {
            flag {
                mapped
                menu_popup
            }
            resources {
                x = 0
                y = 0
                width = 30
                height = 25
            }
            children {
                widget XmPushButton {
                    flag {
                        mapped
                    }
                    resources {
                        x = 2
                        y = 2
                        width = 26
                        height = 21
                        activateCallback = function None create_pb(Widget w);\
create_pb(parent.parent);
                    }
                } New
            }
        } popupMenu0
    }
} Widgets
