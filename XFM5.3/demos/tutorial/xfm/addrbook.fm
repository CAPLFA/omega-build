Boolean done = False;\
global Boolean SavingAddressBook;\
if (SavingAddressBook) {
	function Boolean OpenAddressBook(String file) = True;
	if (OpenAddressBook(name)) {
		Int n = parent.parent.xmMainWindow0.form.xmScrolledWindow0.xmList0:itemCount;
		for (i = 0; i<n; i = i+1) {
			include "addrbook.inc";
			Address a = Book[i];
			function None WriteAddress(String name, String street, String city, String state, String zip);
			WriteAddress(a->name, a->street, a-> city, a->state, a->zip);
		}
		function None CloseAddressBook();
		CloseAddressBook();
		done = True;
	} else {
		printf("Cannot open file for saving.\n");
	}\
} else {
	function Boolean ReadAddressBook (String file) = True;
	if (ReadAddressBook(name)) {
		done = True;
	} else {
		printf("Cannot open file for reading.\n");
	}\
}\
XtFree(name);\
if (done) FmHideWidget(self);
                        cancelCallback = FmHideWidget(self);
