# 
# Makefile generated by +PNAME+ from +SNAME+
#
               CC = cc
      CDEBUGFLAGS = -g -D_NO_PROTO
        CCOPTIONS = -I.
           CFLAGS = $(CDEBUGFLAGS) $(CCOPTIONS)
           FMLAGS = -instclose 
        LDOPTIONS =

         FMLIBDIR = /usr/lib/X11/xfm
            FMLIB = -L$(FMLIBDIR) -lFm
           CFMLIB = -L$(FMLIBDIR) -lFm_c -lXnsl
           EFMLIB = -L$(FMLIBDIR) -lFm_e

              XFM = /usr/bin/X11/xfm
         MTKLIBDIR = /usr/lib
         XTKLIBDIR = /usr/lib
TOOLKIT_LIBRARIES = -L$(MTKLIBDIR) -lXm
      X_LIBRARIES = -L$(XTKLIBDIR) -lXt -lX11
    SYS_LIBRARIES = -lm
           LDLIBS = $(TOOLKIT_LIBRARIES) $(X_LIBRARIES) $(SYS_LIBRARIES)

               RM = rm
               MV = mv
               LN = ln -s

             OBJS = +UNAME+_usr.o

all: +LNAME+ c+LNAME+


+UNAME+_usr.o: +UNAME+_usr.c +UNAME+.h
	$(CC) -c $(CFLAGS) +UNAME+_usr.c

+UNAME+_fm.c: +UNAME+.fm
	$(XFM) $(FMLAGS) -compile +UNAME+.fm -cfile +UNAME+_fm.c

c+UNAME+.o: +UNAME+.c +UNAME+.h
	$(CC) -c $(CFLAGS) -DCCODE +UNAME+.c
	$(MV) +UNAME+.o $@

+LNAME+: +UNAME+.o +UNAME+.h $(OBJS)
	$(CC) -o $@ +UNAME+.o $(OBJS) $(LDOPTIONS) $(FMLIB) $(LDLIBS)

c+LNAME+: c+UNAME+.o +UNAME+_fm.o $(OBJS)
	$(CC) -o $@ c+UNAME+.o +UNAME+_fm.o $(OBJS) $(LDOPTIONS) $(CFMLIB) $(LDLIBS)

clean:
	$(RM)  +LNAME+ c+LNAME+ +UNAME+_fm.c *.o

+UNAME+.o: +UNAME+.h
c+UNAME+.o: +UNAME+.h
