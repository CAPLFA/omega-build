                                        valueChangedCallback = function void _FmAvSetTypeToggle (Int type,XmString list,XmString name,XmString button) {
	global Int _FmCurrentAvType;
	global XmString cxxPerWidgetLabelBackup;
	global XmString cxxPerCallLabelBackup;
	global Boolean _FmAvReconfig;
	if (!Boolean(self:set) || _FmCurrentAvType == type)
		return();
	f = parent.parent.parent;
	t = parent.parent;
	face = (type == _FM_AV_FACE);
	drag = (type == _FM_AV_DRAG);
	drop = (type == _FM_AV_DROP);
	class = (type == _FM_AV_CLASS);
	cxx = (type == _FM_AV_CXX);
					
	reconfig = (face || class || cxx) &&
		    ((!face && !drop) || (_FmCurrentAvType != _FM_AV_FACE &&
					  _FmCurrentAvType != _FM_AV_DROP));
	p = f.scriptpanes;
	msg = root.main.panes.messageForm.scroller.text;
	_FmAvReconfig = False;
	if (drag)
		XtManageChild (t.iconForm);
	if (class) {
		XtManageChild (t.classIcon);
		XtManageChild (t.classForm);
		XtManageChild (f.edit);
		XtManageChild (f.save);
	} else {
		XtUnmanageChild (t.classForm);
		XtUnmanageChild (t.classIcon);
		XtUnmanageChild (f.edit);
		XtUnmanageChild (f.save);
	}
	if (!drag)
		XtUnmanageChild (t.iconForm);
	i = f.infoForm;
	af = i.accessForm;
	sf = i.storageForm;
	if (drag || drop || class) {	
		XtUnmanageChild (af);
		XtUnmanageChild (sf);
	} else {
		rc = sf.storageRC;
		if (cxx) {		
			if (Boolean(rc.global:set)){
				XmToggleButtonGadgetSetState (rc.perwidget,True,False);
				XmToggleButtonGadgetSetState (rc.global,False,False);
				XmToggleButtonGadgetSetState (rc.percall,False,False);
			}
			XtUnmanageChild (rc.global);
		} else
			XtManageChild (rc.global);
		if (cxx) {		
			XmToggleButtonGadgetSetState (sf.auto,True,False);
			XmToggleButtonGadgetSetState (af.immed,false, False);
			XtSetSensitive (sf.genfun,Boolean(rc.perwidget:set));
			XtManageChild (sf.genfun);
			XtUnmanageChild (sf.auto);
			sl = i.storageForm.memKindLabel;
			hl = i.storageForm.storageLabel;
			local XmString dataLabel;
			local XmString functionLabel;
			if (dataLabel == NULL) {
				dataLabel = FmCreateXmString("data");
				functionLabel = FmCreateXmString("function");
			}
			rc.perwidget:labelString = dataLabel;
			rc.percall:labelString = functionLabel;
			XtUnmanageChild (af.immed);
			XtManageChild (af.accessRC);
		} else {
			XtManageChild (sf.auto);
			XtUnmanageChild (sf.genfun);
			sl = i.storageForm.storageLabel;
			hl = i.storageForm.memKindLabel;
			rc.perwidget:labelString = cxxPerWidgetLabelBackup;
			rc.percall:labelString = cxxPerCallLabelBackup;
			XtManageChild (af.immed);
			XtUnmanageChild (af.accessRC);
		}
		XtManageChild (sl);
		rc:leftWidget = sl;
		rc:topWidget = sl;
		XtUnmanageChild (hl);
		XtManageChild (sf);
		XtManageChild (af);
	}
	if (face || class || cxx) {	
		XtManageChild (i.typeLabel);
		XtManageChild (i.typeDots);
		XtManageChild (i.type);
		XtManageChild (i.valueLabel);
		XtManageChild (i.valueDots);
		XtManageChild (i.value);
		FmManageChildren (p.getform,p.setform,NULL);
		FmAttachTopWidget (i.storageForm,i.valueLabel,10);
		_FmAvReconfig = True;
	} else {
		FmAttachTopWidget (i.storageForm,NULL,5);
		XtUnmanageChild (i.value);
		XtUnmanageChild (i.valueDots);
		XtUnmanageChild (i.valueLabel);
		XtUnmanageChild (i.type);
		XtUnmanageChild (i.typeDots);
		XtUnmanageChild (i.typeLabel);
		
		FmManageChildren (p.getform,p.setform,NULL);
	}
	n = f.nameForm;
	if (button) {			
		n.select:labelString = button;
		XtManageChild (n.select);
	} else
		XtUnmanageChild (n.select);
	f.listLabel:labelString = list;
	n.nameLabel:labelString = name;
	if (reconfig)
		_FmAvConfig (f.scriptpanes);
	
	_FmCurrentAvType = type;\
	_FmSetupAv(0);\
	FmCallResizeProc(f);\
}\
