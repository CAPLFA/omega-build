	h = RGBToHSV(red, green, blue, "h");
	s = RGBToHSV(red, green, blue, "s");
	v = RGBToHSV(red, green, blue, "v");
	if(h < 0) h = 0;
	parent.hue_scale:value = h;
	parent.saturation_scale:value = s;
	parent.value_scale:value = v;
	
	hexa = "#0000000000";
	sprintf(hexa, "#%02x%02x%02x", red, green, blue);
	parent.name:value = hexa;
	
	pixel = StoreColor(parent:colormap, red, green, blue);
	if(pixel > 0){
		parent.example:background = pixel;
	}
