widget XmDialogShell {
    flag {
        popup
        autosize
        autopos
    }
    resources {
        title = %MSG%150%440 XFaceMaker: C Code Options
        popupCallback = self:minWidth = self:width;\
self:minHeight = self:height;\
self:maxHeight = self:height;
    }
    children {
        widget XmForm {
            flag {
                autosize
                autopos
            }
            createproc {
                h = self.commandLabel:height;\
n = self.command:height;\
if (h > n)
	self.command:marginHeight = (h - n) / 2;\
else
	self.commandLabel:marginHeight = (n - h) / 2;\
h = self.commandLabel:height;\
n = self.command:height;\
if (h > n)
	command:marginHeight = (h - n) / 2;\
else
	commandLabel:marginHeight = (n - h) / 2;\
FmSetWidest (self.typeLabel,self.nameForm.nameLabel,self.prefixForm.prefixLabel,self.includeLabel,self.codeLabel,self.storeLabel,self.supportLabel,NULL);
            }
            resources {
                autoUnmanage = false
                mapCallback = _FmSetSysAv ("_FmSaveCCode");\
_FmSetSysAv ("_FmCName");\
_FmSetSysAv ("_FmCInclude");\
_FmSetSysAv ("_FmClassPrefix");\
_FmSetSysAv ("_FmCOptions");\
_FmSetSysAv ("_FmStandC");\
_FmSetSysAv ("_FmInstallCloseInC");\
_FmSetSysAv ("_FmAnsiC");\
_FmSetSysAv("_FmCommandLine");
            }
            children {
                widget XmToggleButton {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    activevalue {
                        name = _FmSaveCCode
                        set = self:set = Set(@);
                    }
                    activevalue {
                        name = _FmStartupFile
                        set = if (Boolean(self:set))
	s = "True";\
else
	s = "False";\
fprintf (@,"_FmCmdSetCcodeMode(%s);\n",s);
                    }
                    createproc {
                        function String _FmSetCOptionString (String name,String value) {
	if (value != String(0)) {
		ok = True;
		if (name != 0) {
			w = XtNameToWidget (toplevel.form.typeRC,name);
			if (w != 0)
				ok = Boolean(w:set);
		}
		if (!ok || strcmp (value,"") == 0) {
			free (value);
			value = String (0);
		}
	}
	return (String(value));\
}
                    }
                    resources {
                        labelString = %MSG%150%441 Save C code
                        marginHeight = 0
                        marginWidth = 0
                        spacing = 2
                        topAttachment = attach_form
                        topOffset = 10
                        leftAttachment = attach_form
                        leftOffset = 7
                    }
                } save
                widget XmLabel {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        labelString = %MSG%150%442 Save As:
                        alignment = alignment_beginning
                        topAttachment = attach_widget
                        topOffset = 5
                        topWidget = save
                        leftAttachment = attach_form
                        leftOffset = 8
                    }
                } typeLabel
                widget XmRowColumn {
                    flag {
                        mapped
                        autosize
                        autopos
                    }
                    resources {
                        marginHeight = 0
                        marginWidth = 0
                        orientation = horizontal
                        packing = pack_tight
                        radioBehavior = true
                        topAttachment = attach_opposite_widget
                        topOffset = -2
                        topWidget = typeLabel
                        leftAttachment = attach_widget
                        leftOffset = 5
                        leftWidget = typeLabel
                    }
                    children {
                        widget XmToggleButton {
                            flag {
                                mapped
                                autosize
                                autopos
                                gadget
                            }
                            activevalue {
                                name = _FmCOptions
                                set = XmToggleButtonGadgetSetState (self,!_FmBitGet(@,_FM_GEN_WIDGET_CLASS),True);
                            }
                            resources {
                                labelString = %MSG%150%443 widget
                                marginHeight = 0
                                marginWidth = 0
                                spacing = 2
                                set = true
                                valueChangedCallback = function void _FmCOptIsFunc (Boolean isfunc) {
	f = parent.parent;
	if (isfunc) {
		showme = f.nameForm;
		hideme = f.prefixForm;
	} else {
		showme = f.prefixForm;
		hideme = f.nameForm;
	}
	show (showme);
	f.includeLabel:topWidget = showme;
	hide (hideme);
	XtSetSensitive (f.initForm,isfunc);\
}\
if (Boolean(self:set))
	_FmCOptIsFunc (true);
                            }
                        } create
                        widget XmToggleButton {
                            flag {
                                mapped
                                autosize
                                autopos
                                gadget
                            }
                            activevalue {
                                name = _FmCOptions
                                get = @ = _FmBitSet(@,_FM_GEN_WIDGET_CLASS,Boolean(self:set));
                                set = XmToggleButtonGadgetSetState (self,_FmBitGet(@,_FM_GEN_WIDGET_CLASS),True);
                            }
                            resources {
                                labelString = %MSG%150%444 class
                                marginHeight = 0
                                marginWidth = 0
                                spacing = 2
                                valueChangedCallback = if (Boolean(self:set))
	_FmCOptIsFunc (false);
                            }
                        } class
                    }
