                                get = s = _FmSetCOptionString ("create",self:value);\
_FmSysAvSetString ("_FmCName",s);\
if (s != String (0))
	free (s);
                                set = if (@)
	self:value = @;\
else
	self:value = "";
                            }
                            resources {
