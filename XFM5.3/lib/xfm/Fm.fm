                                            createproc {
                                                function void _FmToolkitConfigure (Widget tk) {
	mw = tk:width - 6;
	mh = tk:height - 6;
	rc = tk.rc;
	n = rc:numColumns;
	while (n > 1 && mh < rc:height) {
		n = n - 1;
		XtUnmanageChild (tk);
		rc:numColumns = Short(n);
		XtManageChild (tk);
	}
	h = rc:height / rc:numColumns + rc:spacing;
	w = rc:width;
	while (rc:width > mw && rc:height + h < mh) {
		n = n + 1;
		XtUnmanageChild (tk);
		tk.rc:numColumns = Short(n);
		XtManageChild (tk);
	}
	SetSensitive (tk.parent.parent.left,rc:x < 3);
	SetSensitive (tk.parent.parent.right,rc:x + rc:width >= mw + 3);\
}
                                            }
                                            resources {
                                                marginHeight = 0
                                                marginWidth = 0
                                                translations = #override \
<ConfigureNotify> : eval("_FmToolkitConfigure (self);\n")
                                            }
