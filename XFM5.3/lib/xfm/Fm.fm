                                        set = function Int _FmGetToolkitIncrement () {
	rc = parent.widgetFrame.bb.rc;
	if (rc:userData == 0) {
		incr = _FmToolkitIncrement();
		rc:userData = Pointer (incr);
	} else
		incr = Int (rc:userData);
	return (incr);\
}\
function void _FmAdjustToolkitBox (Int incr) {
	bb = parent.widgetFrame.bb;
	rc = bb.rc;
	n = rc:x + incr;
	if (n > 3)
		n = 3;
	UnmanageChild (rc);
	rc:x = n;
	ManageChild (rc);
	SetSensitive (parent.left,n < 3);
	SetSensitive (parent.right,n + rc:width >= bb:width);
	if (self:sensitive) {
		if (self:userData == 0)
			delay = 500;
		else
			delay = 200;
		self:userData = Pointer (FmSetActiveValueTimeOut (self,"_FmToolkitArrow",delay));
	}\
}\
_FmAdjustToolkitBox (_FmGetToolkitIncrement());
