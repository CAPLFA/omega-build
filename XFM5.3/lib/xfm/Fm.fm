widget XmDialogShell {
    flag {
        popup
    }
    resources {
        x = 422
        y = 128
        width = 319
        height = 310
        title = %MSG%150%127 XFaceMaker: Environment
        popupCallback =
		Widget last = self*option:menuHistory;
		if(last){
			XtCallCallbacks(last, "activateCallback", 0);
		}
    }
    children {
        widget XmForm {
            flag {
            }
            createproc {
                function None _FmSelectEnvVar(String varname)
	{
		global String _FmCurEnvVarName;
		_FmCurEnvVarName = varname;
		if(equal(String(varname+strlen(varname)-3), "...")){
			XtManageChild(toplevel*name);
			XmProcessTraversal(toplevel*name, XmTRAVERSE_CURRENT);
		} else {
			XtUnmanageChild(toplevel*name);
		}
		function String _FmGetEnv(String);
		String value = _FmGetEnv(varname);
		if(equal(String(varname+strlen(varname)-4), "PATH")){
			XtSetSensitive(toplevel*list_scroll, True);
			XtSetSensitive(toplevel*add, True);
			XtSetSensitive(toplevel*delete, True);
			function String _FmPathToItems(String);
			String items = _FmPathToItems(value);
			if(!items) items = XtNewString("");
			FmListSetItems(toplevel*list, items);
			XtFree(items);
			XmListDeselectAllItems(toplevel*list);
			global _FmEnvListPos; _FmEnvListPos = 0;
			toplevel*text:value = "";
		} else {
			XtSetSensitive(toplevel*list_scroll, False);
			XtSetSensitive(toplevel*add, False);
			XtSetSensitive(toplevel*delete, False);
			XmListDeselectAllItems(toplevel*list);
			XmListDeleteAllItems(toplevel*list);
			if(value)
				toplevel*text:value = value;
			else
				toplevel*text:value = "";
		}
		XmProcessTraversal(toplevel*text, XmTRAVERSE_CURRENT);
	}
	FmSetWidest (self.ok,self.apply,self.close,self.help,NULL);
	s = self:horizontalSpacing;
	i = (2 * s + self.apply:width) / 3;
	self.apply:leftOffset = s - i;
	self.close:leftOffset = s - 2 * i;
	FmSetWidest (self.add,self.delete,self.select,NULL);
	self.delete:leftOffset = -self.delete:width / 2;
            }
            resources {
                x = 0
                y = 0
                width = 319
                height = 310
                defaultPosition = false
                autoUnmanage = false
                verticalSpacing = 10
                horizontalSpacing = 10
            }
            children {
                widget XmPushButton {
                    flag {
                        mapped
                        autopos
                        autosize
                    }
                    resources {
                        marginWidth = 5
                        leftAttachment = attach_position
                        bottomAttachment = attach_form
                        labelString = %MSG%150%128 Apply
                        leftPosition = 33
                        activateCallback =
	global String _FmCurEnvVarName;
	if(!_FmCurEnvVarName) return();
	String v;
	if(equal(String(_FmCurEnvVarName+strlen(_FmCurEnvVarName)-4), "PATH")){
		Int item_count = toplevel*list:itemCount;
		if(item_count > 0){
			XmStringTable items = toplevel*list:items;
			XmString xmstrings[Int] = new_c_array(Pointer(items), item_count);
			String strings[Int] = new_array();
			for(Int i = 0; i < item_count; i = i+1)
				strings[i] = FmGetString(xmstrings[i]);
			function String _FmItemsToPath(StringTable, Int);
			v = _FmItemsToPath(StringTable(data(strings)), item_count);
			destroy(xmstrings);
			for(Int i = 0; i < item_count; i = i+1)
				XtFree(strings[i]);
			destroy(strings);
		} else {
			v = 0;
		}
	} else {
		v = toplevel*text:value;
	}
	if(v && !equal(v, "")){
		function None _FmPutEnv(String);
		String buf = XtMalloc(strlen(_FmCurEnvVarName)+strlen(v)+2);
		sprintf(buf, "%s=%s", _FmCurEnvVarName, v);
		_FmPutEnv(buf);
		XtFree(buf);
		XtFree(v);
	}
                    }
                } apply
                widget XmPushButton {
                    flag {
                        mapped
                        autopos
                        autosize
                    }
                    resources {
                        marginWidth = 5
                        rightAttachment = attach_form
                        bottomAttachment = attach_form
                        labelString = %MSG%150%129 Help
                        activateCallback =
	s = FmGetHelp( Internationalize("%MSG%150%130 Windows"), Internationalize("%MSG%150%131 Environment") );
	Help( Internationalize("%MSG%150%132 Environment Box"), s);
