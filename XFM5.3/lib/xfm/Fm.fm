n = Int (list:userData);\
if (n > 0) {
	s = FmListGetNthItem (list,n);
	_FmDeleteAv (s);
	free (s);
	XtSetSensitive (parent.replace,False);
	XtSetSensitive (parent.up,False);
	XtSetSensitive (parent.down,False);
