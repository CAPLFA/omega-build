	function None _FmLoadCustomEditAVScript(String which, String s)
	{
		if(!s)
			s = "";
		_FmCELoadString(parent:userData, s);
		String buf = XtMalloc(512);
		String avname = toplevel.form.nameForm.name:value;
		if(equal(avname, "")){
			XtFree(avname);
			avname = XtNewString("<none>");
		}
		sprintf(buf, Internationalize("%MSG%150%434 XFM: %s script of active value %s"),
				which,
				avname);
		XtFree(avname);
		_FmCETitle(parent:userData, buf);
		XtFree(buf);
	}
	s = self:value;
	_FmLoadCustomEditAVScript("Get", s);
	XtFree(s);
	self:editable = False;
