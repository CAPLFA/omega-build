widget XmDialogShell {
    flag {
        popup
        autosize
    }
    activevalue {
        name = _FmAlwaysEnabled
        get = _FmAddAlwaysEnabled(self);
    }
    resources {
        x = 404
        y = 373
        allowShellResize = true
        keyboardFocusPolicy = pointer
    }
    children {
        widget XmMessageBox {
            flag {
                autopos
                autosize
            }
            activevalue {
                name = _FmMessage
                set = self:messageString = String($);
            }
            activevalue {
                name = _FmDialogType
                set = self:dialogType = String($);\
t = self:dialogType;\
local XmString yes;\
local XmString no;\
local XmString stop;\
local XmString ok;\
local XmString cancel;\
if (!yes) {
	yes = CreateXmString (Internationalize("%MSG%150%1 Yes"));
	no = CreateXmString (Internationalize("%MSG%150%2 No"));
	stop = CreateXmString (Internationalize("%MSG%150%3 Stop"));
	ok = self:okLabelString;
	cancel = self:cancelLabelString;\
}\
w = MessageBoxGetChild (self,XmDIALOG_OK_BUTTON);\
if (t == XmDIALOG_QUESTION) {
	toplevel:title = Internationalize("%MSG%150%4 XFaceMaker: Question");
	self:okLabelString = yes;
	self:cancelLabelString = no;
	XtManageChild(w);
	XtManageChild(self:cancelButton);\
} else if (t == XmDIALOG_WORKING) {
	toplevel:title = Internationalize("%MSG%150%5 XFaceMaker: Working");
	self:cancelLabelString = stop;
	XtUnmanageChild(w);
	XtManageChild(self:cancelButton);\
} else {
	if (t == XmDIALOG_WARNING)
		toplevel:title = Internationalize("%MSG%150%6 XFaceMaker: Warning");
	else if (t == XmDIALOG_ERROR)
		toplevel:title = Internationalize("%MSG%150%7 XFaceMaker: Error");
	else
		toplevel:title = Internationalize("%MSG%150%8 XFaceMaker: Message");
	self:okLabelString = ok;
	show(w);
	XtUnmanageChild(self:cancelButton);\
}
            }
            activevalue {
                name = _FmAlertHelp
                set = self:userData = XtNewString($);
            }
            createproc {
                UnmanageChild (MessageBoxGetChild (self,XmDIALOG_HELP_BUTTON));
            }
            resources {
                autoUnmanage = false
                defaultPosition = false
                dialogType = dialog_warning
                dialogStyle = dialog_full_application_modal
                okCallback =  Hide(toplevel);\
Return(self, Internationalize("%MSG%150%9 ok"));
                cancelCallback = Hide(toplevel);\
Return(self, String(0));
                okLabelString = %MSG%150%10 OK
                cancelLabelString = %MSG%150%11 Cancel
                helpLabelString = %MSG%150%12 Help
                unmapCallback = if (self:userData) {
	free (String (self:userData));
	self:userData = 0;\
}
                helpCallback =
	
	
	
	
	
	
	
            }
        } XmMessageBox0
    }
