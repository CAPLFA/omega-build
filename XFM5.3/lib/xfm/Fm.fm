        get = _FmAddAlwaysEnabled(self);
    }
    activevalue {
        name = _FmClearDebugger
        set =
	
	function None _FmClearDebugger()
	{
		
		function None _FmDebugNormalButtons();
		_FmDebugNormalButtons();
		
		toplevel*message_text:value = "";
		toplevel*source_text:value = "";
		toplevel*widget_text:value = "";
		toplevel*script_text:value = "";
	}
	
	function None _FmDebugClean()
	{
		toplevel*source_text:value = "";
		toplevel*widget_text:value = "";
		toplevel*script_text:value = "";
	}
	
	_FmClearDebugger();
	_FmDebugClearStack();
	toplevel*output_text:value = "";
	global Int _FmDebugMsgNum; _FmDebugMsgNum = 1;
	if(Boolean(toplevel*tracingon:set))
		toplevel*message_text:value = Internationalize("%MSG%150%81 Debugging is on");
	else
		toplevel*message_text:value = Internationalize("%MSG%150%82 Debugging is off");
    }
    resources {
        x = 8
        y = 46
        minWidth = 453
        minHeight = 491
        title = %MSG%150%83 XFaceMaker: Debugger
        popdownCallback =
		function None _FmDebugStepping(Boolean);
		function None _FmDebugStep();
		self*tracingon:set = Set(False);
		UpdateWidgetAv(self*tracingon);
		_FmDebugStepping(False);
		_FmDebugStep();
		_FmClearDebugger();
		_FmDebugClearStack();
    }
    children {
