	Show (self.acceleratorForm);
	Show (self.callbackForm);
	_FmMenuFirstCallback();
	FmAttachRightWidget (self.labelForm.string,self.labelForm.mnemonicForm,10);
	FmAttachTopWidget (self.labelForm,NULL,0);
	FmAttachTopWidget (self.acceleratorForm,self.labelForm,3);
	FmAttachTopWidget (self.callbackForm,self.acceleratorForm,3);
	Hide (self.separatorForm);
	Hide (self.toggleForm); \
} else if (@ == XmTOGGLEBUTTON) {
	Show (self.toggleForm);
	Show (self.labelForm);
