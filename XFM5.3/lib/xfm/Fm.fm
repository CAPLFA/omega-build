                                                    activevalue {
                                                        name = _FmSelectedObject
                                                        set = \
if (@ < 0)
	XmListDeselectAllItems (self);\
else {
	
	pos = @ + 1;
	if(!XmListPosSelected(self, pos)){
		XmListSelectPos(self, pos, False);
	}
	
	self:userData = Pointer(pos);
	n = Int(self:topItemPosition);
	if (pos < n)
		self:topItemPosition = Any(pos);
	else {
		n = n + self:visibleItemCount - 1;
		if (pos > n)
			XmListSetBottomPos (self,pos);
	}\
}
