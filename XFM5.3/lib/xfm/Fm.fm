widget TransientShell {
    flag {
        popup
    }
    activevalue {
        name = RGBColorAV
        set =
		red 	= GetRGB("r", $);
		green 	= GetRGB("g", $);
		blue 	= GetRGB("b", $);
		
		form.red_scale:value 	= red;
		form.green_scale:value 	= green;
		form.blue_scale:value 	= blue;
		
		h = RGBToHSV(red, green, blue, "h");
		s = RGBToHSV(red, green, blue, "s");
		v = RGBToHSV(red, green, blue, "v");
		if(h < 0) h = 0;
		
		form.hue_scale:value = h;
		form.saturation_scale:value = s;
		form.value_scale:value = v;
		
		hexa = "#0000000000";
		sprintf(hexa, "#%02x%02x%02x", red, green, blue);
		form.name:value = hexa;
		
		pixel = StoreColor(parent:colormap, red, green, blue);
		if(pixel > 0){
			form.example:background = pixel;
		}
    }
    resources {
        x = 605
        y = 350
        width = 275
        height = 536
        minWidth = 250
        minHeight = 350
        title = %MSG%150%71 RGB
        keyboardFocusPolicy = pointer
    }
    children {
        widget XmForm {
            flag {
                mapped
            }
            resources {
                x = 0
                y = 0
                width = 275
                height = 536
                horizontalSpacing = 10
                verticalSpacing = 5
            }
            children {
                widget XmPushButton {
                    flag {
                        mapped
                        gadget
                    }
                    resources {
                        x = 10
                        y = 341
                        width = 60
                        height = 30
                        recomputeSize = false
                        labelString = %MSG%150%72 OK
                        leftAttachment = attach_form
                        bottomAttachment = attach_form
                        activateCallback =
				script _fmc_ok_rgb:
				value = parent.name:value;
				if(equal(value, "")){
					Alert(False, "dialog_warning",
						Internationalize("%MSG%150%73 You must give a name to your new color.\n"));
				} else {
					FreeColor();
					name = AddColor(
						value,
						parent.red_scale:value,
						parent.green_scale:value,
						parent.blue_scale:value);
					name = NewString(name);
					free(value);
					global _FmRGBModified;
					_FmRGBModified = true;
					Return(self, name);
					Hide(toplevel);
				}
                    }
                } ok
                widget XmSeparator {
                    flag {
