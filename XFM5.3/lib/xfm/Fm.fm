        widget XmDialogShell {
            flag {
                popup
                autosize
                autopos
            }
            resources {
            }
            children {
                widget XmSelectionBox {
                    flag {
                        autosize
                        autopos
                    }
                    activevalue {
                        name = _FmAvModified
                        get = script _FmGetAvModified;
                        set = script _FmSetAvModified;
                    }
                    createproc {
                        w = SelectionBoxGetChild (self,XmDIALOG_HELP_BUTTON);\
XtUnmanageChild (w);\
w = SelectionBoxGetChild (self,XmDIALOG_APPLY_BUTTON);\
XtUnmanageChild (w);\
w = SelectionBoxGetChild (self,XmDIALOG_LIST);\
FmListAllowKeySelection (w,True,String(0),True);
                    }
                    resources {
                        autoUnmanage = false
                        dialogStyle = dialog_full_application_modal
                        cancelCallback = FmHideWidget (self);
                        okCallback = w = SelectionBoxGetChild (self,XmDIALOG_TEXT);\
s = w:value;\
if (strcmp (s,"") != 0) {
	form = parent.parent.form;
	name = String (self:userData);
	if (strcmp (name,"method") == 0) {
		text = form.nameForm.name;
		
		rc = form.infoForm.storageForm.storageRC;
		XtSetSensitive (rc.percall,True);
		XmToggleButtonGadgetSetState (rc.percall,True,True);
		XtSetSensitive (rc.perwidget,False);
	} else if (strcmp (name,"type") == 0) {
		text = form.infoForm.type;
	} else if (strcmp (name,"drag") == 0) {
		text = form.nameForm.name;
	} else if (strcmp (name,"drop") == 0) {
		text = form.nameForm.name;
	} else if (strcmp (name,"class") == 0) {
		text = form.topForm.classForm.class;
	} else
		text = Widget (0);
	if (text != Widget (0)) {
		text:value = s;
		XmTextFieldSetInsertionPosition (text,XmTextFieldGetLastPosition (text));\
	}\
}\
free (s);\
FmHideWidget (self);
                    }
                } box
            }
        } selector
    }
} activevalue
