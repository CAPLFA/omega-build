	String source_string = _FmGetStringDebugInfo(_FmGetDebugInfoPtr($), FACE_DEBUG_SOURCE_STR, 0);
	if(source_string){
		String old_source = self:value;
		Boolean really_changed = strcmp(old_source, source_string);
