widget ApplicationShell {
    flag {
        mapped
    }
    activevalue {
        name = _FmToCreate
        set = dummy = 0;
    }
    activevalue {
        name = _FmStartupFile
        set =
		Pointer f = @;
		
		fprintf(f, "if($ != 1){\n");
		
			    w=root*main.panes;
		fprintf(f, "w=root*main.panes;\n");
			    ip=w.interfaceForm;
		fprintf(f, "ip=w.interfaceForm;\n");
			    tp=w.toolkitForm;
		fprintf(f, "tp=w.toolkitForm;\n");
			    mp=w.messageForm;
		fprintf(f, "mp=w.messageForm;\n");
		
		fprintf(f, "XtUnmanageChild(w);\n");
		fprintf(f, "XtUnmanageChild(ip);\n");
		fprintf(f, "XtUnmanageChild(tp);\n");
		fprintf(f, "XtUnmanageChild(mp);\n");
		
		fprintf(f, "ip:height = %d;\n", ip:height);
		fprintf(f, "tp:height = %d;\n", tp:height);
		fprintf(f, "mp:height = %d;\n", mp:height);
		
		fprintf(f, "XtManageChild(ip);\n");
		fprintf(f, "XtManageChild(tp);\n");
		fprintf(f, "XtManageChild(mp);\n");
		fprintf(f, "XtManageChild(w);\n");
		
		fprintf(f, "XmUpdateDisplay(w);\n");
		
		fprintf(f, "_FmSetResourceDefaultSortFlags(%d);\n", _FmGetResourceDefaultSortFlags());
		fprintf(f, "_FmSetResourceDefaultSortPreferences('%s');\n", _FmGetResourceDefaultSortPreferences());
		
		fprintf(f, "}\n");
		
		if(!Boolean(root*main*radio:set))
			fprintf(f, "XmToggleButtonSetState(root*main*radio, False, True);\n");
		
		if(XtIsManaged(root.main.panes.interfaceForm.listform)){
			fprintf(f, "XmToggleButtonSetState(root*main*windowsPulldown.list, True, True);\n");
		}
		if(!XtIsManaged(root.main.panes.interfaceForm.treescroller)){
			fprintf(f, "XmToggleButtonSetState(root*main*windowsPulldown.tree, False, True);\n");
		}
		
		@ = f;
    }
    activevalue {
        name = _FmExiting
        set =
	if(self:@DrawMakerConnection){
		_FmCEDestroyConnection(self:@DrawMakerConnection);
		self:@DrawMakerConnection = Pointer(0);
	}
    }
    activevalue {
        name = DrawMakerConnection
        type = Pointer
        storage = object
        scope = public
        automatic = true
    }
    activevalue {
        name = CONNECT
        type = String
        storage = object
        automatic = true
        set =
	function None _fm_export_draw(Widget draw)
	{
		String s;
		s = _FmDrawHasDrawFile();
		if(s) {
			_FmCEMessage(draw:@DrawMakerConnection, "SAVE_AS_DRAW");
			_FmCESaveFile(draw:@DrawMakerConnection, s);
		} else {
			_FmCEMessage(draw:@DrawMakerConnection, "SAVE_AS_FM");
			_FmCESetFileName((draw:@DrawMakerConnection, String(0));
			s = _FmExportDraw();
			if(!s)
				s = "";
			_FmCELoadString(draw:@DrawMakerConnection, s);
		}
	}
	_fm_export_draw(self);
    }
    activevalue {
        name = DISCONNECT
        type = String
        storage = object
        automatic = true
        set =
	self:@DrawMakerConnection = Pointer(0);
	XtSetSensitive(self*drawmaker, _FmAcceptsDraw());
    }
    activevalue {
        name = LOAD
        type = String
        storage = object
        automatic = true
        set =
	if(@){
		global DrawJustLoaded;
		DrawJustLoaded = 1;
		_FmImportFm(@);
	}
    }
    activevalue {
        name = MODIFIED
        type = String
        storage = object
        automatic = true
        set =
	
    }
    createproc {
        global _FmRoot; _FmRoot = self;

	function None _FmShowRaise(String name)
	{
		Widget w = XtNameToWidget(root, name);
		if(!w){
			printf("Cannot find widget %s\n", name);
			return();
		}
		FmShowWidget(w);
		FmRaiseWidget(w);
	}
	
	function Any _FmPopDialogBox(String name, Int grab_mode, Int wait)
	{
		Widget w = XtNameToWidget(root, name);
		if(!w){
			printf("Cannot find box %s\n", name);
			return(0);
		}
		if(grab_mode == XtGrabExclusive)
			_FmGrabShowWidget(w);
		else
			FmShowWidget(w);
		if(wait)
			return(WaitForReturn());
		return(0);
	}
	
