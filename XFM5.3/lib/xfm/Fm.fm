                            resources {
                                listSizePolicy = constant
                                defaultActionCallback = s = String(self:userData);\
if (s != String(0)) {
	global _FmDontJustifyHelp;
	_FmDontJustifyHelp = 1;
	Help(Internationalize("%MSG%150%203 Function description"), help_function(s));
	_FmDontJustifyHelp = 0;\
}
                                browseSelectionCallback = s = String(self:userData);\
if (s != String(0))
	XtFree (String (s));\
XmListCallback cb;\
cb = $;\
self:userData = Pointer(FmGetString(cb->item));\
XEvent ev;\
ev = cb->event;\
if (cb->event != XEvent(0)) {
	if(ev->type == ButtonPress || ev->type == ButtonRelease)
		XtCallCallbacks(self, "defaultActionCallback", 0);\
}
                            }
                        } list
                    }
                } scroller
            }
        } form
    }
