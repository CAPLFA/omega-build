                                    resources {
                                        labelString = %MSG%150% Load Extensions...
                                        activateCallback =
	_FmSetSysAv("_FmCreateExtensionsBox");
	String extensions = root.extensions_shell:@_FmSelectExtensions;
	if(!extensions)
		return();
	String xfmname = _FmGetXfmName();
	if(!xfmname)
		return();
	String command = XtMalloc(1000);
	sprintf(command, "xfmextend %s %s", xfmname, extensions);
	_FmLaunchCommand(command, "_FmMakeAppliOutput", "_FmLoadExtensionComplete");
	XtFree(command);
