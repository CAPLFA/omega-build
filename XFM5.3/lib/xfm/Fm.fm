                widget XmPushButton {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        labelString = %MSG%150%66 OK
                        bottomAttachment = attach_form
                        leftAttachment = attach_form
                        activateCallback =
	script _fmc_okcol:
	local color;
	if(color)
		free(color);
	value = parent.ColorWix:value;
	if(equal(value, ""))
		color = "";
	else
		color = CheckColorName(value);
	color = NewString(color);
	free(value);
	global _FmRGBModified;
	if(_FmRGBModified){
		save = Alert(True, "dialog_question",
			Internationalize("%MSG%150%67 You have defined new colors:\nwould you like to save them in a file ?\n"));
		if(save)
			SaveRGBFile(String(0));
		_FmRGBModified = false;
	}
	Return(self, color);
	Hide(toplevel);
                    }
                } OK
                widget XmSeparator {
                    flag {
                        mapped
                        gadget
                    }
                    resources {
                        x = 10
                        y = 442
                        width = 380
                        height = 10
                        leftAttachment = attach_form
                        rightAttachment = attach_form
                        bottomAttachment = attach_widget
                        bottomWidget = parent.OK
                    }
                } XmSeparator0
                widget XmTextField {
                    flag {
                        mapped
                    }
                    activevalue {



                        name = _FmColorSelectionPixel

                        set = self:value = $;
	global resource_name;
	sw = parent.ColorScrolledWindow;
	rc = parent.ColorRowColumn;
	new = parent.New;
	da = sw.ColorDrawingArea;
	rn = parent.ResName;
	FmSelectColor(da, $);
	if(resource_name)
		rn:labelString = String(resource_name);
	class = ListColors(da, da:colormap);
	if(class == 0){
		Show(rc);
		Hide(sw);
		Hide(new);
		rc.White:set = Set(false);
		rc.Black:set = Set(false);
		if(equal($, "black")){
			rc.Black:set = Set(true);
		} else if(equal($, "white")){
			rc.White:set = Set(true);
		}
	} else {
		Show(sw);
		if(class == 2)
			Show(new);
		else
			Hide(new);
		Hide(rc);
		
	}
                    }
                    resources {
                        x = 10
                        y = 193
                        width = 293
                        height = 30
                        activateCallback = script _fmc_okcol;
                        blinkRate = 0
                        bottomAttachment = attach_widget
                        rightAttachment = attach_form
                        leftAttachment = attach_form
                        bottomWidget = parent.XmSeparator0
                    }
