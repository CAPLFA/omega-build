widget XmDialogShell {
    flag {
        popup
    }
    activevalue {
        name = _FmAVUsage
        get =
		global Int _FmCurrentAvType;
		if(XtIsManaged(self.form))
			@ = _FmCurrentAvType;
		else
			@ = _FM_AV_FACE;
    }
    activevalue {
        name = _FmEditAv
        set = list = self.form.scroller.list;\
xms = FmCreateXmString ($);\
pos = XmListItemPos (list,xms);\
if (pos == 0) {
	global Boolean _FmEditAvFailed;
	_FmEditAvFailed = True;
	Alert (False,"dialog_error", Internationalize("%MSG%150%348 Cannot find active value named `%s'.") ,$);\
} else if (Int(list:userData) != pos)
	XmListSelectPos (list,pos,True);
    }
    activevalue {
        name = _FmEditGetAvScriptLine
        set = function void _FmEditAvLine (Int line,Widget form) {
	global Boolean _FmEditAvFailed;
	if (_FmEditAvFailed)
		_FmEditAvFailed = False;
	else {
		if (!XtIsManaged (form)) {
			listbutton = self.form.list;
			if (XtIsManaged (listbutton))
				XtCallCallbacks (listbutton,"activateCallback",0);
		}
		if (!XtIsManaged (form))
			XmToggleButtonGadgetSetState (self.form.topForm.widgetRC.interface,True,True);
		text = form.scroller.text;
		pos = FmTextGetLineColumnPosition (text,line,0);
		next = FmTextGetLineColumnPosition (text,line + 1,0);
		XmTextSetHighlight (text,pos,next,XmHIGHLIGHT_SECONDARY_SELECTED);
		XmTextSetInsertionPosition (text,pos);
	}\
}\
_FmEditAvLine (@,self.form.scriptpanes.getform);
    }
    activevalue {
        name = _FmEditSetAvScriptLine
        set = _FmEditAvLine (@,self.form.scriptpanes.setform);
    }
    activevalue {
        name = _FmConnected
        set = if(@ && XtIsManaged(self.form))
			_FmCheckAvBox(True);
    }
    createproc {
function void _FmAvTextModified() {
	if (self:editable) {
		self:editable = False;
		self:userData = Pointer (True);
		self:editable = True;
	}\
}\
function void _FmAvConfig (Widget w) {
	global Boolean _FmAvReconfig;
	if (_FmAvReconfig) {
		g = w.getform;
		g_visible = XtIsManaged(g);
		s = w.setform;
		Widget edit = Widget(toplevel.form:userData);
		if(edit && edit != g && edit != s)
			return();
		h = (w:height - w:spacing) * Int (g:userData) / 100;
		XtUnmanageChild (w);
		FmUnmanageChildren (s,g,NULL);
		g:height = h;
		if (g_visible)
			FmManageChildren (s,g,NULL);
		else
			XtManageChild(s);
		XtManageChild (w);
	}\
}\
function void _FmAvDialog (Widget edit) {
	global Int _FmCurrentAvType;
	global Boolean _FmAvReconfig;
	global Boolean _FmDialogAvReconfig;
	f = toplevel.form;
	p = f.scriptpanes;
	if (edit) {
		pp = (XtParent (edit) == p);
		FmHideWidget (f.save);
		FmHideWidget (f.edit);
		XtSetSensitive (f.delete,False);
		if (pp) {
			_FmDialogAvReconfig = _FmAvReconfig;
			_FmAvReconfig = False;
			FmAttachRightWidget(edit.clear,NULL,6);
			FmHideWidget (edit.dots);
		}
		f.nameForm.name:editable = False;
		FmHideWidget (p);
		FmShowWidget (f.list);
		FmHideWidget (f.infoForm);
		FmHideWidget (f.scroller);
		FmHideWidget (f.listLabel);
		FmHideWidget (f.topForm);
		FmHideWidget (f.nameForm.select);
		FmHideWidget (f.nameForm);
		f.nameForm:bottomAttachment = XmATTACH_NONE;
		FmAttachRightWidget (f.nameForm,NULL,6);
		FmAttachTopWidget (f.nameForm,NULL,6);
		if (pp) {
			if (_FmDialogAvReconfig) {
				if (edit == p.getform)
					FmHideWidget (p.setform);
				else
					FmHideWidget (p.getform);
			}
			FmAttachTopWidget (p,f.nameForm,0);
			FmAttachLeftWidget (p,NULL,6);
			p:bottomWidget = f.add;
			FmShowWidget (p);
			FmShowWidget (f.nameForm);
		} else {
			ip = (edit == f.topForm.iconForm);
			cp = (edit == f.topForm.classForm);
			if (ip || cp) {
				if (ip)
					t = f.iconTitle;
				else
					t = f.classTitle;
				FmShowWidget (t);
				s = "Pixmap";
				v = f.topForm.iconForm.icon:value;
				b = f.sep;
			} else {
				FmShowWidget (f.buttonSep);
				s = f.infoForm.type:value;
				v = f.infoForm.value:value;
				t = f.nameForm;
				b = f.buttonSep;
				FmShowWidget (f.nameForm.sep);
				FmShowWidget (f.infoForm.valueLabel);
			}
			edit = _FmLoadResourceGroup (f,String(0),s);
			FmAttachTopWidget (edit,t,0);
			FmAttachLeftWidget (edit,NULL,6);
			FmAttachRightWidget (edit,NULL,6);
			FmAttachBottomWidget (edit,b,6);
			_FmGetTableResource(s);
			_FmSetResourceGroupAv (edit,s,String (0),v);
			free (v);
			if (!ip && !cp) {
				free (s);
				FmShowWidget (f.nameForm);
			}
		}
		f:userData = Pointer (edit);
		FmShowWidget (edit);
		if (!pp)
			FmSetActiveValue (edit,"_FmResourceEditManage");
	} else {
		edit = Widget (f:userData);
		FmHideWidget (edit);
		f:userData = Pointer (0);
		pp = (XtParent (edit) == p);
		if (pp) {
			FmHideWidget (p);
			FmHideWidget (f.nameForm);
		} else {
			ip = XtIsManaged (f.iconTitle);
			cp = XtIsManaged (f.classTitle);
			if (ip)
				v = f.topForm.iconForm.icon;
			else if (cp)
				v = f.topForm.classForm.icon;
			else
				v = f.infoForm.value;
			FmGetActiveValue (edit,"_FmResourceReturnValue");
			v:value = String ($_FmResourceReturnValue);
			if (ip || cp) {
				XmTextFieldSetInsertionPosition (v,XmTextFieldGetLastPosition (v));
				XtCallCallbacks (v,"activateCallback",0);
			} else
				XmTextSetInsertionPosition (v,XmTextGetLastPosition (v));
			FmHideWidget (f.gls);
			FmHideWidget (f.select);
			FmHideWidget (f.nameForm);
			FmHideWidget (f.nameForm.sep);
			FmHideWidget (f.buttonSep);
			FmHideWidget (f.iconTitle);
			FmHideWidget (f.classTitle);
		}
		f.nameForm:topAttachment = XmATTACH_NONE;
		f.nameForm:rightAttachment = XmATTACH_OPPOSITE_FORM;
		f.nameForm:rightOffset = -225;
		FmAttachBottomWidget (f.nameForm,f.add,6);
		FmShowWidget (f.nameForm);
		if (_FmCurrentAvType != _FM_AV_FACE)
			FmShowWidget (f.nameForm.select);
		FmShowWidget (f.topForm);
		FmShowWidget (f.listLabel);
		FmShowWidget (f.scroller);
		FmShowWidget (f.infoForm);
		FmHideWidget (f.list);
		f.nameForm.name:editable = True;
		if (pp) {
			FmAttachLeftWidget (p,f.nameForm,6);
			FmAttachTopWidget (p,f.infoForm,0);
			p:bottomWidget = f.sep;
			p:height = 10;
			FmShowWidget (p);
			if (_FmDialogAvReconfig) {
				_FmAvReconfig = True;
				if (!Boolean(f.infoForm.storageForm.storageRC.percall:set)) {
					FmManageChildren (p.getform,p.setform,NULL);
					_FmAvConfig (p);
				} else
					FmShowWidget (edit);
			} else
				FmShowWidget (edit);
			text = p.getform.scroller.text;
			if (XtIsManaged (text))
				XmTextShowPosition (text,XmTextGetInsertionPosition (text));
			text = p.setform.scroller.text;
			if (XtIsManaged (text))
				XmTextShowPosition (text,XmTextGetInsertionPosition (text));
			FmShowWidget (edit.dots);
			FmAttachRightWidget(edit.clear,edit.dots,0);
		} else {
			FmShowWidget (p);
		}
		XtSetSensitive (f.delete,f.replace:sensitive);
		XtSetSensitive (f.up,f.replace:sensitive);
		XtSetSensitive (f.down,f.replace:sensitive);
		if (_FmCurrentAvType == _FM_AV_CLASS) {
			FmShowWidget (f.edit);
			FmShowWidget (f.save);
		}
	}\
}\
function void _FmAvCheckChange (Widget w) {
	global Int _FmCurrentAvType;
	list = w.scroller.list;
	if (_FmCurrentAvType == _FM_AV_DRAG) {
		p = w.topForm.iconForm.icon:value;
		s = FmListGetItems (list);
		if (s != String (0) || strcmp (p,"") != 0) {
			if (s == String (0))
				s = XtNewString ("");
			_FmInsertStartDrag (s,p);
		} else {
			_FmRemoveStartDrag();
		}
		if (s != String (0))
			free (s);
	} else if (_FmCurrentAvType == _FM_AV_DROP) {
		s = FmListGetItems (list);
		if (s != String (0)) {
			_FmInsertRegisterDropSite (s);
			free (s);
		} else
			_FmRemoveRegisterDropSite();
	}\
}
