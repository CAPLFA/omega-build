                                    activevalue {
                                        name = _FmDrawWidgetHere
                                        set =
	if(@){
		XtManageChild(self);
		XtManageChild(parent.drawsep);
	} else {
		XtUnmanageChild(self);
		XtUnmanageChild(parent.drawsep);
	}
                                    }
                                    activevalue {
                                        name = _FmEditObjectChanged
                                        set =
	if(root:@DrawMakerConnection){
		global DrawJustLoaded;
		if(DrawJustLoaded)
			DrawJustLoaded = 0;
		else
			_fm_export_draw(root);
	} else {
		XtSetSensitive(self, _FmAcceptsDraw());
	}
                                    }
                                    activevalue {
                                        name = _FmDrawMakerButton
                                        get = @ = self;
                                    }
                                    resources {
                                        activateCallback =
	if(_FmCheckDrawGadget())
		return();
	if(root:@DrawMakerConnection){
		_fm_export_draw(root);
	} else {
		s = _FmDrawHasDrawFile();
		root:@DrawMakerConnection = _FmCustomEdit(root, "XDRAWMAKER", "dm -custom XDRAWMAKER");
		if(root:@DrawMakerConnection) {
			XtSetSensitive(self, False);
			if(s)
				_FmCEMessage(root:@DrawMakerConnection, "SAVE_AS_DRAW");
			else
				_FmCEMessage(root:@DrawMakerConnection, "SAVE_AS_FM");
		}
	}
                                        labelString = %MSG%150%672 Edit Graphics with XDrawMaker...
                                        sensitive = false
                                    }
