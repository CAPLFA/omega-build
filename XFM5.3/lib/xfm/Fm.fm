widget XmDialogShell {
    flag {
        popup
    }
            activevalue {
                name = _FmCreateExtensionsBox
                set = i = 0;
            }
    activevalue {
        name = _FmSelectExtensions
        get =
		if(self*list:itemCount == 0){
			String command = XtMalloc(1000);
			sprintf(command, "for f in %s/Extensions/Fm/*.face ; do basename $f .face ; done", $_FmLibDir);
			FILE f = popen(command, "r");
			XtFree(command);
			String exts = String(0);
			String ext = XtMalloc(100);
			while(fgets(ext, 100, f)){
				strcpy(String(ext+strlen(ext)-1), "");
				oldexts = exts;
				exts = _FmConcatString(oldexts, ext, ",");
				XtFree(oldexts);
			}
			XtFree(ext);
			fclose(f);
			if(strcmp(exts, "*") != 0)
				FmListSetItems(self*list, exts);
			XtFree(exts);
		}
		XtManageChild(self*extensions_box);
		if(FmPopupAndWait(self)){
			@ = String(0);
			Int n = self*list:selectedItemCount;
			XmString items[Int] = new_c_array(Pointer(self*list:selectedItems), n);
			for(i = 0; i < n; i = i+1){
				String old = @;
				String item = FmGetString(items[i]);
				@ = _FmConcatString(old, item, " ");
				XtFree(old);
				XtFree(item);
			}
			destroy(items);
		} else {
			@ = String(0);
		}
        type = String
        storage = object
        automatic = true
    }
    resources {
        x = 353
        y = 244
        width = 337
        height = 316
        title = Extension Selection Box
    }
