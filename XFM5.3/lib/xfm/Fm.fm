                            createproc {
                                function Int _FmSetWidgetCOption (Int flags,String name,Int bit,Boolean ok) {
	if (ok) {
		form = toplevel.form;
		ok = Boolean(form.typeRC.create:set);
		if (ok) {
			rc = form.initForm.initFrame.rc;
			if (name) {
				w = XtNameToWidget (rc,name);
				if (w)
					ok = Boolean(w:set);
			}
		}
	}
	return (_FmBitSet (flags,bit,ok));\
}
                            }
                            resources {
                                topAttachment = attach_widget
                                topWidget = initLabel
                                leftAttachment = attach_opposite_widget
                                leftWidget = initLabel
