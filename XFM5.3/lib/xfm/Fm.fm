	function None _FmDebugRunButtons()
	{
		toplevel*close:sensitive 	= False;
		toplevel*step:sensitive 	= False;
		toplevel*intrpt:sensitive 	= True;
		toplevel*abort:sensitive 	= False;
		toplevel*cont:sensitive 	= False;
		toplevel*stepbystep:sensitive 	= False;
		toplevel*tracingon:sensitive 	= False;
		toplevel*traceall:sensitive 	= False;
		toplevel*execute:sensitive 	= False;
		toplevel*stack:sensitive 	= False;
		toplevel*clear:sensitive 	= False;
		toplevel*help:sensitive 	= False;
		
		_FmProcessPendingEvents(toplevel*intrpt);
	}
	
	function None _FmDebugNormalButtons()
	{
		toplevel*close:sensitive 	= True;
		toplevel*step:sensitive 	= False;
		toplevel*intrpt:sensitive 	= False;
		toplevel*abort:sensitive 	= False;
		toplevel*cont:sensitive 	= False;
		toplevel*stepbystep:sensitive 	= True;
		toplevel*tracingon:sensitive 	= True;
		toplevel*traceall:sensitive 	= True;
		toplevel*execute:sensitive 	= True;
		toplevel*stack:sensitive 	= True;
		toplevel*clear:sensitive 	= True;
		toplevel*help:sensitive 	= True;
	}
	
	function None _FmDebugStepButtons(FaceDebugCallback cbs)
	{
		toplevel*close:sensitive 	= False;
		toplevel*step:sensitive 	= True;
		toplevel*intrpt:sensitive 	= False;
		toplevel*abort:sensitive 	= _FmGetDebugAbortOK(cbs);
		toplevel*cont:sensitive 	= True;
		toplevel*stepbystep:sensitive 	= True;
		toplevel*tracingon:sensitive 	= True;
		toplevel*traceall:sensitive 	= True;
		toplevel*execute:sensitive 	= True;
		toplevel*stack:sensitive 	= True;
		toplevel*clear:sensitive 	= True;
		toplevel*help:sensitive 	= True;
	}
	
	function None _FmDebugContButtons()
	{
		toplevel*close:sensitive 	= False;
		toplevel*step:sensitive 	= False;
		toplevel*intrpt:sensitive 	= False;
		toplevel*abort:sensitive 	= False;
		toplevel*cont:sensitive 	= True;
		toplevel*stepbystep:sensitive 	= False;
		toplevel*tracingon:sensitive 	= True;
		toplevel*traceall:sensitive 	= True;
		toplevel*execute:sensitive 	= True;
		toplevel*stack:sensitive 	= True;
		toplevel*clear:sensitive 	= True;
		toplevel*help:sensitive 	= True;
	}
	
	function None _FmDebugStepping(Boolean on)
	{
		global Int _FaceDebugStepping;
		_FaceDebugStepping = on;
		toplevel*stepbystep:set = Set(on);
	}
	
	global Int _FmDebugParsing;
	if(_FmDebugParsing){
		toplevel*message_text:value = Internationalize("%MSG%150%100 Parsing restarted");
		_FmDebugNormalButtons();
	} else {
		toplevel*message_text:value = Internationalize("%MSG%150%101 Running...");
		_FmDebugRunButtons();
	}
	
	_FmDebugStepping(False);
	_FmDebugStep();
	
	global Int _FmTraceAll;
	if(!_FmTraceAll)
		_FmDebugClean();
	
