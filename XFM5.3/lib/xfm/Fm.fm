                widget XmSelectionBox {
                    flag {
                        autosize
                        autopos
                    }
                    activevalue {
                        name = _FmListGroup
                        set = function None _FileSubList(String s)\
{
	_FmListFill (SelectionBoxGetChild(self, XmDIALOG_LIST), $);\
}\
_FileSubList($);
                    }
                    activevalue {
                        name = _FmListTemplate
                        set = _FileSubList($);
                    }
                    activevalue {
                        name = _FmListClass
                        set = _FileSubList($);
                    }
                    activevalue {
                        name = _FmFileSubSelection
                        set = xms = FmCreateXmString("");\
self:textString = xms;\
xms = FmCreateXmString($);\
w = SelectionBoxGetChild(self, XmDIALOG_LIST);\
XmListSelectItem(w, xms, True);\
xmv = self:textString;\
s = FmGetString(xmv);\
if(strcmp(s, "") == 0)
	self:textString = xms;\
XtFree(s);\
XmStringFree(xmv);\
XmStringFree(xms);
                    }
                    createproc {
                        FmListAllowKeySelection(SelectionBoxGetChild(self, XmDIALOG_LIST), False, String(0), True);\
w = SelectionBoxGetChild(self, XmDIALOG_APPLY_BUTTON);\
XtUnmanageChild(w);
                    }
                    resources {
                        topAttachment = attach_form
                        leftAttachment = attach_form
                        rightAttachment = attach_form
                        bottomAttachment = attach_form
                        okLabelString = %MSG%150%191 OK
                        cancelLabelString = %MSG%150%192 Cancel
                        cancelCallback = FmHideWidget(self);\
FmShowWidget(parent.filesel);\
s = String(parent:userData);\
toplevel:title = s;
                        okCallback = w = Widget (self:userData);\
xms = self:textString;\
s = FmGetString(xms);\
XmStringFree(xms);\
w:value = s; XmTextFieldSetInsertionPosition(w, XmTextFieldGetLastPosition(w));\
XtFree(s);\
FmHideWidget(self);\
FmShowWidget(parent.filesel);\

                        helpCallback = if(@_FmAskingGroup){
	topic = Internationalize("%MSG%150%193 groupname");
	title = Internationalize("%MSG%150%194 Group Name");\
} else if(@_FmAskingTemplate){
	topic = Internationalize("%MSG%150%195 templatename");
	title = Internationalize("%MSG%150%196 Template Name");\
} else if(@_FmAskingClass){
	topic = Internationalize("%MSG%150%197 classname");
	title = Internationalize("%MSG%150%198 Class Name");\
}\
s = FmGetHelp( Internationalize("%MSG%150%199 Dialogs"), topic);\
GrabbingHelp(title, s);\
XtFree(s);
                    }
                } subselector
            }
        } form
    }
} Fileselector
