widget XmDialogShell {
    flag {
        popup
        autosize
        autopos
    }
    resources {
        title = %MSG%150%821 Message Catalog Options
        popupCallback = self:minWidth = self:width;\
self:minHeight = self:height;\
self:maxHeight = self:height;
    }
    children {
        widget XmForm {
            flag {
                autosize
                autopos
            }
            createproc {
                h = self.commandLabel:height;\
n = self.command:height;\
if (h > n)
	command:marginHeight = (h - n) / 2;\
else
	commandLabel:marginHeight = (n - h) / 2;
            }
            resources {
                autoUnmanage = false
                mapCallback = _FmSetSysAv("_FmSaveMessages");\
_FmSetSysAv("_FmCurSetNumber");\
_FmSetSysAv("_FmCommandLine");
            }
            children {
                widget XmToggleButton {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    activevalue {
                        name = _FmStartupFile
                        set = if (Boolean(self:set))
	s = "True";\
else
	s = "False";\
fprintf (@,"_FmCmdSetMsgMode(%s);\n",s);
                    }
                    activevalue {
                        name = _FmSaveMessages
                        set = self:set = Set(@);
                    }
                    resources {
                        labelString = %MSG%150%822 Save message catalog file
                        marginHeight = 0
