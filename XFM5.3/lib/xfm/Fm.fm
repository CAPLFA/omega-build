                                    createproc {
                                        function None _FmAdjustMainIcons(Boolean event) {
	global _fm_main_icons_rc_w;
	global _fm_main_icons_rc_h;
	width = self:width;
	height = self:height;
	if(event
	&& _fm_main_icons_rc_w == width
	&& _fm_main_icons_rc_h == height){
		return();
	}
	_fm_main_icons_rc_w = width;
	_fm_main_icons_rc_h = height;
	
	H = parent:height - parent.buttonLabel:height - parent.buttonLabel:y - 5;
	h = self.delete:height;
	nc = H / h;
	N = self:numChildren;
	c = (N + (nc - 1)) / nc;
	if(c == 0)
		c = 1;
	XtUnmanageChild(self);
	self:numColumns = c;
	XtManageChild(self);
	parent.buttonLabel:width = self:width; \
	XtUnmanageChild(parent.buttonLabel);
	XtManageChild(parent.buttonLabel);\
}
