                                        autosize
                                        autopos
                                    }
                                    activevalue {
                                        name = _FmMainArrowPressScript
                                        set = script _FmMainArrowPress:\
XButtonEvent ev = $;\
global Dimension _FmMainOldListWidth;\
global Dimension _FmMainNewListWidth;\
global Position _FmMainArrowX;\
_FmMainOldListWidth = parent.listform:width;\
_FmMainArrowX = ev->x;\
parent.mark:leftOffset = ev->x + self:x;\
FmShowWidget (parent.mark);\
FmRaiseWidget (parent.mark);
                                    }
                                    activevalue {
                                        name = _FmMainArrowMoveScript
                                        set = script _FmMainArrowMove:\
XMotionEvent ev = $;\
global Dimension _FmMainOldListWidth;\
global Dimension _FmMainNewListWidth;\
global Position _FmMainArrowX;\
_FmMainNewListWidth = _FmMainOldListWidth + ev->x - _FmMainArrowX;\
_FmMainAdjustWidth();\
parent.mark:leftOffset = _FmMainArrowX + self:x + _FmMainNewListWidth - _FmMainOldListWidth;
                                    }
                                    activevalue {
                                        name = _FmMainArrowReleaseScript
                                        set = script _FmMainArrowRelease:\
XButtonEvent ev = $;\
global Dimension _FmMainOldListWidth;\
global Dimension _FmMainNewListWidth;\
global Position _FmMainArrowX;\
_FmMainNewListWidth = _FmMainOldListWidth + ev->x - _FmMainArrowX;\
_FmMainAdjustWidth();\
FmHideWidget (parent.mark);\
FmHideWidget (parent.treescroller);\
FmHideWidget (parent.biarrow);\
FmHideWidget (parent.listform);\
parent.listform:width = _FmMainNewListWidth;\
FmShowWidget (parent.biarrow);\
FmShowWidget (parent.treescroller);\
FmShowWidget (parent.listform);
                                    }
                                    createproc {
                                        function void _FmMainAdjustWidth () {
	global Dimension _FmMainNewListWidth;
	if (_FmMainNewListWidth < 120)
		_FmMainNewListWidth = 120;
	n = parent.listform:width + parent.treescroller:width - 120;
	if (_FmMainNewListWidth > n)
		_FmMainNewListWidth = n;\
}\
self:x = parent.editRC:x + parent.editRC:width + 155;
