widget XmDialogShell {
    flag {
        popup
        autosize
    }
    resources {
        x = 419
        y = 290
        deleteResponse = do_nothing
        allowShellResize = true
        title = %MSG%150%140 File Name
    }
    children {
        widget XmFileSelectionBox {
            flag {
                autosize
                autopos
            }
            activevalue {
                name = FmResourceFilePattern
                set = xms = CreateXmString (String ($)); \
self:dirMask = xms; \
StringFree (xms);
            }
            activevalue {
                name = _FileName
                set = global _FmResourceFileName; \
if (_FmResourceFileName != 0)
	StringFree (Any(_FmResourceFileName)); \
_FmResourceFileName = CreateXmString ($);
            }
            createproc {
                UnmanageChild (FileSelectionBoxGetChild (self,XmDIALOG_HELP_BUTTON));
            }
            resources {
                dialogStyle = dialog_full_application_modal
                defaultPosition = false
                dirListLabelString = %MSG%150%141 Directories
                fileListLabelString = %MSG%150%142 Files
                selectionLabelString = %MSG%150%143 Selection
                okLabelString = %MSG%150%144 OK
                applyLabelString = %MSG%150%145 Filter
                cancelLabelString = %MSG%150%146 Cancel
                mapCallback = global resource_name; \
if (resource_name != 0) {
	s = malloc (strlen (String(resource_name)) + 20);
	sprintf (s, Internationalize("%MSG%150%147 %s\n \nFilter"),resource_name);
	xms = CreateXmString (String (s)); \
        self:filterLabelString = xms; \
        StringFree (xms); \
	free (s); \
} \
local list; \
global _FmResourceFileName; \
if (list == 0)
	list = FileSelectionBoxGetChild (self,XmDIALOG_LIST); \
ListDeselectAllItems (list); \
if (_FmResourceFileName != 0 && ListItemExists (list,Any(_FmResourceFileName)))
	ListSelectItem (list,Any(_FmResourceFileName),True); \
else
	self:dirSpec = Any(_FmResourceFileName);
                cancelCallback = Return (self,String(0)); \
hide (self);
                okCallback = xms = self:dirSpec; \
s = GetString (xms); \
StringFree (xms); \
Return (self,s); \
hide (self);
            }
        } filesel
    }
} FileResource

widget XmDialogShell {
    flag {
        popup
        autosize
        autopos
    }
    activevalue {
        name = _FmToCreate
        set = dummy = 0;
    }
    resources {
    }
    children {
        widget XmSelectionBox {
            flag {
                autosize
                autopos
            }
            resources {
                dialogType = dialog_prompt
                selectionLabelString = Launch the following command :
                okLabelString=Launch
                okCallback =
			XmString xms = self:textString;
			s = GetString(xms);
			if (strcmp (s, "acroread") > 0) {
				_FmLaunchAcrobat(self, s);
			} else {
				_FmLaunchNetscape(self, s);
			}
			free(s);
			XmStringFree(xms);			
            }
        } BrowserBox
    }
} BrowserDialog
