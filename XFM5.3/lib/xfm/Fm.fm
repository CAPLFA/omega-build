                widget XmPushButton {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    createproc {
                        function void _FmAvAddButton (String replaced) {
	if (XtIsManaged (parent.list))
		XtCallCallbacks (parent.list,"activateCallback",0);
	n = parent.nameForm.name:value;
	g = parent.scriptpanes.getform.scroller.text:value;
	s = parent.scriptpanes.setform.scroller.text:value;
	info = parent.infoForm;
	t = info.type:value;
	f = info.storageForm;
	if(!XtIsManaged(f)){
		storage = _FM_AV_OBJECT;
		automatic = True;
	} else {
		rc = f.storageRC;
		if (Boolean(rc.global:set))
			storage = _FM_AV_GLOBAL;
		else if (Boolean(rc.perwidget:set))
			storage = _FM_AV_OBJECT;
		else if (Boolean(rc.percall:set))
			storage = _FM_AV_NONE;
		else
			storage = 0;
		automatic = Boolean(f.auto:set);
	}
	sf = f;
	f = info.accessForm;
	if(!XtIsManaged(f)){
		scope = _FM_AV_PUBLIC;
		immediate = False;
		genfun = False;
	} else {
		rc = f.accessRC;
		if (Boolean(rc.public:set))
			scope = _FM_AV_PUBLIC;
		else if (Boolean(rc.protected:set))
			scope = _FM_AV_PROTECTED;
		else if (Boolean(rc.private:set))
			scope = _FM_AV_PRIVATE;
		else
			scope = 0;
		immediate = Boolean(f.immed:set);
		genfun = Boolean(sf.genfun:set);
	}
	if (XtIsManaged (info.value))
		v = info.value:value;
	else
		v = String(0);
	global Int _FmCurrentAvType;
	_FmAddAv (n,replaced,g,s,t,storage,scope,immediate,automatic,v, genfun, _FmCurrentAvType);
	if (v)
		free (v);
	
	_FmSelectAv (n);
	free (t);
	free (s);
	free (g);
	free (n);\
}
                    }
                    resources {
                        labelString = %MSG%150%398 Add
                        marginHeight = 1
                        marginWidth = 3
                        topAttachment = attach_none
                        leftAttachment = attach_form
                        leftOffset = 6
                        bottomAttachment = attach_widget
                        bottomOffset = 6
                        bottomWidget = sep
                        activateCallback = _FmAvAddButton(String(0));\
_FmAvCheckChange (parent);
                    }
                } add
