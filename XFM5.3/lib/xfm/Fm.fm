                    }
                    resources {
                        labelString = %MSG%150%136 Add
                        marginHeight = 1
                        marginWidth = 3
                        leftAttachment = attach_form
                        bottomAttachment = attach_widget
                        bottomWidget = parent.sep
                        activateCallback =
	Widget list = toplevel*list;
	String s = toplevel*text:value;
	if(equal(s, "")) return();
	global Int _FmEnvListPos;
	if(_FmEnvListPos > 0)
		pos = _FmEnvListPos+1;
	else
		pos = 0;
	XmListAddItem(list, XmStringCreateSimple(s), pos);
	XmListSelectPos(list, pos, True);
	if(pos == 0)
		pos = list:itemCount;
	if(pos >= list:topItemPosition + list:visibleItemCount){
		pos = pos - list:visibleItemCount + 1;
		if(pos < 1)
			pos = 1;
		 type TopItemPosition;
