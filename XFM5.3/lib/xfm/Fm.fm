                                            resources {
                                                labelString = %MSG%150%576 New XFM
                                                activateCallback =
	function String _FmGetXfmName()
	{
		_FmSetSysAv("_FmCreateXfmNameBox");
		global String _FmNewXfmName;
		if(!_FmNewXfmName)
			_FmNewXfmName = XtNewString("myxfm");
		root.xfmnameshell.xfmnameprompt:textString = _FmNewXfmName;
		XtManageChild(root.xfmnameshell.xfmnameprompt);
		String name = FmPopupAndWait(root.xfmnameshell);
		if(name){
			global String _FmNewXfmName;
			if(_FmNewXfmName)
				XtFree(_FmNewXfmName);
			_FmNewXfmName = name;
		}
		return(name);
	}
	String name = _FmGetXfmName();
	if(name){
		_FmCmdSaveAppliFiles("XfmMain.c,Ext.c,XfmMake", name, String(0), String(0));
	}
                                            }
                                        } xfm
