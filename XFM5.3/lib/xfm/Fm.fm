	function FaceDebugInfo _FmDebugShowSource(FaceDebugCallback cbs)
	{
		FaceDebugInfo debug_info = _FmGetDebugInfoPtr(cbs);
		FaceDebugInfo prog_info = _FmGetProgDebugInfo(debug_info);
		String source_string = _FmGetStringDebugInfo(prog_info, FACE_DEBUG_SOURCE_STR, 0);
		if(source_string)
			self:value = source_string;
		String script_name = _FmGetStringDebugInfo(prog_info, FACE_DEBUG_SCRIPT_NAME, 0);
		if(script_name)
			toplevel*script_text:value = script_name;
		String widget_name = _FmGetDebugWidgetName(cbs);
		if(widget_name)
			toplevel*widget_text:value = widget_name;
		return(debug_info);
	}
	
	function None _FmDebugError(FaceDebugCallback cbs)
	{
		FaceDebugInfo debug_info = _FmDebugShowSource(cbs);
		
		function None Highlight(FaceDebugCallback cbs,
					XmHighlightMode mode);
		global Int _FaceDebugLeftHighlight;
		global Int _FaceDebugRightHighlight;
		_FaceDebugLeftHighlight = 0;
		_FaceDebugRightHighlight = 0;
		Highlight(cbs, XmHIGHLIGHT_SELECTED);
		
		function None _FmDebugOutput(String);
		_FmDebugOutput(_FmGetStringDebugData(cbs));
		
		_FmSetCurDebugInfo(debug_info);
		
		global Int _FmDebugParseError;
		_FmDebugParseError = 1;
	}
	
	function None _FmDebugOutput(String msg)
	{
		global Int _FmDebugMsgNum;
		
		Widget text = toplevel*output_text;
		if(!text)
			return();
		String sep = "                                                     ";
		String fmt = "<<< %d >>>\n";
		sprintf(sep, fmt, _FmDebugMsgNum);
		_FmDebugMsgNum = _FmDebugMsgNum + 1;
		pos = XmTextGetLastPosition(text);
		XmTextInsert(text, pos, sep);
		newpos = XmTextGetLastPosition(text);
		XmTextSetHighlight(text, pos, newpos, XmHIGHLIGHT_SECONDARY_SELECTED);
		XmTextInsert(text, newpos, msg);
		XmTextSetInsertionPosition(text, pos);
		XmTextSetTopCharacter(text, pos);
	}
	
	function None _FmDebugWaitStep(FaceDebugCallback cbs)
	{
		global Int _FmDebugParsing;
		if(_FmDebugParsing){
			_FmDebugContButtons();
			_FmDebugStepping(False);
		} else {
			_FmDebugStepButtons(cbs);
			_FmDebugStepping(True);
		}
		_FmDisableUserInput();
		_FmDisableXfmInput();
		Show(toplevel);
		global _FaceDebugNextStep;
		_FaceDebugNextStep = 0;
		global FaceDebugCallback _FmDebugCurCBS;
		_FmDebugCurCBS = cbs;
		while(!_FaceDebugNextStep)
			_FmProcessEvent();
		type FaceDebugCallback;
		_FmDebugCurCBS = FaceDebugCallback(0);
		_FmEnableXfmInput();
		_FmEnableUserInput();
	}
	
	toplevel*message_text:value = Internationalize("%MSG%150%109 Parse error");
	
	_FmDebugError($);
	_FmDebugWaitStep($);
