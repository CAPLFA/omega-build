    resources {
        geometry = -0+0
        height = 590
        width = 440
        minHeight = 335
        minWidth = 440
        iconName = XFaceMaker
        iconPixmap = XfmIcon
        translations = #override \
<Unmap>: eval("_FmIconifyResourceWindows (True);")\
<Map>: eval("_FmIconifyResourceWindows (False);")
    }
    children {
        widget XmMainWindow {
            flag {
                mapped
                autopos
            }
            createproc {
                parent:title = FmFullVersionString;
            }
            resources {
                height = 590
                width = 440
            }
            children {
                widget XmRowColumn {
                    flag {
                        mapped
                        autosize
                        autopos
                        menu_bar
                    }
                    activevalue {
                        name = _FmMainMenuBar
                        get = @ = self;
                    }
                    createproc {
 self:menuHelpWidget = self.help;
                    }
                    children {
