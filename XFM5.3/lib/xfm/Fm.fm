                        sensitive = false
                        topAttachment = attach_opposite_widget
                        topWidget = add
                        leftAttachment = attach_widget
                        leftOffset = 5
                        leftWidget = add
                        activateCallback = list = parent.scroller.list;\
n = Int (list:userData);\
s = parent.nameForm.name:value;\
xms = FmCreateXmString (s);\
p = XmListItemPos (list,xms);\
if (p != 0 && p != n) {
	if (!Alert (True,"dialog_question",
		    Internationalize("%MSG%150%400 `%s' already exists.\nDo you want to overwrite it?") ,s))
		return();\
}\
XmStringFree (xms);\
free (s);\
_FmAvAddButton(FmListGetNthItem(list,n));\
_FmAvCheckChange (parent);
                    }
