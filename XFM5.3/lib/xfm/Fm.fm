                                            activevalue {
                                                name = _FmCurFileName
                                                set = function void _FmSetTextWithSuffix(String suffix) {
	if(XtIsManaged(parent)) {
		s = _FmReplaceSuffix(String($), suffix);
		self:editable = False;
		self:value = s; XmTextFieldSetInsertionPosition(self, XmTextFieldGetLastPosition(self));
		XtFree(s);
		self:userData = Pointer(False);
		self:editable = True;
	}\
}\
	if(@_FmSaveCxxClass){
		_FmSetTextWithSuffix("C");
		parent.label:labelString = Internationalize("%MSG%150%183 C++ file to save:");
	} else {
		_FmSetTextWithSuffix("c");
		parent.label:labelString = Internationalize("%MSG%150%184 C file to save:");
	}
                                            }
                                            activevalue {
                                                name = _FmCFileName
                                                get = _FmCopySysAvTextValue(self, "_FmCFileName");
                                            }
                                            activevalue {
                                                name = _FmFileNameSelected
                                                set = function void _FmCopyTextWithSuffix(String suffix) {
	if(XtIsManaged(parent)) {
		xms = toplevel.form.filesel:dirSpec;
		s = FmGetString(xms);
		XmStringFree(xms);
		v = _FmReplaceSuffix(s, suffix);
		XtFree(s);
		self:editable = False;
		self:value = v; XmTextFieldSetInsertionPosition(self, XmTextFieldGetLastPosition(self));
		XtFree(v);
		self:userData = Pointer(False);
		self:editable = True;
	}\
}\
	if(@_FmSaveCxxClass)
		_FmCopyTextWithSuffix("C");
	else
		_FmCopyTextWithSuffix("c");
                                            }
                                            activevalue {
                                                name = _FmCheckSaveFileName
                                                set = script _FmCheckFileNameText:\
if(self:userData == Pointer(False))
	FmSetActiveValue(self,"_FmFileNameSelected");
