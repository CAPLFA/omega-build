    createproc {
	function void _FmMenuResource (String typename,Widget tx,XmString cb) {
	form = toplevel.form;
	FmHideWidget (form.menuForm);
	FmHideWidget (form.menuSep);
	XtSetSensitive (form.close,False);
	XtSetSensitive (form.clear,False);
	form = form.confirmForm;
	w = _FmLoadResourceGroup (form,NULL,typename);
	FmShowWidget (form);
	if (cb != NULL) {
		form.cbName:labelString = cb;
		FmShowWidget (form.cbName);
		FmShowWidget (form.cbLabel);
		FmAttachTopWidget (w,form.cbLabel,0);
	} else {
		FmHideWidget (form.cbLabel);
		FmHideWidget (form.cbName);
		FmAttachTopWidget (w,form,0);
	}
	FmAttachLeftWidget (w,form,0);
	FmAttachRightWidget (w,form,0);
	FmAttachBottomWidget (w,form.sep,8);
	s = tx:value;
	_FmSetResourceGroupAv (w,typename,NULL,s);
	XtFree (s);
	FmShowWidget (w);
	FmSetActiveValue (w,"_FmResourceEditManage");
	form.confirm:userData = Pointer (tx);
	form:userData = Pointer (w);\
}\
function void _FmMenuUnresource (Boolean copy) {
	form = toplevel.form.confirmForm;
	w = Widget (form:userData);
	if (w == NULL)
		return();
	form:userData = NULL;
	if (copy) {
		tx = Pointer (form.confirm:userData);
		FmGetActiveValue (w,"_FmResourceReturnValue");
		tx:value = $_FmResourceReturnValue;
	}
	FmHideWidget (w);
	FmHideWidget (form.select);
	FmHideWidget (form);
	form = toplevel.form;
	XtSetSensitive (toplevel.form.close,True);
	XtSetSensitive (toplevel.form.clear,True);
	FmShowWidget (form.menuSep);
	FmShowWidget (form.menuForm);\
}
    }
