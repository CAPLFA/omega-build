	function None Highlight(FaceDebugCallback cbs,
				XmHighlightMode mode)
	{
		Int b_char = _FmGetDebugInfo(_FmGetDebugInfoPtr(cbs), FACE_DEBUG_B_CHAR, -1);
		Int e_char = _FmGetDebugInfo(_FmGetDebugInfoPtr(cbs), FACE_DEBUG_E_CHAR, -1);
		global Int _FaceDebugLeftHighlight;
		global Int _FaceDebugRightHighlight;
		XmTextSetHighlight(self, _FaceDebugLeftHighlight, _FaceDebugRightHighlight, XmHIGHLIGHT_NORMAL);
		if(e_char < b_char)
			e_char = b_char+1;
		_FaceDebugLeftHighlight = b_char;
		_FaceDebugRightHighlight = e_char;
		XmTextSetInsertionPosition(self, _FaceDebugLeftHighlight);
		XmTextSetHighlight(self, _FaceDebugLeftHighlight, _FaceDebugRightHighlight, mode);
	}
	
	function None UnHighlight()
	{
		global Int _FaceDebugLeftHighlight;
		global Int _FaceDebugRightHighlight;
		XmTextSetHighlight(self, _FaceDebugLeftHighlight, _FaceDebugRightHighlight, XmHIGHLIGHT_NORMAL);
		_FaceDebugLeftHighlight = 0;
		_FaceDebugRightHighlight = 0;
	}
	
	global Int _FaceDebugStepping;
	global _FmTraceAll;
	if(!_FmTraceAll && !_FaceDebugStepping){
		_FmProcessPendingEvents(toplevel*intrpt);
		return();
	}
	
	Highlight($, XmHIGHLIGHT_SELECTED);
	if(_FaceDebugStepping){
		_FmDebugWaitStep($);
	} else {
		_FmProcessPendingEvents(toplevel*intrpt);
	}
