        remote None _XnslAttachXrtRemoteAvs;
    }
    resources {
        x = 440
        y = 198
    }
    children {
        widget XmForm {
            flag {
                autosize
                autopos
            }
            activevalue {
                name = _XrtXLabel
                set = _XnslSetXrtLabel (self,"XrtXLabels",String ($));
            }
            createproc {
                _XnslAttachXrtAvs();
		_XnslAttachXrtRemoteAvs();
            }
            resources {
                autoUnmanage = false
                defaultPosition = false
                dialogStyle = dialog_full_application_modal
                buttonFontList = *helvetica-bold-r-*-12-*
                labelFontList = *helvetica-bold-r-*-12-*
                textFontList = *courier-medium-r-*-12-*
                mapCallback = local Boolean already;\
if (!already) {
	already = True;
	parent:minWidth = self:width;
	parent:minHeight = self:height;
	parent:maxHeight = self:height;\
}
                unmapCallback = global resource_returning;\
if (!resource_returning)\
        Return (self,String (0));\
else\
        resource_returning = False;
                mapCallback = global resource_name;\
if (resource_name != 0) {\
        xms = CreateXmString (String (resource_name));\
        self.resource:labelString = xms;\
        StringFree (xms);\
}

            }
            children {
                widget XmPushButton {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        labelString = %MSG%1% OK
                        marginHeight = 3
                        marginWidth = 5
                        activateCallback = global resource_returning;\
resource_returning = True;\
hide (parent);\
Return (self,_XnslGetXrtLabel());
                        topAttachment = attach_none
                        leftAttachment = attach_form
                        leftOffset = 8
                        bottomAttachment = attach_form
                        bottomOffset = 8
                    }
                } ok
                widget XmPushButton {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        labelString = %MSG%1% Cancel
                        marginHeight = 3
                        marginWidth = 5
                        activateCallback = global resource_returning;\
resource_returning = True;\
hide (parent);\
Return (self,String (0));
                        topAttachment = attach_opposite_widget
                        topAttachment = attach_opposite_widget
                        topWidget = ok
                        leftAttachment = attach_none
                        rightAttachment = attach_form
                        rightOffset = 8
                    }
                } cancel
                widget XmLabel {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        topAttachment = attach_form
                        topOffset = 8
                        leftAttachment = attach_form
                        leftOffset = 8
                    }
                } resource
                widget XmLabel {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        labelString = %MSG%1% Value:
                        alignment = alignment_beginning
                        topAttachment = attach_widget
                        topOffset = 20
                        topWidget = resource
                        leftAttachment = attach_form
                        leftOffset = 8
                    }
                } valueLabel
                widget XmTextField {
                    flag {
                        mapped
                        autosize
                        autopos
                    }
                    activevalue {
                        name = _XrtValue
                        set = script _XrtLabelSetTextValue:\
self:value = String(@);\
TextFieldSetInsertionPosition (self,TextFieldGetLastPosition (self));
                        get = script _XrtLabelGetTextValue:\
@ = self:value;
                    }
                    resources {
                        topAttachment = attach_widget
                        topOffset = 13
                        topWidget = resource
                        leftAttachment = attach_widget
                        leftWidget = valueLabel
                        leftOffset = 3
                        rightAttachment = attach_form
                        rightOffset = 8
                    }
                } value
                widget XmLabel {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        labelString = %MSG%1% Label:
                        alignment = alignment_beginning
                        topAttachment = attach_widget
                        topOffset = 10
                        topWidget = value
                        leftAttachment = attach_form
                        leftOffset = 8
                    }
                } labelLabel
                widget XmTextField {
                    flag {
                        mapped
                        autosize
                        autopos
                    }
                    activevalue {
                        name = _XrtLabel
                        set = script _XrtLabelSetTextValue;
                        get = script _XrtLabelGetTextValue;
                    }
                    resources {
