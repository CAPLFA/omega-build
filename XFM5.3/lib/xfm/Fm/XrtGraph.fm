                                function void _XrtDataStyleAskColor (Widget text,Widget sample) {
	old = text:value;
	s = FmCallResourceBox("Pixel", old, "ColorSelectionBox", "_FmColorSelectionPixel");
	free (old);
	if (s != 0 && strlen(s) > 0) {
		_XrtDataStyleSetTextFieldValue (text,s);
		sample:background = ConvertString (sample,s,"Pixel");
	}\
}
                            }
