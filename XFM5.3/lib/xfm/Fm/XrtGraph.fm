                                gadget
                            }
                            createproc {
                                function void _XrtDataStyleSetTextFieldIntValue (Widget w,Int n) {
	s = itoa (n);
	w:value = s;
	free (String (s));
	TextFieldSetInsertionPosition (w,TextFieldGetLastPosition (w));\
}
				
				SetValues (self,1,userData,1);\
function void _XrtDataStyleDownButton (Widget w,Int m) {
	s = w:value;
	n = atoi (String (s));
	if (n > m)
		_XrtDataStyleSetTextFieldIntValue (w,n - 1);
	free (String (s));\
}
                            }
                            resources {
                                arrowDirection = arrow_down
                                activateCallback = _XrtDataStyleDownButton (parent.lineWidth,Int (self:userData));
                                topAttachment = attach_form
                                bottomAttachment = attach_form
                                rightAttachment = attach_form
                                shadowThickness = 1
                            }
                        } lineWidthDown
                        widget XmArrowButton {
                            flag {
                                mapped
                                autosize
                                autopos
                                gadget
                            }
                            createproc {
                                SetValues (self,1,userData,1);\
function void _XrtDataStyleUpButton (Widget w,Int m) {
	s = w:value;
	n = atoi (String (s));
	if (n < m)
		_XrtDataStyleSetTextFieldIntValue (w,m);
	else
		_XrtDataStyleSetTextFieldIntValue (w,n + 1);
	free (String (s));\
}
                            }
                            resources {
                                arrowDirection = arrow_up
                                activateCallback = _XrtDataStyleUpButton (parent.lineWidth,Int (self:userData));
                                topAttachment = attach_form
                                bottomAttachment = attach_form
                                rightAttachment = attach_widget
                                rightWidget = parent.lineWidthDown
                                shadowThickness = 1
                            }
                        } lineWidthUp
