                widget XmArrowButton {
                    flag {
                        mapped
                        autopos
                    }
                    createproc {
                        function None _FmAttachArrowHelp(Int enter)
			{
				Widget label = XtNameToWidget(parent.parent.parent, "buttonLabel");
				if(!label)
					return();
				if(enter == 0){
					if(!self:userData){
						XmString b = XmStringCreateSimple(" ");
						label:labelString = b;
						XmStringFree(b);
					} else
						self:userData = Pointer(0);
					return();
				}
				else
				if(enter == 1)
					start = Internationalize("%MSG%150%994 Click then s");
				else {
					start = Internationalize("%MSG%150%995 S");
					self:userData = Pointer(1);
				}
				String buf = XtMalloc(256);
				if(strcmp(XtName(self), "change") == 0){
					sprintf(buf, Internationalize("%MSG%150%996 %select an arrow to change side"), start);
				} else {
					form = parent.parent;
					pos = Boolean(form.typeRC.position:set);
					off = !Boolean(form.offsetForm.defoffset:set);
					if(strcmp(XtName(self), "up") == 0)
						side = "top";
					else
					if(strcmp(XtName(self), "down") == 0)
						side = "bottom";
					else
					if(strcmp(XtName(self), "left") == 0)
						side = "left";
					else
					if(strcmp(XtName(self), "right") == 0)
						side = "right";
					if(pos)
						sprintf(buf, Internationalize("%MSG%150%997 Click to set %s attachment by position"), side);
					else {
						if(off)
							sprintf(buf, Internationalize("%MSG%150%998 %select a widget to set %s attachment with offset "), start, side);
						else
							sprintf(buf, Internationalize("%MSG%150%999 %select a widget to set %s attachment without offset "), start, side);
					}
				}
				XmString xms = XmStringCreateSimple(buf);
				label:labelString = xms;
				XmStringFree(xms);
				if(enter == 2)
					XmUpdateDisplay(self);
			}
			
			function None _FmInitAttachArrowHelp()
			{
				FmOverrideTranslations(self, '<Enter>: eval("script _fm_att_arr_e: _FmAttachArrowHelp(1);")\n<Leave>: eval("script _fm_att_arr_l: _FmAttachArrowHelp(0);")');
			}
			
			_FmInitAttachArrowHelp();
                    }
                    resources {
                        height = 29
                        width = 29
                        topAttachment = attach_form
                        leftAttachment = attach_widget
                        leftWidget = topleft
                        activateCallback = function void _FmResourceWindowAttachArrow (Int side,String title,String res) {
	form = parent.parent;
	posok = Boolean(form.typeRC.position:set);
	/*
	if(!posok)
		XmToggleButtonSetState(form.offsetForm.defoffset, False, True);
	 */
	if(!posok)
		_FmAttachArrowHelp(2);
	if (_FmResourceWindowAttach (toplevel,side,posok,0,Boolean(form.opposite:set),Boolean(form.offsetForm.defoffset:set))) {
		_FmResourceSetAttachments (parent.parent.parent,side,title);
		_FmResourceListSelectName (toplevel,res);
	} else {
		_FmEditNamedWindowResource(toplevel,res);
	} \
}\
_FmResourceWindowAttachArrow (wref_top,"top attachment","topAttachment");
                    }
                } up
