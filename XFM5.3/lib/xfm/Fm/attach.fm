                    activevalue {
                        name = _FmAttachArrow
                        set = _FmTextArrow (parent.offset,1,True,self,100);
                    }
                    createproc {
                        function void _FmTextArrow (Widget text,Int incr,Boolean neg,Widget arrow,Int delay) {
	if (incr) {
		s = text:value;
		n = atoi (s);
		free (s);
		n = n + incr;
		if (!neg && n < 0)
			n = 0;
		s = itoa (n);
		text:value = s;
		free (s);
	}
	type TimeOutClosure;
	if (delay)
		arrow:userData = Pointer (FmSetActiveValueTimeOut (arrow,"_FmAttachArrow",delay));
	else
		FmStopTimeOut(TimeOutClosure(arrow:userData));\
}
                    }
                    resources {
                        arrowDirection = arrow_up
                        topAttachment = attach_opposite_widget
                        topOffset = 1
                        topWidget = offset
                        leftAttachment = attach_widget
                        leftWidget = offset
                        sensitive = false
                        armCallback = _FmTextArrow (parent.offset,1,True,self,500);
                        disarmCallback = _FmTextArrow (parent.offset,0,True,self,0);
                    }
                } up
