    activevalue {
        name = _FmAttachPosition
        set = if (Boolean(self.typeRC.position:set)) {
	s = itoa (@);
	self.posForm.position:value = s;
	free (s);\
} else
	self.posForm.position:value = "";
    }
    activevalue {
        name = _FmAttachPositionReturn
        get = if (Boolean(self.typeRC.position:set)) {
	s = self.posForm.position:value;
	strcpy ($,s);
	free (s);\
} else
	_FmResourceDontSaveValue();
    }
    activevalue {
        name = _FmAttachWidget
        set = if (Boolean(self.typeRC.widget:set)) {
	list = self.widgetForm.scroller.list;
	xms = CreateXmString ($);
	if (XmListItemExists (list,xms))
		XmListSelectItem (list,xms,False);
	XmStringFree (xms);
	if(strncmp($, "parent.", 7) == 0){
		String name = XtNewString($);
		sscanf($, "parent.%s", name);
		self.widgetForm.widget:value = name;
		XtFree(name);
	} else {
		self.widgetForm.widget:value = $;\
	}\
} else {
	self.widgetForm.widget:value = "";\
}
    }
    activevalue {
        name = _FmAttachWidgetReturn
        get = if (Boolean(self.typeRC.widget:set)) {
	s = self.widgetForm.widget:value;
	_FmCheckResourceWindowReference (toplevel,s);
	strcpy ($,s);
	free (s);\
} else
	_FmResourceDontSaveValue();
    }
    activevalue {
        name = _FmResourceEditManage
        set = local Boolean already;\
if (!already) {
	already = True;
	w = self.arrowForm;
	hide (w.up); show (w.up);
	w = self.posForm;
	hide (w.position); show (w.position);
	w = self.offsetForm;
	hide (w.offset); show (w.offset);\
}\
if      ((Boolean)(self.typeRC.form:set))\
	XmProcessTraversal(self.typeRC.form,     XmTRAVERSE_CURRENT);\
else if ((Boolean)(self.typeRC.widget:set))\
	XmProcessTraversal(self.typeRC.widget,   XmTRAVERSE_CURRENT);\
else if ((Boolean)(self.typeRC.none:set))\
	XmProcessTraversal(self.typeRC.none,     XmTRAVERSE_CURRENT);\
else if ((Boolean)(self.typeRC.position:set))\
	XmProcessTraversal(self.typeRC.position, XmTRAVERSE_CURRENT);\
else if ((Boolean)(self.typeRC.myself:set))\
	XmProcessTraversal(self.typeRC.myself,   XmTRAVERSE_CURRENT);\
SetSysAv("DrawAttachments");\
SetSysAv("AssignOffsets");

    }
    activevalue {
        name = _FmUpdateAttachOffsets
        set =
		if (Boolean(self.typeRC.position:set)) {
			s = self.posForm.position:value;
			pos = atoi (s);
			free (s);
		} else if(Boolean(self.offsetForm.defoffset:set)){
			return();
		} else {
			pos = 0;
		}
		if (Boolean(self.typeRC.widget:set)) {
			s = self.widgetForm.widget:value;
		} else
			s = String (0);
		n = _FmResourceWindowOffset (toplevel,s,Int(self.typeRC:userData),
						Boolean(self.typeRC.position:set),
						pos,Boolean(self.opposite:set),
						False);
		if(Boolean(self.typeRC.position:set))
			text = self.posForm.position;
		else
			text = self.offsetForm.offset;
		s = itoa (n);
		olds = text:value;
		if(!equal(s, olds))
			text:value = s;
		free(s);
		free(olds);
    }
    createproc {
        w = self.typeLabel:width;\
n = self.offsetForm.offsetLabel:width;\
if (w < n)
	w = n;\
n = self.posForm.posLabel:width;\
if (w < n)
	w = n;\
n = self.widgetForm.widgetLabel:width;\
if (w < n)
	w = n;\
self.typeLabel:width = w;\
self.offsetForm.offsetLabel:width = w;\
self.posForm.posLabel:width = w;\
self.widgetForm.widgetLabel:width = w;
    }
