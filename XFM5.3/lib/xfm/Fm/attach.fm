widget XmForm {
    flag {
        mapped
        autosize
        autopos
    }
    activevalue {
        name = _FmResourceReturnValue
        get = _FmGetResourceAttachAvs (toplevel,self,Int (self.typeRC:userData));\
_FmResourceDontSaveValue();
    }
    activevalue {
        name = _FmResourceName
        set = /* -C- */\
        function None _FmResourceSetAttachments (Widget w, Int side, String title) {\
		@_FmResourceName = title;\
		FmSetActiveValue (w,"_FmResourceName");\
		att = w.attach;\
		att.typeRC:userData = Pointer(side);\
		att.widgetForm:userData = Pointer(False);\
		XmListDeleteAllItems (att.widgetForm.scroller.list);\
		_FmSetResourceAttachAvs (toplevel, att, side);\
        }\
	function None _FmResourceInitOffset(String off) {
		String value = _FmGetNamedWindowResource(toplevel, off, False);\
		if(value){\
			offsetForm.defoffset:set = Set(False);\
			_FmResourceTextEdit (offsetForm.offset,True);\
			self.offsetForm.up:sensitive = True;\
			self.offsetForm.down:sensitive = True;\
		} else {\
			offsetForm.defoffset:set = Set(True);\
			offsetForm.offset:value = "";\
			_FmResourceTextEdit (offsetForm.offset,False);\
			self.offsetForm.up:sensitive = False;\
			self.offsetForm.down:sensitive = False;\
		}\
	}\
if (strncmp (@,"left",4) == 0){\
	_FmResourceInitOffset("leftOffset");\
	_FmResourceSetAttachments (parent,wref_left,"left attachment");\
} else if (strncmp (@,"right",5) == 0){\
	_FmResourceInitOffset("rightOffset");\
	_FmResourceSetAttachments (parent,wref_right,"right attachment");\
} else if (strncmp (@,"top",3) == 0){\
	_FmResourceInitOffset("topOffset");\
	_FmResourceSetAttachments (parent,wref_top,"top attachment");\
} else if (strncmp (@,"bottom",6) == 0){\
	_FmResourceInitOffset("bottomOffset");\
	_FmResourceSetAttachments (parent,wref_bottom,"bottom attachment");\
}\
    }
    activevalue {
        name = _FmAttachment
        set = if (@ == XmATTACH_FORM || @ == XmATTACH_OPPOSITE_FORM) {
	XmToggleButtonGadgetSetState (self.typeRC.form,True,True);
	XmToggleButtonGadgetSetState (self.opposite,@ == XmATTACH_OPPOSITE_FORM,True);\
} else if (@ == XmATTACH_SELF) {
	XmToggleButtonGadgetSetState (self.typeRC.myself,True,True);
	XmToggleButtonGadgetSetState (self.opposite,False,True);\
} else if (@ == XmATTACH_NONE) {
	XmToggleButtonGadgetSetState (self.typeRC.none,True,True);
	XmToggleButtonGadgetSetState (self.opposite,False,True);\
} else if (@ == XmATTACH_POSITION) {
	XmToggleButtonGadgetSetState (self.typeRC.position,True,True);
	XmToggleButtonGadgetSetState (self.opposite,False,True);\
} else if (@ == XmATTACH_WIDGET || @ == XmATTACH_OPPOSITE_WIDGET) {
	XmToggleButtonGadgetSetState (self.typeRC.widget,True,True);
	XmToggleButtonGadgetSetState (self.opposite,@ == XmATTACH_OPPOSITE_WIDGET,True);\
} else printf ("attachment = %d?\n",@);
    }
    activevalue {
        name = _FmAttachmentReturn
        get = if (Boolean(self.typeRC.form:set)) {
	if (Boolean(self.opposite:set))
		strcpy ($,"attach_opposite_form");
	else
		strcpy ($,"attach_form");\
} else if (Boolean(self.typeRC.myself:set))
	strcpy ($,"attach_self");\
else if (Boolean(self.typeRC.none:set))
	strcpy ($,"attach_none");\
else if (Boolean(self.typeRC.position:set))
	strcpy ($,"attach_position");\
else if (Boolean(self.typeRC.widget:set)) {
	if (Boolean(self.opposite:set))
		strcpy ($,"attach_opposite_widget");
	else
		strcpy ($,"attach_widget");\
} else
	_FmResourceDontSaveValue();
    }
    activevalue {
        name = _FmAttachOffset
        set = 
	if(!Boolean(offsetForm.defoffset:set)){
		s = itoa (@);
		self.offsetForm.offset:value = s;
		free (s);
	} else {
		self.offsetForm.offset:value = "";
	}
    }
    activevalue {
        name = _FmAttachOffsetReturn
        get = a = Boolean(self.offsetForm.defoffset:set);\
if (!a) {
	s = self.offsetForm.offset:value;
	strcpy ($,s);
	free (s);\
} /*else if (Boolean(self.typeRC.position:set) || Boolean(self.typeRC.widget:set) || Boolean(self.typeRC.form:set)) {
	if (Boolean(self.typeRC.position:set)) {
