                        rightAttachment = attach_widget
                        rightWidget = right
                        activateCallback =
	_FmAttachArrowHelp(2);
	Widget arrow = InterfTrackWidget("fleur");
	if(arrow == parent.left)
		_FmEditNamedWindowResource(toplevel, "leftAttachment");
	else
	if(arrow == parent.right)
		_FmEditNamedWindowResource(toplevel, "rightAttachment");
	else
	if(arrow == parent.up)
		_FmEditNamedWindowResource(toplevel, "topAttachment");
	else
	if(arrow == parent.down)
		_FmEditNamedWindowResource(toplevel, "bottomAttachment");
                    }
