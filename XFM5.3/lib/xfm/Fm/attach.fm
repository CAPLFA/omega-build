                        autopos
                        gadget
                    }
                    resources {
                        labelString = %MSG%150%1009 Position:
                        alignment = alignment_beginning
                        marginHeight = 0
                        marginWidth = 0
                        topAttachment = attach_form
                        topOffset = 5
                        leftAttachment = attach_form
                    }
                } posLabel
                widget XmTextField {
                    flag {
                        mapped
                        autosize
                        autopos
                    }
                    resources {
                        columns = 5
                        marginHeight = 1
                        marginWidth = 1
                        topAttachment = attach_opposite_widget
                        topOffset = -5
                        topWidget = posLabel
                        leftAttachment = attach_widget
                        leftOffset = 5
                        leftWidget = posLabel
                    }
                } position
                widget XmArrowButton {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    activevalue {
                        name = _FmAttachArrow
                        set = _FmTextArrow (parent.position,1,False,self,100);
                    }
                    resources {
                        arrowDirection = arrow_up
                        topAttachment = attach_opposite_widget
                        topOffset = 1
                        topWidget = position
                        leftAttachment = attach_widget
                        leftWidget = position
                        armCallback = _FmTextArrow (parent.position,1,False,self,500);
                        disarmCallback = _FmTextArrow (parent.position,0,False,self,0);
                    }
                } up
                widget XmArrowButton {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    activevalue {
                        name = _FmAttachArrow
                        set = _FmTextArrow (parent.position,-1,False,self,100);
                    }
                    resources {
                        arrowDirection = arrow_down
                        topAttachment = attach_opposite_widget
                        topOffset = 1
                        topWidget = position
                        leftAttachment = attach_widget
                        leftWidget = up
                        armCallback = _FmTextArrow (parent.position,-1,False,self,500);
                        disarmCallback = _FmTextArrow (parent.position,0,False,self,0);
                    }
                } down
            }
        } posForm
        widget XmForm {
            flag {
                mapped
                autosize
                autopos
            }
            resources {
                topAttachment = attach_widget
                topWidget = posForm
                leftAttachment = attach_opposite_widget
                leftWidget = typeLabel
                rightAttachment = attach_form
                bottomAttachment = attach_form
            }
            children {
                widget XmLabel {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        labelString = %MSG%150%1010 Widget:
                        alignment = alignment_beginning
                        marginHeight = 0
                        marginWidth = 0
                        topAttachment = attach_form
                        topOffset = 5
                        leftAttachment = attach_form
                    }
                } widgetLabel
                widget XmPushButton {
                    flag {
                        mapped
                        autosize
                        autopos
                        gadget
                    }
                    resources {
                        labelString = %MSG%150%1011 Select
                        marginHeight = 1
                        marginWidth = 3
                        topAttachment = attach_opposite_widget
                        topOffset = -5
                        topWidget = widgetLabel
                        leftAttachment = attach_none
                        rightAttachment = attach_form
                        activateCallback = s = _FmResourceWindowAttachWidget (toplevel);\
if(s){
	parent.widget:value = s;\
	XtCallCallbacks(parent.widget, "activateCallback", 0);\
}
                    }
                } select
                widget XmTextField {
                    flag {
                        mapped
                        autosize
                        autopos
                    }
                    resources {
                        marginHeight = 1
                        marginWidth = 3
                        topAttachment = attach_opposite_widget
                        topOffset = -5
                        topWidget = widgetLabel
                        leftAttachment = attach_widget
                        leftOffset = 5
                        leftWidget = widgetLabel
                        rightAttachment = attach_widget
                        rightOffset = 2
                        rightWidget = select
                        activateCallback =
	FmSetActiveValue(parent.parent, "_FmUpdateAttachOffsets");
                    }
                } widget
                widget XmScrolledWindow {
                    flag {
                        mapped
                        autosize
                        autopos
                    }
                    resources {
                        topAttachment = attach_widget
                        topOffset = 2
                        topWidget = widget
                        leftAttachment = attach_opposite_widget
                        leftOffset = 2
                        leftWidget = widget
                        rightAttachment = attach_form
                        bottomAttachment = attach_form
                    }
                    children {
                        widget XmList {
                            flag {
                                mapped
                                autosize
                                autopos
                            }
                            resources {
                                selectionPolicy = browse_select
                                browseSelectionCallback = XmListCallback cb;\
cb = $;\
if (cb->item_position > 0) {
	s = GetString (cb->item);
	parent.parent.widget:value = s;
	XtCallCallbacks(parent.parent.widget, "activateCallback", 0);\
	free (s);\
} else {\
	parent.parent.widget:value = "";\
	XtCallCallbacks(parent.parent.widget, "activateCallback", 0);\
}
                            }
                        } list
                    }
                } scroller
            }
        } widgetForm
        widget XmToggleButton {
            flag {
                mapped
                autopos
                autosize
            }
            activevalue {
                name = AssignOffsets
                get = @ = Boolean(self:set);
                set = self:set = Set(@);
            }
            resources {
                leftAttachment = attach_form
                labelString = %MSG%150%1012 Update Offsets
                bottomAttachment = attach_position
                bottomPosition = 70
                alignment = alignment_beginning
                valueChangedCallback =
	UpdateWidgetAv(self);
	SetSysAv("AssignOffsets");
                translations = #override
	<MapNotify>: eval("script _fm_raise_attach_button: FmRaiseWidget(self);")
            }
        } setoffsets
        widget XmToggleButton {
            flag {
                mapped
                autopos
                autosize
            }
            activevalue {
                name = DrawAttachments
                get = @ = Boolean(self:set);
                set = self:set = Set(@);
            }
            resources {
                leftAttachment = attach_form
                labelString = %MSG%150%1013 Draw Attachments
                bottomAttachment = attach_position
                bottomPosition = 80
                alignment = alignment_beginning
                valueChangedCallback = UpdateWidgetAv(self);\
			SetSysAv("DrawAttachments");\
			ClearForms();
                translations = #override
	<MapNotify>: eval("script _fm_raise_attach_button: FmRaiseWidget(self);")
            }
        } drawattach
        widget XmPushButton {
            flag {
                mapped
                autopos
            }
            resources {
                width = 150
                leftAttachment = attach_form
                labelString = %MSG%150%1014 Detach This Side
                bottomAttachment = attach_position
                bottomPosition = 90
                activateCallback = 
			function None _FmResetAttWin(Int side)
			{
				if(side == wref_left)
					res = "leftAttachment";
				else
				if(side == wref_right)
					res = "rightAttachment";
				else
				if(side == wref_top)
					res = "topAttachment";
				else
				if(side == wref_bottom)
					res = "bottomAttachment";
				else
					res = "leftAttachment";
				_FmEditNamedWindowResource(toplevel, res);
			}
			Int side = Int(parent.typeRC:userData);
			_FmDetachResourceWindowObject(toplevel, side);
			_FmResetAttWin(side);
                translations = #override
	<MapNotify>: eval("script _fm_raise_attach_button: FmRaiseWidget(self);")
            }
        } detachone
        widget XmPushButton {
            flag {
                mapped
                autopos
            }
            resources {
                width = 150
                leftAttachment = attach_form
                labelString = %MSG%150%1015 Detach All Sides
                bottomAttachment = attach_position
                bottomPosition = 100
                activateCallback = 
			Int side = Int(parent.typeRC:userData);
			_FmDetachResourceWindowObject(toplevel, wref_all);
			_FmResetAttWin(side);
                translations = #override
	<MapNotify>: eval("script _fm_raise_attach_button: FmRaiseWidget(self);")
            }
        } detachall
    }
} attach
