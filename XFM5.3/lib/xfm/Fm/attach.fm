                        spacing = 2
                        disarmCallback = XmToggleButtonGadgetSetState (self, True, True);
                        valueChangedCallback = function void _FmAttachType (Boolean opp,Boolean pos,Boolean wid) {
	o = parent.parent.opposite;
	if (o:sensitive != opp)
		XtSetSensitive (parent.parent.opposite,opp);
	p = parent.parent.posForm;
	if (p:sensitive != pos) {
		hide (p.up);		/* hide and show arrows */
		hide (p.down);		/* because of Xm bug */
		if(pos)
			parent.parent.offsetForm.offset:value = "";
		else
			p.position:value = "";
		XtSetSensitive (p,pos);
		show (p.up);
		show (p.down);
	}
	w = parent.parent.widgetForm;
	if (w:sensitive != wid) {
		XtSetSensitive (w,wid);
		if (wid && !Boolean (w:userData)) {
			w:userData = Pointer (True);
			set = _FmListFill (w.scroller.list,_FmGetResourceWindowSiblings (toplevel));
		}
	}\
	/* update offset and position value */
	FmSetActiveValue(parent.parent, "_FmUpdateAttachOffsets");\
}\
if (Boolean(self:set))
	_FmAttachType (True,False,False);
                    }
