widget XmDialogShell {
    flag {
        popup
    }
    resources {
        x = 816
        y = 78
        width = 179
        height = 99
        allowShellResize = true
    }
    children {
        widget XmMessageBox {
            flag {
                mapped
            }
            createproc {
                UnmanageChild (MessageBoxGetChild (self,XmDIALOG_HELP_BUTTON));
            }
            resources {
                x = 0
                y = 0
                width = 179
                height = 99
                messageString = Warning Here !
                textFontList = *helvetica-bold-r-*-12-*
                dialogType = dialog_warning
                dialogStyle = dialog_system_modal
            }
        } WarningDialog
    }
} MyWarningDialog
