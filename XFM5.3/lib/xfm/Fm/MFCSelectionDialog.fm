widget XmBulletinBoard {
    flag {
        mapped
    }
    activevalue {
        name = MFC_W
        get = script get_MFCSelectionDialog_MFC_W:
		FacePragma("ignore");
		@ = atoi(_FmGetWidgetResourceValue(self.form, "width"));
        type = Int
        storage = object
        automatic = true
        autoget = true
        genvalue = true
        default_type = String
        default_value = 298
    }
    activevalue {
        name = MFC_H
        get = script get_MFCSelectionDialog_MFC_H:
		FacePragma("ignore");
		@ = atoi(_FmGetWidgetResourceValue(self.form, "height"));
        type = Int
        storage = object
        automatic = true
        autoget = true
        genvalue = true
        default_type = String
        default_value = 286
    }
    activevalue {
        name = MFC_R_okCallback
        get = script get_MFCSelectionDialog_MFC_R_okCallback:
		FacePragma("ignore");
		if(_FmHasCallback(self, "okCallback")){
			@ = "okCallback";
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = MFC_R_applyCallback
        get = script get_MFCSelectionDialog_MFC_R_applyCallback:
		FacePragma("ignore");
		if(_FmHasCallback(self, "applyCallback")){
			@ = "applyCallback";
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = MFC_R_cancelCallback
        get = script get_MFCSelectionDialog_MFC_R_cancelCallback:
		FacePragma("ignore");
		if(_FmHasCallback(self, "cancelCallback")){
			@ = "cancelCallback";
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = MFC_R_helpCallback
        get = script get_MFCSelectionDialog_MFC_R_helpCallback:
		FacePragma("ignore");
		if(_FmHasCallback(self, "helpCallback")){
			@ = "helpCallback";
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = textString
        get = @ = FmCreateXmString(self.form.text:value);
        set = self.form.text:value = FmGetString(@);
        type = XmString
        storage = object
        automatic = true
        usage = face
    }
    activevalue {
        name = okLabelString
        get = @ = self.form.ok:labelString;
        set = self.form.ok:labelString = @;
