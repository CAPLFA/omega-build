                        topOffset = 15
                        activateCallback = String s = parent.text:value;\
XmString xms = XmStringCreateSimple(s);\
\
XmSelectionBoxCallback cbs = new_struct(XmSelectionBoxCallback);\
cbs->reason = XmCR_HELP;\
cbs->event = Any(0);\
cbs->value = xms;\
cbs->length = strlen(s);\
\
XtCallCallbacks(parent.parent, "helpCallback", Pointer(cbs));\
\
XtFree(s);\
XmStringFree(xms);\
XtFree(String(cbs));
                    }
                } help
            }
        } form
    }
} selection
