                horizontalSpacing = 10
                verticalSpacing = 10
                x = 10
                y = 10
            }
            children {
                widget XmPushButton {
                    flag {
                        mapped
                    }
                    activevalue {
                        name = MFC_W
                        get = script get_MFCSelectionDialog_OK_MFC_W:
				FacePragma("ignore");
				Widget w = XmSelectionBoxGetChild(parent.parent, XmDIALOG_OK_BUTTON);
				Int margin = 2*w:defaultButtonShadowThickness + w:shadowThickness + 2;
				Int width = w:width;
				if (width < 70)
					width = 70;
				@ = width - 2 * margin;
                        type = Int
                        storage = object
                        automatic = true
                        autoget = true
                        genvalue = true
                    }
                    createproc {
                        FacePragma("ignore");
			
			parent.parent:defaultButton = self;
			
			XmString xmstr = parent.parent:okLabelString;
			String s = FmGetString(xmstr);
			if(strcmp(s, "OK") != 0)
				self:labelString = xmstr;
			XmStringFree(xmstr);
			XtFree(s);
                    }
                    templates {
                        MFCPushButton = -Fm/MFCPushButton.fm
                    }
                    resources {
                        x = 313
                        y = 10
                        width = 70
                        height = 40
                        labelString = OK
                        topAttachment = attach_form
                        rightAttachment = attach_form
                        defaultButtonShadowThickness = 1
                        activateCallback = String s = parent.text:value;\
XmString xms = XmStringCreateSimple(s);\
\
XmSelectionBoxCallback cbs = new_struct(XmSelectionBoxCallback);\
cbs->reason = XmCR_OK;\
cbs->event = Any(0);\
cbs->value = xms;\
cbs->length = strlen(s);\
\
XtCallCallbacks(parent.parent, "okCallback", Pointer(cbs));\
\
XtFree(s);\
XmStringFree(xms);\
XtFree(String(cbs));
                    }
                } ok
