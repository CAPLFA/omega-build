        get = @ = self.form.cancel:labelString;
        set = self.form.cancel:labelString = @;
        type = XmString
        storage = object
        automatic = true
        usage = face
    }
    activevalue {
        name = helpLabelString
        get = @ = self.form.help:labelString;
        set = self.form.help:labelString = @;
        type = XmString
        storage = object
        automatic = true
        usage = face
    }
    activevalue {
        name = selectionLabelString
        get = @ = self.form.label:labelString;
        set = self.form.label:labelString = @;
        type = XmString
        storage = object
        automatic = true
        usage = face
    }
    activevalue {
        name = listLabelString
        get = @ = self.form.listlabel:labelString;
        set = self.form.listlabel:labelString = @;
        type = XmString
        storage = object
        automatic = true
        usage = face
    }
    activevalue {
        name = listItemCount
        get = @ = self.form.scroll.list:itemCount;
        set = self.form.scroll.list:itemCount = @;
        type = Int
        storage = object
        automatic = true
        usage = face
    }
    activevalue {
        name = listItems
        get = @ = self.form.scroll.list:items;
        set = self.form.scroll.list:items = @;
        type = XmStringTable
        storage = object
        automatic = true
        usage = face
    }
    activevalue {
        name = dialogType
        set = 
		if(@ == XmDIALOG_PROMPT){
			XtUnmanageChild(form.scroll);
			XtUnmanageChild(form.listlabel);
			XtManageChild(form.ok);
			XtManageChild(form.apply);
			XtManageChild(form.cancel);
			XtManageChild(form.help);
		}
		else
		if(@ == XmDIALOG_COMMAND){
			XtManageChild(form.scroll);
			XtUnmanageChild(form.listlabel);
			XtUnmanageChild(form.ok);
			XtUnmanageChild(form.apply);
			XtUnmanageChild(form.cancel);
			XtUnmanageChild(form.help);
		}
		else
		if(@ == XmDIALOG_SELECTION
		|| @ == XmDIALOG_FILE_SELECTION){
			XtManageChild(form.scroll);
			XtManageChild(form.listlabel);
			XtManageChild(form.ok);
			XtManageChild(form.apply);
			XtManageChild(form.cancel);
			XtManageChild(form.help);
		}
		else
		if(@ == XmDIALOG_WORK_AREA){
			XtManageChild(form.scroll);
			XtManageChild(form.listlabel);
			XtManageChild(form.ok);
			XtUnmanageChild(form.apply);
			XtManageChild(form.cancel);
			XtManageChild(form.help);
		}
        type = Int
        storage = object
        automatic = true
        usage = face
    }
    activevalue {
        name = MFC_PR_dialogType
        get = script get_MFCSelectionDialog_MFC_PR_dialogType:
		FacePragma("ignore");
		dialog_type = self:dialogType;
		if(dialog_type == XmDIALOG_PROMPT)
			@ = "XmDIALOG_PROMPT";
		else
		if(dialog_type == XmDIALOG_COMMAND)
			@ = "XmDIALOG_COMMAND";
		else
		if(dialog_type == XmDIALOG_SELECTION)
			@ = "XmDIALOG_SELECTION";
		else
		if(dialog_type == XmDIALOG_FILE_SELECTION)
			@ = "XmDIALOG_FILE_SELECTION";
		else
		if(dialog_type == XmDIALOG_WORK_AREA)
			@ = "XmDIALOG_WORK_AREA";
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = xfmWorkArea
        type = Widget
        storage = object
        automatic = true
        usage = face
    }
    activevalue {
        name = GetChild
        set = 
		struct GetChildArgs {
			Widget ret;
			Int id;
		};
		GetChildArgs a = @;
		if(a->id == XmDIALOG_LIST)
			a->ret = self.form.scroll.list;
		else
		if(a->id == XmDIALOG_OK_BUTTON)
			a->ret = self.form.ok;
		else
		if(a->id == XmDIALOG_APPLY_BUTTON)
			a->ret = self.form.apply;
		else
		if(a->id == XmDIALOG_CANCEL_BUTTON)
			a->ret = self.form.cancel;
		else
		if(a->id == XmDIALOG_HELP_BUTTON)
			a->ret = self.form.help;
		else
		if(a->id == XmDIALOG_DEFAULT_BUTTON)
			a->ret = self:defaultButton;
		else
		if(a->id == XmDIALOG_SELECTION_LABEL)
			a->ret = self.form.label;
		else
		if(a->id == XmDIALOG_LIST_LABEL)
			a->ret = self.form.listlabel;
		else
		if(a->id == XmDIALOG_TEXT)
			a->ret = self.form.text;
		else
		if(a->id == XmDIALOG_WORK_AREA)
			a->ret = self:@xfmWorkArea;
		else
			a->ret = Widget(0);
        type = GetChildArgs
        storage = none
        automatic = true
        usage = face
    }
    templates {
        MFCCommon = -Fm/MFCCommon.fm
    }
    resources {
        x = 0
        y = 0
        width = 396
        height = 434
    }
    children {
        widget XmForm {
            flag {
                mapped
            }
            activevalue {
                name = MFC_A_topAttachment
                type = String
                storage = object
                automatic = true
                genvalue = true
                default_type = String
                default_value = XmATTACH_FORM
            }
            activevalue {
                name = MFC_A_bottomAttachment
                type = String
                storage = object
                automatic = true
                genvalue = true
                default_type = String
                default_value = XmATTACH_FORM
            }
            activevalue {
                name = MFC_A_leftAttachment
                type = String
                storage = object
                automatic = true
                genvalue = true
                default_type = String
                default_value = XmATTACH_FORM
            }
            activevalue {
                name = MFC_A_rightAttachment
                type = String
                storage = object
                automatic = true
                genvalue = true
                default_type = String
                default_value = XmATTACH_FORM
            }
            activevalue {
                name = MFC_N_WM_SHOWWINDOW
                get = script get_MFCSelectionDialog_MFC_N_WM_SHOWWINDOW:
			FacePragma("ignore");
			@ = _FmConcatString(@, "#void ::OnShowWindow(BOOL show, UINT status)#show == TRUE?$FmWDoLayout(%self);$none", "|");
                type = String
                storage = object
                automatic = true
                autoget = true
                genvalue = true
            }
            activevalue {
                name = xfmGeometryManager
                set = 
			struct XfmSelectionDialogGeometryManagerArgs {
				int stop;
			};
			XfmSelectionDialogGeometryManagerArgs a = @;
			a->stop = 0;
			Widget managed[Int] = new_array();
			Int m = 0;
			if(XtIsManaged(self.ok)){
				managed[m] = self.ok; m = m+1;
			}
			Int max_btn_width = self.ok:width;
			Int n = parent:numChildren;
			Widget wa = Widget(0);
			if(n > 1){
				Widget children[Int] = new_c_array(Pointer(parent:children), n);
				for(i = 0; i < n; i = i+1){
					Widget w = children[i];
					if(w != self){
						if(i == 0){
							wa = w;
							parent:@xfmWorkArea = wa;
						}
						else
						if(XtIsManaged(w)){
							managed[m] = w; m = m+1;
						}
					}
				}
				destroy(children);
			}
			if(XtIsManaged(self.apply)){
				managed[m] = self.apply; m = m+1;
				if (max_btn_width < self.apply:width)
					max_btn_width = self.apply:width;
			}
			if(XtIsManaged(self.cancel)){
				managed[m] = self.cancel; m = m+1;
				if (max_btn_width < self.cancel:width)
					max_btn_width = self.cancel:width;
			}
			if(XtIsManaged(self.help)){
				managed[m] = self.help; m = m+1;
				if (max_btn_width < self.help:width)
					max_btn_width = self.help:width;
			}
			if(XtIsManaged(self.listlabel))
				scroll:topWidget = self.listlabel;
			else
				scroll:topWidget = self.text;
			if(wa && XtIsManaged(wa)){
				wa:bottomAttachment = XmATTACH_FORM;
				wa:bottomOffset = 10;
				wa:leftAttachment = XmATTACH_FORM;
				wa:leftOffset = 10;
				wa:rightAttachment = XmATTACH_FORM;
				if(m > 0){
					wa:rightOffset = max_btn_width + 20;
				} else {
					wa:rightOffset = 10;
				}
				scroll:bottomOffset = wa:height + 20;
			} else {
				scroll:bottomOffset = 10;
			}
			if(m == 0){
				label:rightAttachment = XmATTACH_FORM;
				label:rightOffset = 10;
				text:rightAttachment = XmATTACH_FORM;
				text:rightOffset = 10;
				listlabel:rightAttachment = XmATTACH_FORM;
				listlabel:rightOffset = 10;
				scroll:rightAttachment = XmATTACH_FORM;
				scroll:rightOffset = 10;
			} else {
				ok:width = max_btn_width;
				label:rightAttachment = XmATTACH_WIDGET;
				label:rightWidget = self.ok;
				label:rightOffset = 10;
				text:rightAttachment = XmATTACH_WIDGET;
				text:rightWidget = self.ok;
				text:rightOffset = 10;
				listlabel:rightAttachment = XmATTACH_WIDGET;
				listlabel:rightWidget = self.ok;
				listlabel:rightOffset = 10;
				scroll:rightAttachment = XmATTACH_WIDGET;
				scroll:rightWidget = self.ok;
				scroll:rightOffset = 10;
				
				Int width = max_btn_width;
				Int height = ok:height;
				
				for(i = 0; i < m; i = i+1){
					Widget w = managed[i];
					w:width = width;
					w:height = height;
					w:rightAttachment = XmATTACH_FORM;
					w:rightOffset = 10;
					w:topAttachment = XmATTACH_FORM;
					if(w == self.help)
						w:topOffset = 15 + i*(height+5);
					else
						w:topOffset = 5 + i*(height+5);
				}
			}
			destroy(managed);
                storage = none
                automatic = true
                usage = face
            }
            templates {
                MFCCommon = -Fm/MFCCommon.fm
            }
            resources {
                width = 365
