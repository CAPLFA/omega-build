    activevalue {
        name = MFC_R_xrtDoubleBuffer
        get = script get_MFCChart2D_MFC_R_xrtDoubleBuffer:
		FacePragma("ignore");
		function None _FmWinXrtGetBoolean(String name)
		{
			String s = _FmGetNonDefaultResourceValue(self, name);
			if(s){
				if(strcmp(s, "true") == 0
				|| strcmp(s, "True") == 0
				|| strcmp(s, "TRUE") == 0)
					@ = "TRUE";
				else
					@ = "FALSE";
				XtFree(s);
			}
		}
		_FmWinXrtGetBoolean("xrtDoubleBuffer");
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
