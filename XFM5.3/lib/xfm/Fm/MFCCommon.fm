    activevalue {
        name = MFC_A_topAttachment
        get = script get_MFCCommon_MFC_A_topAttachment:
		FacePragma("ignore");
		if(!_FmIsOfSubClass(parent, "XmForm")
		|| _FmIsOfSubClass(XtParent(self), "XmMenuShell")){
			return();
		}
		a = self:topAttachment;
		if(a == XmATTACH_NONE)
			return();
		else
		if(a == XmATTACH_FORM)
			@ = "XmATTACH_FORM";
		else
		if(a == XmATTACH_OPPOSITE_FORM)
			@ = "XmATTACH_OPPOSITE_FORM";
		else
		if(a == XmATTACH_WIDGET)
			@ = "XmATTACH_WIDGET";
		else
		if(a == XmATTACH_OPPOSITE_WIDGET)
			@ = "XmATTACH_OPPOSITE_WIDGET";
		else
		if(a == XmATTACH_POSITION)
			@ = "XmATTACH_POSITION";
		else
		if(a == XmATTACH_SELF)
			@ = "XmATTACH_SELF";
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
