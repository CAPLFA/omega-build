    activevalue {
        name = MFC_TRANSLATIONS
        get = script get_MFCCommon_MFC_TRANSLATIONS:
		FacePragma("ignore");
		function String _FmWinTranslation(String ev1, String ev2, String ev2detail, String msg, Int augment)
		{
			String value = String(0);
			String modifiers = XtMalloc(20);
			String detail = XtMalloc(10);
			Int lasti = -1;
			Int break = 0;
			while(!break){
				Int i = _FmHasEvalAction(self, lasti, ev1, modifiers, detail);
				if(i < 0 && ev2){
					i = _FmHasEvalAction(self, lasti, ev2, modifiers, detail);
					if(i >= 0 && strcmp(detail, ev2detail) != 0)
						i = -1;
				}
				if(i >= 0){
					String buf = XtMalloc(200);
					sprintf(buf, '%s,"%s","%s",Action_%d,%d', msg, modifiers, detail, i, augment);
					@ = _FmConcatString(@, buf, "|");
					XtFree(buf);
					lasti = i;
				} else {
					break = 1;
				}
			}
			XtFree(modifiers);
			XtFree(detail);
			return(value);
		}
		String t = _FmGetNonDefaultResourceValue(self, "translations");
		if(t){
			if(strncmp(t, "#augment", 8) == 0)
				augment = 1;
			else
				augment = 0;
			_FmWinTranslation("<Btn1Down>", "<ButtonPress>", "Button1", WM_LBUTTONDOWN, augment);
			_FmWinTranslation("<Btn2Down>", "<ButtonPress>", "Button2", WM_MBUTTONDOWN, augment);
			_FmWinTranslation("<Btn3Down>", "<ButtonPress>", "Button3", WM_RBUTTONDOWN, augment);
			_FmWinTranslation("<Btn1Up>", "<ButtonRelease>", "Button1", WM_LBUTTONUP, augment);
			_FmWinTranslation("<Btn2Up>", "<ButtonRelease>", "Button2", WM_MBUTTONUP, augment);
			_FmWinTranslation("<Btn3Up>", "<ButtonRelease>", "Button3", WM_RBUTTONUP, augment);
			_FmWinTranslation("<MotionNotify>", String(0), String(0), WM_MOUSEMOVE, augment);
			_FmWinTranslation("<Btn1Motion>", "<MotionNotify>", "Button1", WM_MOUSEMOVE, augment);
			_FmWinTranslation("<Btn2Motion>", "<MotionNotify>", "Button2", WM_MOUSEMOVE, augment);
			_FmWinTranslation("<Btn3Motion>", "<MotionNotify>", "Button3", WM_MOUSEMOVE, augment);
			_FmWinTranslation("<KeyPress>", String(0), String(0), WM_KEYDOWN, augment);
			_FmWinTranslation("<KeyRelease>", String(0), String(0), WM_KEYUP, augment);
			
			_FmWinTranslation("<ConfigureNotify>", String(0), String(0), WM_MOVE, augment);
			_FmWinTranslation("<ConfigureNotify>", String(0), String(0), WM_SIZE, augment);
			
			XtFree(t);
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = MFC_ON_DESTROY
        get = script get_MFCCommon_MFC_ON_DESTROY:
		FacePragma("ignore");
		if(_FmHasCallback(self, "destroyCallback")){
			@ = "#void ::PostNcDestroy()#destroyCallback";
		}
        type = String
