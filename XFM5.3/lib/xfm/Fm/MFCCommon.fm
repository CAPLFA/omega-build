		FacePragma("ignore");
		if(_FmIsOfSubClass(self, "Shell"))
			return();
		String colorname = _FmGetNonDefaultResourceValue(self, "foreground");
		if(colorname && strcmp(colorname, "")){
			@ = _FmWinQuoteString(colorname);
			if(_FmIsOfSubClass(parent, "Shell")){
				parent:@MFC_R_foreground = _FmWinQuoteString(colorname);
