    activevalue {
        name = MFC_A_topPosition
        get = script get_MFCCommon_MFC_A_topPosition:
		FacePragma("ignore");
		if(!_FmIsOfSubClass(parent, "XmForm")
		|| _FmIsOfSubClass(XtParent(self), "XmMenuShell")){
			return();
		}
		Int i = self:topPosition;
		if(i)
			@ = itoa(i);
		else
		if(self:topAttachment == XmATTACH_SELF){
			i = (self:y * parent:fractionBase) / parent:height;
			@ = itoa(i);
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
