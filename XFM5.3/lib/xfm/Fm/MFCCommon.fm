        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = MFC_R_destroyCallback
        get = script get_MFCCommon_MFC_R_destroyCallback:
		FacePragma("ignore");
		if(_FmHasCallback(self, "destroyCallback")){
			@ = "destroyCallback";
		}
        type = String
        storage = object
