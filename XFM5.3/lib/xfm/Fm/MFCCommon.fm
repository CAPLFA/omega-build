        get = script get_MFCCommon_MFC_R_defaultPosition:
		FacePragma("ignore");
		if(_FmIsOfSubClass(self, "XmBulletinBoard")
		&& _FmIsOfSubClass(parent, "XmDialogShell")
		&& self:defaultPosition == True){
			@ = "True";
		}
        type = String
