widget XmDrawingArea {
    flag {
        mapped
    }
    activevalue {
        name = MFC_FUNCTIONS
        get = script get_MFCCommon_MFC_FUNCTIONS:
		FacePragma("ignore");
		function String _FmWinQuoteString(String s)
		{
			String buf = XtMalloc(strlen(s) + 3);
			sprintf(buf, '"%s"', s);
			return(buf);
		}
		
		function String _FmWinWarning(String s)
		{
			printf("XFM/Win warning: in widget %s:\n\t%s\n",
				XtName(self), s);
		}
        type = String
        storage = object
        automatic = true
        genvalue = true
    }
    activevalue {
        name = MFC_MENUBARHEIGHT
        type = String
        storage = object
        automatic = true
        genvalue = true
    }
    activevalue {
        name = MFC_X
        get = script get_MFCCommon_MFC_X:
		FacePragma("ignore");
		if(!_FmIsOfSubClass(self, "Shell") && _FmIsOfSubClass(parent, "Shell"))
			@ = 0;
		else
			@ = atoi(_FmGetWidgetResourceValue(self, "x"));
        type = Int
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
