    }
    activevalue {
        name = MFC_N_WM_SHOWWINDOW
        get = script get_MFCCommon_MFC_N_WM_SHOWWINDOW:
		FacePragma("ignore");
		if(_FmIsOfSubClass(parent, "XmDialogShell")){
			if(_FmHasCallback(self, "mapCallback")){
				if(!@) @ = "#void ::OnShowWindow(BOOL show, UINT status)#";
				@ = _FmConcatString(@, "show == TRUE?$XmAnyCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_MAP); call_data = (XtPointer)&cbs;$mapCallback", "|");
			}
			if(_FmHasCallback(self, "unmapCallback")){
				if(!@) @ = "#void ::OnShowWindow(BOOL show, UINT status)#";
				@ = _FmConcatString(@, "show == FALSE?$XmAnyCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_UNMAP); call_data = (XtPointer)&cbs;$unmapCallback", "|");
			}
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
