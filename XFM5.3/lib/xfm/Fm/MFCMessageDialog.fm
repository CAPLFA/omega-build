                widget XmLabel {
                    flag {
                    }
                    createproc {
                        FacePragma("ignore");
			XmString s = parent.parent:messageString;
			if(s)
				self:labelString = s;
			self:alignment = parent.parent:messageAlignment;
			HorizontalDimension mh = parent.parent:marginHeight;
			HorizontalDimension mw = parent.parent:marginWidth;
			self:leftOffset = mw;
			self:rightOffset = mw;
			self:topOffset = mh;
			self:bottomOffset = mh;
                    }
                    templates {
                        MFCStatic = -Fm/MFCStatic.fm
                    }
                    resources {
                        x = 10
                        y = 10
                        width = 331
                        height = 86
                        leftAttachment = attach_form
                        rightAttachment = attach_form
                        topAttachment = attach_form
                        bottomAttachment = attach_widget
                        bottomWidget = parent.sep
                    }
                } label
                widget XmPushButton {
                    flag {
                        mapped
                    }
                    activevalue {
                        name = MFC_W
                        get = script get_MFCMessageDialog_HELP_MFC_W:
				FacePragma("ignore");
				Widget w = XmMessageBoxGetChild(parent.parent, XmDIALOG_HELP_BUTTON);
				Int margin = 2*w:defaultButtonShadowThickness + w:shadowThickness + 2;
				Int width = w:width;
				if (width < 70)
					width = 70;
				@ = width - 2 * margin;
                        type = Int
                        storage = object
                        automatic = true
                        autoget = true
                        genvalue = true
                    }
                    activevalue {
                        name = MFC_AUTO_UNMANAGE
                        type = Boolean
                        storage = object
                        automatic = true
                        autoget = true
                        genvalue = true
                        default_type = String
                        default_value = false
                    }
                    createproc {
                        FacePragma("ignore");
			XmString xmstr = parent.parent:helpLabelString;
			String s = FmGetString(xmstr);
			if(strcmp(s, "Help") != 0)
				self:labelString = xmstr;
			XmStringFree(xmstr);
			XtFree(s);
                    }
                    templates {
                        MFCPushButton = -Fm/MFCPushButton.fm
                    }
                    resources {
                        x = 251
                        y = 117
                        width = 70
                        height = 40
                        labelString = Help
                        recomputeSize = false
                        rightAttachment = attach_form
                        bottomAttachment = attach_form
                        activateCallback = \
XmAnyCallback cbs = new_struct(XmAnyCallback);\
cbs->reason = XmCR_HELP;\
cbs->event = Any(0);\
XtCallCallbacks(parent.parent, "helpCallback", Pointer(cbs));\
XtFree(String(cbs));
                        defaultButtonShadowThickness = 1
                    }
                } help
            }
        } form
    }
} message
