        set = _FmResourceSetTextInt (self*resourceList.height,@,True);
    }
    activevalue {
        name = _FmResourceWindowEditor
        set = 
		Widget es = self*editScroller;
		if(XtIsManaged(es)){
			s = _FmGetResourceEditorText (toplevel);
			Widget et = es.text;
			Boolean old_editable = et:editable;
			et:editable = False;
			et:@editorText = s;
			et:editable = old_editable;
		}
    }
    activevalue {
        name = _FmClearResourceWindow
        set = form = self.xfmResourceDialog.form;\
_FmResourceSetText (form.parentName,"");\
_FmResourceSetText (form.name,"");\
_FmResourceSetText (form.class,"");\
_FmResourceSetText (form.templates,"");\
form = self*resourceList;\
_FmResourceSetTextInt (form.x,0,False);\
_FmResourceSetTextInt (form.y,0,False);\
_FmResourceSetTextInt (form.width,0,False);\
_FmResourceSetTextInt (form.height,0,False);\
function None _FmResWinObjChanged(String); _FmResWinObjChanged(String(0));
    }
    activevalue {
        name = _FmResourceAutoPos
        get = @ = Boolean(self*autopos:set);
        set = form = self*resourceList;\
toggle = form.autopos;\
if (Boolean(toggle:set) != (@ != 0)) {
	toggle:set = Set((@ != 0));
	_FmResourceAutoToggle (toggle,form.x,form.y,False);\
}
    }
    activevalue {
        name = _FmResourceAutoSize
