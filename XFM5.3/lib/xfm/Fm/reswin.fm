                widget XmForm {
                    flag {
                        mapped
                        autopos
                    }
                    createproc {
                        function void _FmResourceAutoToggle (Widget toggle,Widget texta,Widget textb,Boolean changed) {
	_FmResourceTextEdit (texta,!Boolean(toggle:set));
	_FmResourceTextEdit (textb,!Boolean(toggle:set));
	if (changed) {
		_FmResourceWindowSetModified (toplevel);
		if (Boolean(toggle:set)) {
			_FmSetNamedWindowResource (toplevel,XtName (texta),String (0));
			_FmSetNamedWindowResource (toplevel,XtName (textb),String (0));
		} else {
			s = texta:value;
			_FmSetNamedWindowResource (toplevel,XtName (texta),s);
			XtFree (s);
			s = textb:value;
			_FmSetNamedWindowResource (toplevel,XtName (textb),s);
			XtFree (s);
		}
		if (XtIsManaged (parent:@listScroller))
			_FmSortResourceWindow (toplevel);
		else {
			s = _FmGetResourceEditorText (toplevel);
			parent.editScroller.text:@editorText = s;
		}
	}\
}\
