                                    flag {
                                        mapped
                                        autosize
                                        autopos
                                    }
                                    resources {
                                        marginHeight = 1
                                        activateCallback = l = parent.scroller.list;\
	s = self:value;\
	xms = CreateXmString (s);
	if (XmListItemExists (l,xms))
		XmListDeleteItem (l,xms);
	XmListAddItem (l,xms,0);
	XmListSelectPos (l,l:itemCount,True);
	StringFree (xms);\
	XtFree (s);
                                        topAttachment = attach_none
                                        leftAttachment = attach_form
                                        leftOffset = 5
                                        rightAttachment = attach_widget
