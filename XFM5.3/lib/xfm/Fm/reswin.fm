	function None _FmLoadCustomEditResources(String s)
	{
		_FmCELoadString(self:userData, s);
		String buf = XtMalloc(512);
		String widgetname = toplevel.xfmResourceDialog.form.name:value;
		if(equal(widgetname, "")){
			XtFree(widgetname);
			widgetname = XtNewString("<none>");
		}
		sprintf(buf, Internationalize("%MSG%150%1058 XFM: Resources of Widget %s"), widgetname);
		XtFree(widgetname);
		_FmCETitle(self:userData, buf);
		XtFree(buf);
	}
	s = self:value;
	_FmLoadCustomEditResources(s);
	XtFree(s);
	self:editable = False;
                                                type = String
                                                storage = object
                                                automatic = true
