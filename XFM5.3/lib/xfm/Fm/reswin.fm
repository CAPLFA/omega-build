                                    createproc {
                                        function void _FmResourceLoadSmallToggle (Widget p,String name,String label) {
	global Dimension _FmSmallResIndHeight;
	if (_FmSmallResIndHeight == 0) {
		tog = toplevel*autopos;
		xms = tog:labelString;
		fl = tog:fontList;
		_FmSmallResIndHeight = (XmStringHeight(fl,xms) - 4) / 2 * 2 + 1;
		if (_FmSmallResIndHeight < 11)
			_FmSmallResIndHeight = _FmSmallResIndHeight + 2;
		XmStringFree (xms);
	}
	s = XtMalloc(200);
	sprintf (s,"NAME=%s,RESOURCE_TOGGLE_LABEL=%s,INDICATOR_SIZE=%d",name,label,_FmSmallResIndHeight);
	CreateGroupInstance (p,"_FmSmallResourceButton","Fm/smallres.fm",s);
	XtFree (s);\
}\
_FmResourceLoadSmallToggle (self,"myself","self");\
_FmResourceLoadSmallToggle (self,"selection","selected widgets");\
_FmResourceLoadSmallToggle (self,"subtree","selected sub-tree");\
self.myself:set = Set(True);
