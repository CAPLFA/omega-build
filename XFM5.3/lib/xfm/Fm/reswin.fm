    activevalue {
        name = _FmResourceX
        get = function int _FmResourceGetTextInt (Widget w) {
	val = w:value;
	n = atoi (val);
	XtFree (val);
	return n;\
}\
@ = _FmResourceGetTextInt (self*resourceList.x);
        set = function void _FmResourceSetTextInt (Widget w,Int val,Boolean list) {
	s = itoa (val);
	_FmResourceSetText (w,s);
	if(list)
		_FmSetGeometryResource(toplevel, XtName(w), s);
	Widget editbox = Widget(xfmResourceDialog.form.resourceEdit:userData);
	if(equal(XtName(editbox), "attach") && XtIsManaged(editbox)){
		FmSetActiveValue(editbox, "_FmUpdateAttachOffsets");
	}
	XtFree (s);\
}\
_FmResourceSetTextInt (self*resourceList.x,@,True);
    }
    activevalue {
        name = _FmResourceY
        get = @ = _FmResourceGetTextInt (self*resourceList.y);
        set = _FmResourceSetTextInt (self*resourceList.y,@,True);
    }
    activevalue {
        name = _FmResourceWidth
        get = @ = _FmResourceGetTextInt (self*resourceList.width);
        set = _FmResourceSetTextInt (self*resourceList.width,@,True);
