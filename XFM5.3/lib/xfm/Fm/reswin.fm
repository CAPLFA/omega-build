    activevalue {
        name = _FmResourceTypeIcon
        set = \
menu = self.xfmResourceDialog.form.resourceList.listScroller.bb.type;\
_FmResourceSetToggleIcon (toplevel,menu.unset,_Fm_rstate_unset);\
_FmResourceSetToggleIcon (toplevel,menu.default,_Fm_rstate_default);\
_FmResourceSetToggleIcon (toplevel,menu.template,_Fm_rstate_template);\
_FmResourceSetToggleIcon (toplevel,menu.set,_Fm_rstate_set);\
_FmResourceSetToggleIcon (toplevel,menu.rdb,_Fm_rstate_rdb);
    }
    activevalue {
        name = _FmResourceRestricted
        set = w = self*resourceList:@listText; w:editable = !@; w:verifyBell = !@;\
XtSetSensitive (self*resourceList:@listDots,!@);
    }
    activevalue {
        name = _FmResourceEditResource
        set = list = self.xfmResourceDialog.form.resourceList;\
editor = self.xfmResourceDialog.form.resourceEdit;\
sorter = self.xfmResourceDialog.form.resourceSort;\
if (XtIsManaged (editor)) {
	xms = self.resource:labelString;
	s = FmGetString (xms);
	XmStringFree (xms);
	if (strcmp ($,s) != 0)
		XtCallCallbacks (editor.set,"activateCallback",NULL);\
} else if (XtIsManaged (sorter))
	XtCallCallbacks (sorter.reset,"activateCallback",NULL);\
else if (XtIsManaged (list.editScroller))
	XtCallCallbacks (list.mode,"activateCallback",NULL);\
if (!XtIsManaged (editor)){
	_FmResourceListEditName (self,$);
	XtCallCallbacks (list:@listDots,"activateCallback",0);\
}
    }
    activevalue {
        name = _FmResourceEditResourceLine
        set = text = self.xfmResourceDialog.form.resourceEdit.String.text;\
pos = FmTextGetLineColumnPosition (text,@,0);\
next = FmTextGetLineColumnPosition (text,@ + 1,0);\
XmTextSetHighlight (text,pos,next,XmHIGHLIGHT_SECONDARY_SELECTED);\
XmTextSetInsertionPosition (text,FmTextGetLineColumnPosition (text,@,0));
    }
    activevalue {
        name = _FmResourcePreferenceList
        get = sort = self.xfmResourceDialog.form.resourceSort;\
if (XtIsManaged (sort))
	@ = sort.scroller;\
else
	@ = NULL;
    }
    activevalue {
        name = _FmStartupFile
        set = 
		Pointer f = @;
		
		fprintf(f, "Widget rw = root.%s;\n", XtName(self));
		fprintf(f, "if(rw){\n");
		
		function String _FmBoolString (Boolean val) {
			if (val)
				return("True");
			else
				return("False");
		}
		
		_FmSetResourceSortOptions(toplevel);
		_FmSetResourcePreferences(toplevel,toplevel*resourceSort.scroller.list);
		
		if(Boolean(self*alphabetic:set)) fprintf(f, "	XmToggleButtonSetState(rw*alphabetic, True, True);\n");
		else
		if(Boolean(self*bySubclass:set)) fprintf(f, "	XmToggleButtonSetState(rw*bySubclass, True, True);\n");
		else
		if(Boolean(self*bySuperclass:set)) fprintf(f, "	XmToggleButtonSetState(rw*bySuperclass, True, True);\n");
		
		if(Boolean(self*xfmTop:set)) fprintf(f, "	XmToggleButtonSetState(rw*xfmTop, True, True);\n");
		else
		if(Boolean(self*xfmBottom:set)) fprintf(f, "	XmToggleButtonSetState(rw*xfmBottom, True, True);\n");
		
		if(Boolean(self*avTop:set)) 	fprintf(f, "	XmToggleButtonSetState(rw*avTop, True, True);\n");
		else
		if(Boolean(self*avBottom:set)) fprintf(f, "	XmToggleButtonSetState(rw*avBottom, True, True);\n");
		
		fprintf(f, "	XmToggleButtonSetState(rw*gather, %s, True);\n", _FmBoolString(Boolean(self*gather:set)));
		fprintf(f, "	XmToggleButtonSetState(rw*showtmpl, %s, True);\n", _FmBoolString(Boolean(self*showtmpl:set)));
		fprintf(f, "	XmToggleButtonSetState(rw*showres, %s, True);\n", _FmBoolString(Boolean(self*showres:set)));
		
		fprintf(f, "	_FmGetResourceSortOptions(rw);\n");
		
		String preferred_resources = _FmGetList(self*resourceSort.scroller.list);
		if(preferred_resources
		&& strcmp(preferred_resources, "") != 0){
			fprintf(f, "	Widget l = rw*resourceSort.scroller.list;\n");
			fprintf(f, "	if(l){\n");
			fprintf(f, "		_FmListFill(l, '%s');\n", preferred_resources);
			fprintf(f, "		_FmGetResourcePreferences(rw, l);\n");
			fprintf(f, "	}\n");
		}
		
		if(!IsManaged(self*resourceList:@listScroller))
			fprintf(f, "
	if(IsManaged(rw*resourceList:@listScroller))
		XtCallCallbacks(rw*mode, activateCallback, 0);\n");
		
		fprintf(f, "}\n");
		
		@ = f;
    }
    createproc {
        global String _FmResourceTitle;\
if (_FmResourceTitle == String(0)) {
	global String _FmResourceIconTitle;
	global String _FmCurrentResourceTitle;
	global String _FmCurrentResourceIconTitle;
	_FmResourceTitle = XtNewString (self:title);
	_FmResourceIconTitle = XtNewString (self:iconName);
	_FmCurrentResourceTitle = "XFaceMaker: Current Widget Resources";
	_FmCurrentResourceIconTitle = "Current";\
}
    }
    resources {
        geometry = -0-0
        minWidth = 440
        minHeight = 450
        width = 440
        height = 450
        deleteResponse = unmap
        title = %MSG%150%1016 XFaceMaker: Widget Resources
        iconName = Resources
        iconPixmap = XfmIcon
        popupCallback = FmRaiseWidget(self.xfmResourceDialog.form);
        popdownCallback = form = self.xfmResourceDialog.form;\
w = Widget (form:userData);\
if (w != form.resourceList) {
	FmHideWidget (w);
	FmShowWidget (form.resourceList);
	form:userData = Pointer (form.resourceList);\
}\
_FmCloseResourceWindow (toplevel);
        translations = #override \
<Map>: eval("_FmResWinMapped (self,True);")\
<Unmap>: eval("_FmResWinMapped (self,False);")
        x = 123
        y = 167
