global XmString _FmResEditTitle;\
global XmString _FmResListTitle;\
if (IsManaged (parent:@listScroller)) {
	old_editable = parent.editScroller.text:editable;
	parent.editScroller.text:editable = False;
	s = _FmGetResourceEditorText (toplevel);
	parent.editScroller.text:@editorText = s;
	parent.editScroller.text:editable = old_editable;
	/*
	rc = parent.applyRC;
