    activevalue {
        name = _FmResourceItemTextValue
        get = w = self*resourceList:@listText;\
s = w:value;\
strcpy ($,s);\
XtFree (s);
        set = w = self*resourceList:@listText;\
e = w:editable;\
w:editable = False;\
w:value = $;\
w:editable = e;
