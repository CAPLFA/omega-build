	Widget w = Widget(parent:userData);
	String topic = XtMalloc(100);
	if(w)
		strcpy(topic, XtName(w));
	else
		strcpy(topic, Internationalize("%MSG%150%1071 Specialized") );
	if(strcmp(topic, "attach") == 0)
		strcpy(topic, "Attachment");
	else
	if(strcmp(topic, "Colors") == 0)
		strcpy(topic, "Color");
	else
	if(strcmp(topic, "Images") == 0)
		strcpy(topic, "Image");
	else
	if(strcmp(topic, "Fonts") == 0)
		strcpy(topic, "Font");
	strcat(topic, " Resource Editor");
	s = FmGetHelp ("Resources",topic);\
	_FmHelp ("Resource Editor",s);\
	XtFree (s);
	XtFree (topic);
