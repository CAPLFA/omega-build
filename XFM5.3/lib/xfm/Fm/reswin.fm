	self:userData = Pointer (_FmResEditLabel);
	self:labelString = _FmResEditButton;
	FmHideWidget (parent.editScroller);
	FmShowWidget (parent.callbackbar);
	FmShowWidget (parent.searchsep);
	FmShowWidget (parent.searchlabel);
	FmShowWidget (parent.searchfield);
	FmShowWidget (parent:@listScroller);\
	if(!(parent:@listScroller == parent.fastListScroller
	 && parent.fastListScroller.fastList:itemCount == 0)){
		FmShowWidget (parent:@listText);
		FmShowWidget (parent:@listDots);
	}
	FmHideWidget (parent.custombutton);
	if(parent.editScroller.text:userData){
		_FmCEClose(parent.editScroller.text:userData, "");
	}\
}\
