    }
    activevalue {
        name = _FmResourceEditMode
        set = form = self.xfmResourceDialog.form;\
	w = Widget (form:userData);\
	if (w != form.resourceList)
		XtCallCallbacks (w.reset,"activateCallback",0);\
	form = self.xfmResourceDialog.form.resourceList;\
	if ((XtIsManaged (form:@listScroller) != 0) == (@ != 0))
		XtCallCallbacks (form.mode,"activateCallback",0);
    }
    activevalue {
        name = _FmResourceParent
        set = function void _FmResourceSetText (Widget w,String s) {
	e = w:editable;
	if(e)
		w:editable = False;
	v = w:value;
	if (strcmp (v,s) != 0) {
		w:value = s;
		XmTextSetInsertionPosition (w,XmTextGetLastPosition (w));
	}
	XtFree (v);
	w:userData = Pointer (False);
	/*FaceSetValues(w, 2, "columns", 10, "userData", False);*/
	if(e)
		w:editable = e;\
}\
_FmResourceSetText (self.xfmResourceDialog.form.parentName,$);
    }
    activevalue {
        name = _FmResourceWidget
        get = function void _FmResourceGetText (Widget w,String name) {
	v = w:value;
	_FmSysAvLocalCopy(name, v);
	_FmSysAvStringCopy(name, v);
	XtFree (v);\
}\
_FmResourceGetText (self.xfmResourceDialog.form.name,"_FmResourceWidget");
        set = _FmResourceSetText (self.xfmResourceDialog.form.name,$);
    }
    activevalue {
        name = _FmResourceClassText
        get = @ = self.xfmResourceDialog.form.class;
    }
    activevalue {
        name = _FmResourceClassTextValue
        set = _FmResourceSetText (self.xfmResourceDialog.form.class,$);\
self.xfmResourceDialog.form.class:userData = Pointer(True);\
_FmResourceWindowSetModified (toplevel);
    }
    activevalue {
        name = _FmResourceClass
        get = _FmResourceGetText (self.xfmResourceDialog.form.class,"_FmResourceClass");
        set = _FmResourceSetText (self.xfmResourceDialog.form.class,$);
	name = XtNewString($);
	_FmSetResourceClass (toplevel,name);
	/*
	Widget draw = self*resourceList.draw;
	if (strcmp (name ,"XnslDraw") == 0){
		FmShowWidget (draw);
