	function void _FmResourceTextEdit (Widget text,Boolean okay) {
		if (_FmResourceTopShadow == Pixmap(0)) {
			_FmResourceTopShadow = Pixmap(text:topShadowPixmap);
			_FmResourceBottomShadow = Pixmap(text:bottomShadowPixmap);
		}
		if (okay) {
			FmRaiseWidget (text);
			text:topShadowPixmap = NoScalingDynamicPixmap(_FmResourceTopShadow);
			text:bottomShadowPixmap = NoScalingDynamicPixmap(_FmResourceBottomShadow);
			text:cursorPositionVisible = true;
			text:editable = true;
			text:verifyBell = true;
		} else {
			text:topShadowPixmap = "background";
			text:bottomShadowPixmap = "background";
			text:cursorPositionVisible = false;
			text:editable = false;
			text:verifyBell = false;
		}\
	}\
	FmSetWidest (self.autopos,self.autosize,NULL);\
	FmSetWidest (self.xLabel,self.widthLabel,NULL);\
	FmSetWidest (self.yLabel,self.heightLabel,NULL);\
	FmSetWidest (self.popup,self.gadget,NULL);\
	parent:userData = Pointer (self);\
	if(@_FmResourceFastListMode){
		self:@listScroller = self.fastListScroller;
		self:@listText = self.fastListText;
		self:@listDots = self.fastListDots;
		_FmSetFastListMode(toplevel, 1);
		XtManageChild(self.fastListScroller);
		XtUnmanageChild(self.listScroller);
	} else {
		self:@listScroller = self.listScroller;
		self:@listText = self*listText;
		self:@listDots = self*listDots;
		_FmSetFastListMode(toplevel, 0);
		XtUnmanageChild(self.fastListScroller);
		XtManageChild(self.listScroller);
	}
