	self:userData = Pointer (_FmResListLabel);
	self:labelString = _FmResListButton;
	FmHideWidget (parent:@listScroller);
	FmHideWidget (parent:@listText);
	FmHideWidget (parent:@listDots);
	FmHideWidget (parent.callbackbar);
	FmHideWidget (parent.searchsep);
	FmHideWidget (parent.searchlabel);
	FmHideWidget (parent.searchfield);
	FmShowWidget (parent.editScroller);
	FmShowWidget (parent.custombutton);
	if(parent.editScroller.text:userData){
		_FmCEOpen(parent.editScroller.text:userData, "");
	}\
} else {
	s = parent.editScroller.text:value;
	_FmSetResourceEditorText (toplevel,s);
