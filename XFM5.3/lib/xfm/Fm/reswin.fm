                                        rightOffset = 8
                                        rightWidget = orderLabel
                                        bottomAttachment = attach_widget
                                        bottomOffset = 5
                                        bottomWidget = resourceLabel
                                    }
                                    children {
                                        widget XmList {
                                            flag {
                                                mapped
                                                autosize
                                                autopos
                                            }
                                            resources {
                                                shadowThickness = 0
                                                browseSelectionCallback = XmListCallback cb = $;\
XtSetSensitive (parent.parent.replace,True);\
XtSetSensitive (parent.parent.delete,True);\
self:userData = Pointer(cb->item_position);\
s = GetString (cb->item);\
tx = parent.parent.resource;\
tx:value = s;\
XmTextFieldSetSelection (tx,0,XmTextFieldGetLastPosition (tx),Time(0));\
XtFree (s);
                                            }
                                        } list
                                    }
                                } scroller
                            }
                        } resourceSort
