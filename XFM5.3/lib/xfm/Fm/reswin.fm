	function None _FmResWinApply(Widget text)
	{
		Widget button;
		if(text){
			String v = text:value;
			if(strcmp(v, "") == 0)
				button = toplevel*resourceList.apply;
			else
				button = toplevel*resourceList.applyset;
			XtFree(v);
		} else {
			button = toplevel*resourceList.apply;
		}
		XtCallActionProc(button, "ArmAndActivate", 0, 0, 0);
	}
	_FmResWinApply(Widget(0));
