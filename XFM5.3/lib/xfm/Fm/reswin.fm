        set = XtSetSensitive (self*popup,@ != 0);
    }
    activevalue {
        name = _FmResourceCanGadget
        set = XtSetSensitive (self*gadget,@ != 0);
    }
    activevalue {
        name = _FmResourceCanAuto
        set = 
	Int sens;
	sens = @ != 0;
	XtSetSensitive (self*autosize, sens);
	XtSetSensitive (self*autopos, sens);
	XtSetSensitive (self*x, sens);
	XtSetSensitive (self*y, sens);
	XtSetSensitive (self*width, sens);
	XtSetSensitive (self*height, sens);
	XtSetSensitive (self*gadget, sens);
    }
    activevalue {
        name = _FmResourceList
        set = editor = self*editScroller;\
editing = XtIsManaged (editor);\
empty = strcmp ($,"") == 0;\
_FmSetResourceList (toplevel,$,False);\
if (editing) {
	old_editable = editor.text:editable;
	editor.text:editable = False;
	if (empty)
		s = "";
	else
		s = _FmGetResourceEditorText(toplevel);
	editor.text:@editorText = s;
	editor.text:editable = old_editable;\
} else if (empty)
	FmSetActiveValue (toplevel,"_FmClearResourceWindow");
    }
    activevalue {
        name = _FmResourceListReset
        set = 
	function None _FmResWinObjChanged(String resname){
		Widget w = Widget (self.xfmResourceDialog.form:userData);
		if(w == self*resourceSort){
			XtCallCallbacks (w.reset,"activateCallback",0);
		}
		else
		if(w == self*resourceEdit){
			Boolean visible;
			if(resname)
				visible = 1;
			else
				visible = 0;
			Widget dialog = Widget(w:userData);
			if(dialog){
				if(visible)
					_FmEditNamedWindowResource(toplevel, resname);
				XtSetSensitive(dialog, visible);
			}
			XtSetSensitive(w.ok, visible);
			XtSetSensitive(w.apply, visible);
			XtSetSensitive(w.applyset, visible);
			XtSetSensitive(w.set, visible);
		}
	}
	_FmResWinObjChanged(String(@));
    }
    activevalue {
        name = _FmResourceCallbackMenu
        get = @ = self*callbacksPulldown;
    }
    activevalue {
        name = _FmResourceListBB
