    }
    activevalue {
        name = MFC_N_WM_HSCROLL
        get = script get_MFCScrollBar_MFC_N_WM_HSCROLL:
		FacePragma("ignore");
		if(self:orientation == XmHORIZONTAL){
			@ = "#void ::OnHScroll(UINT code, UINT pos, CScrollBar* sb)#$if(sb == %self) FmWMoveScrollBar(sb, code, pos);$";
			@ = _FmConcatString(@, "$static int %name_callValueChanged;$none", "|");
			@ = _FmConcatString(@, "$if(sb == %self && code != SB_ENDSCROLL) %name_callValueChanged = 1;$none", "|");
			if(_FmIsOfSubClass(self, "XmScrollBar")){
				if(_FmHasCallback(self, "incrementCallback")){
					@ = _FmConcatString(@, "sb == %self && code == SB_LINEDOWN?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_INCREMENT); call_data = (XtPointer)&cbs; %name_callValueChanged = 0;$incrementCallback", "|");
				}
				if(_FmHasCallback(self, "decrementCallback")){
					@ = _FmConcatString(@, "sb == %self && code == SB_LINEUP?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_DECREMENT); call_data = (XtPointer)&cbs; %name_callValueChanged = 0;$decrementCallback", "|");
				}
				if(_FmHasCallback(self, "pageIncrementCallback")){
					@ = _FmConcatString(@, "sb == %self && code == SB_PAGEDOWN?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_PAGE_INCREMENT); call_data = (XtPointer)&cbs; %name_callValueChanged = 0;$pageIncrementCallback", "|");
				}
				if(_FmHasCallback(self, "pageDecrementCallback")){
					@ = _FmConcatString(@, "sb == %self && code == SB_PAGEUP?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_PAGE_DECREMENT); call_data = (XtPointer)&cbs; %name_callValueChanged = 0;$pageDecrementCallback", "|");
				}
				if(_FmHasCallback(self, "toTopCallback")){
					@ = _FmConcatString(@, "sb == %self && code == SB_TOP?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_TO_TOP); call_data = (XtPointer)&cbs; %name_callValueChanged = 0;$toTopCallback", "|");
				}
				if(_FmHasCallback(self, "toBottomCallback")){
					@ = _FmConcatString(@, "sb == %self && code == SB_BOTTOM?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_TO_BOTTOM); call_data = (XtPointer)&cbs; %name_callValueChanged = 0;$toBottomCallback", "|");
				}
			}
			if(_FmHasCallback(self, "dragCallback")){
				@ = _FmConcatString(@, "sb == %self && code == SB_THUMBTRACK?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_DRAG); call_data = (XtPointer)&cbs;$dragCallback", "|");
			}
			if(_FmHasCallback(self, "valueChangedCallback")){
				@ = _FmConcatString(@, "sb == %self && code == SB_ENDSCROLL && %name_callValueChanged?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_VALUE_CHANGED); call_data = (XtPointer)&cbs;$valueChangedCallback", "|");
			}
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = MFC_N_WM_VSCROLL
        get = script get_MFCScrollBar_MFC_N_WM_VSCROLL:
		FacePragma("ignore");
		if(self:orientation == XmVERTICAL){
			@ = "#void ::OnVScroll(UINT code, UINT pos, CScrollBar* sb)#$if(sb == %self) FmWMoveScrollBar(sb, code, pos);$";
			@ = _FmConcatString(@, "$static int %name_callValueChanged;$none", "|");
			@ = _FmConcatString(@, "$if(sb == %self && code != SB_ENDSCROLL) %name_callValueChanged = 1;$none", "|");
			if(_FmIsOfSubClass(self, "XmScrollBar")){
				if(_FmHasCallback(self, "incrementCallback")){
					@ = _FmConcatString(@, "sb == %self && code == SB_LINEDOWN?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_INCREMENT); call_data = (XtPointer)&cbs; %name_callValueChanged = 0;$incrementCallback", "|");
				}
				if(_FmHasCallback(self, "decrementCallback")){
					@ = _FmConcatString(@, "sb == %self && code == SB_LINEUP?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_DECREMENT); call_data = (XtPointer)&cbs; %name_callValueChanged = 0;$decrementCallback", "|");
				}
				if(_FmHasCallback(self, "pageIncrementCallback")){
					@ = _FmConcatString(@, "sb == %self && code == SB_PAGEDOWN?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_PAGE_INCREMENT); call_data = (XtPointer)&cbs; %name_callValueChanged = 0;$pageIncrementCallback", "|");
				}
				if(_FmHasCallback(self, "pageDecrementCallback")){
					@ = _FmConcatString(@, "sb == %self && code == SB_PAGEUP?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_PAGE_DECREMENT); call_data = (XtPointer)&cbs; %name_callValueChanged = 0;$pageDecrementCallback", "|");
				}
				if(_FmHasCallback(self, "toTopCallback")){
					@ = _FmConcatString(@, "sb == %self && code == SB_TOP?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_TO_TOP); call_data = (XtPointer)&cbs; %name_callValueChanged = 0;$toTopCallback", "|");
				}
				if(_FmHasCallback(self, "toBottomCallback")){
					@ = _FmConcatString(@, "sb == %self && code == SB_BOTTOM?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_TO_BOTTOM); call_data = (XtPointer)&cbs; %name_callValueChanged = 0;$toBottomCallback", "|");
				}
			}
			if(_FmHasCallback(self, "dragCallback")){
				@ = _FmConcatString(@, "sb == %self && code == SB_THUMBTRACK?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_DRAG); call_data = (XtPointer)&cbs;$dragCallback", "|");
			}
			if(_FmHasCallback(self, "valueChangedCallback")){
				@ = _FmConcatString(@, "sb == %self && code == SB_ENDSCROLL && %name_callValueChanged?$XmScrollBarCallbackStruct cbs(%self, GetCurrentMessage(), XmCR_VALUE_CHANGED); call_data = (XtPointer)&cbs;$valueChangedCallback", "|");
			}
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = MFC_R_dragCallback
        get = script get_MFCScrollBar_MFC_R_dragCallback:
		FacePragma("ignore");
		if(_FmHasCallback(self, "dragCallback")){
			@ = "dragCallback";
