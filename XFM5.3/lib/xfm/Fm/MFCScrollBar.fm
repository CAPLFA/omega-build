widget XmScrollBar {
    flag {
        mapped
    }
    activevalue {
        name = MFC_CLASS
        type = String
        storage = object
        automatic = true
        default_type = String
        default_value = CScrollBar
        genvalue = true
    }
    activevalue {
        name = MFC_VERTICAL
        get = script get_MFCScrollBar_MFC_VERTICAL:
		FacePragma("ignore");
		if(self:orientation == XmVERTICAL)
			@ = True;
        type = Boolean
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
