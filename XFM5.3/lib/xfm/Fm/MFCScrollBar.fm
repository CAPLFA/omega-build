    activevalue {
        name = MFC_S_SBS_VERT
        get = script get_MFCScrollBar_MFC_S_SBS_VERT:
		FacePragma("ignore");
		if(self:orientation == XmVERTICAL)
			@ = True;
        type = Boolean
