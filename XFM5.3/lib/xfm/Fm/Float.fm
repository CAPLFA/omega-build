		}
		s = XtMalloc(200);
		sprintf(s, "%.2g", v);
		parent.text:value = s;
		XtFree(s);
	}
	
	_FmStepperArrowArm(self:arrowDirection);
	
	self:<timeout> = CallCallbacksTimeOut(self, "armCallback", 200);
	
                        disarmCallback = 
	
	if(self:<timeout>){
		StopTimeOut(self:<timeout>);
		type TimeOutClosure;
		self:<timeout> = TimeOutClosure(0);
	}
	
	XtCallCallbacks(parent.text, "activateCallback", $);
                    }
                } left_arrow
                widget XmArrowButton {
                    flag {
                        mapped
                        autosize
                        autopos
                    }
                    resources {
                        rightAttachment = attach_form
                        topAttachment = attach_widget
                        bottomAttachment = attach_form
                        arrowDirection = arrow_right
                        topWidget = parent.label
                        armCallback = 
	
	function None _FmStepperArrowArm(ArrowDirection direction)
	{
		Float v;
		String s; s = parent.text:value;
		v = Float(ConvertString(self, s, "Float"));
		XtFree(s);
		if(direction == XmARROW_RIGHT
		|| direction == XmARROW_UP){
			if(v == 0.0)
				v = 1.0;
			else if(v > 0.0){
				if(v < 1.0)
					v = 1.0;
				else
					v = v * 10.0;
			} else {
				if(v < -1.0)
					v = v / 10.0;
				else
					v = 0.0;
			}
		} else {
			if(v == 0.0)
				v = -1.0;
			else if(v <= 0.0){
				if(v > -1.0)
					v = -1.0;
				else
					v = v * 10.0;
			} else {
				if(v > 1.0)
					v = v / 10.0;
				else
					v = 0.0;
			}
		}
		s = XtMalloc(200);
		sprintf(s, "%.2g", v);
		parent.text:value = s;
		XtFree(s);
	}
	
	_FmStepperArrowArm(self:arrowDirection);
	
	self:<timeout> = CallCallbacksTimeOut(self, "armCallback", 200);
	
                        disarmCallback = 
	
	if(self:<timeout>){
		StopTimeOut(self:<timeout>);
		type TimeOutClosure;
		self:<timeout> = TimeOutClosure(0);
	}
	
	XtCallCallbacks(parent.text, "activateCallback", $);
                    }
                } right_arrow
                widget XmText {
                    flag {
                        mapped
                        autosize
                        autopos
                    }
                    resources {
                        bottomAttachment = attach_form
                        leftAttachment = attach_widget
                        leftWidget = parent.left_arrow
                        rightAttachment = attach_widget
                        rightWidget = parent.right_arrow
                        topAttachment = attach_widget
                        topWidget = parent.label
                        marginHeight = 2
                        marginWidth = 2
                        activateCallback = 
	Float v; v = ConvertString(self, self:value, "Float");
	m = cftoi(v * 100.0);
	if(m <= parent.parent.scale:minimum){
		Beep();
		String s; s = XtMalloc(20);
		sprintf(s, "%d.0", parent.parent.scale:minimum / 100);
		self:value = s;
		XtFree(s);
		_FmStepperArrowArm(parent.right_arrow:arrowDirection);
		return();
	}
	if(parent.parent.scale:value > m)
		parent.parent.scale:value = m;
	parent.parent.scale:maximum = m;
                        value = 100.00
                    }
                } text
            }
        } max_stepper
    }
} form
