widget XmForm {
    flag {
        mapped
        autosize
        autopos
    }
    activevalue {
        name = _FmResourceReturnValue
        get = s = self.value:value;\
strcpy ($,s);\
free (s);
    }
    activevalue {
        name = Int
        set = v = Int(@);\
min = Round(v, 0);\
max = Round(v + self.sb:sliderSize, 1);\
ext = (max - min) / 10;\
if(ext <= 0)
	ext = 1;\
if(min < -100000)
	min = -100000;\
if(max > 100000)
	max = 100000;\
function void _FmSetIntegerScrollbar (Int min,Int max,Int ext,Int val) {
	self.sb:minimum = min;
	self.sb:maximum = max;
	self.sb:sliderSize = ext;
	self.sb:value = val;
	s = itoa(val);
	self.value:value = s;
	free (s);
	s = itoa(min);
	self.min:labelString = s;
	free (s);
	s = itoa(max);
	self.max:labelString = s;
	free (s);\
}\
_FmSetIntegerScrollbar (min,max,ext,v);
    }
    activevalue {
        name = PositiveInt
        set = v = Int(@);\
if(v < 0)
	v = 0;\
min = 0;\
max = Round(v + self.sb:sliderSize, 1);\
ext = (max - min) / 10;\
if(ext <= 0)
	ext = 1;\
if(max > 100000)
	max = 100000;\
_FmSetIntegerScrollbar (min,max,ext,v);
    }
    activevalue {
        name = _FmResourceEditManage
        set = XmProcessTraversal (self.sb,XmTRAVERSE_CURRENT);
    }
    resources {
    }
    children {
        widget XmLabel {
            flag {
                mapped
                autosize
                autopos
            }
            resources {
                labelString = %MSG%150%948 value:
                marginHeight = 0
                marginWidth = 0
                topAttachment = attach_form
                topOffset = 10
                leftAttachment = attach_none
                rightAttachment = attach_position
                rightPosition = 40
            }
        } valueLabel
        widget XmTextField {
            flag {
                mapped
                autopos
            }
            resources {
                height = 24
                width = 80
                marginHeight = 1
                marginWidth = 1
                topAttachment = attach_opposite_widget
                topOffset = -5
                topWidget = valueLabel
                leftAttachment = attach_widget
                leftOffset = 2
                leftWidget = valueLabel
            }
        } value
        widget XmScrollBar {
            flag {
                mapped
                autosize
                autopos
            }
            resources {
                orientation = horizontal
                topAttachment = attach_widget
                topOffset = 10
                topWidget = value
                leftAttachment = attach_form
                leftOffset = 5
                rightAttachment = attach_form
                rightOffset = 5
                dragCallback = script _FmIntSetText:\
s = itoa (self:value);\
parent.value:value = s;\
free (s);
                valueChangedCallback = script _FmIntSetText;
            }
        } sb
        widget XmPushButton {
            flag {
                mapped
                autopos
            }
            createproc {
                function int _FmIntValue (Widget w) {
	xms = w:labelString;
	s = GetString (xms);
	n = atoi (s);
	free (s);
	XmStringFree (xms);
	return(n);\
}\
function void _FmIntMinButton1() {
	n = _FmIntValue(self);
	if (n == 0) 
		n = -1;
	else if (n > -100000)
		n = n * 10;
	else
		n = 0;
	if(n > parent.sb:value){
		FmBeep();
		return();
	}
	self:labelString = itoa (n);
	parent.sb:minimum = n;\
}\
function void _FmIntMinButton3() {
	n = _FmIntValue(self);
	if(n == 0){
		FmBeep();
		return();
	}
	n = n / 10;
	if(n > parent.sb:value){
		FmBeep();
		return();
	}
	self:labelString = itoa (n);
	parent.sb:minimum = n;\
}
            }
            resources {
                height = 26
                width = 70
                labelString = 0
                recomputeSize = false
                topAttachment = attach_widget
                topOffset = 10
                topWidget = sb
                leftAttachment = attach_opposite_widget
                leftOffset = 10
                leftWidget = sb
                translations = #override \
<Btn1Down> : eval("_FmIntMinButton1();")\
<Btn3Down> : eval("_FmIntMinButton3();")
            }
        } min
        widget XmPushButton {
            flag {
                mapped
                autopos
            }
            createproc {
                function void _FmIntMaxButton1() {
	n = _FmIntValue (self);
	if (n == 0)
		n = 1;
	else if (n < 100000)
		n = n * 10;
	else
		n = 0;
	if(n < parent.sb:value){
		FmBeep();
		return();
	}
	self:labelString = itoa (n);
	parent.sb:maximum = n + parent.sb:sliderSize;\
}\
function void _FmIntMaxButton3() {
	n = _FmIntValue(self);
	if(n == 0){
		FmBeep();
		return();
	}
	n = n / 10;
	if(n < parent.sb:value){
		FmBeep();
		return();
	}
	self:labelString = itoa (n);
	parent.sb:maximum = n + parent.sb:sliderSize;\
}
            }
            resources {
                height = 26
                width = 70
                labelString = 10000
                recomputeSize = false
                topAttachment = attach_widget
                topOffset = 10
                topWidget = sb
                leftAttachment = attach_none
                rightAttachment = attach_opposite_widget
                rightOffset = 10
                rightWidget = sb
                translations = #override \
<Btn1Down> : eval("_FmIntMaxButton1();")\
<Btn3Down> : eval("_FmIntMaxButton3();")
            }
        } max
    }
} Integer
