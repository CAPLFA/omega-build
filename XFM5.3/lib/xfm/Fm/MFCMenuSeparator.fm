widget XmSeparator {
    flag {
        mapped
    }
    activevalue {
        name = MFC_ISMENUSEPARATOR
        get = script get_MFCMenuSeparator_MFC_ISMENUSEPARATOR:
		FacePragma("ignore");
		if(_FmIsOfSubClass(parent, "XmRowColumn")
		&& (parent:rowColumnType == XmMENU_BAR
		 || parent:rowColumnType == XmMENU_PULLDOWN
		 || parent:rowColumnType == XmMENU_POPUP)){
			@ = True;
		}
        type = Boolean
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = MFC_S_SEPS_HORIZONTAL
        get = script get_MFCMenuSeparator_MFC_S_SEPS_HORIZONTAL:
		FacePragma("ignore");
		if(self:orientation == XmHORIZONTAL)
			@ = True;
        type = Boolean
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = MFC_S_SEPS_VERTICAL
        get = script get_MFCMenuSeparator_MFC_S_SEPS_VERTICAL:
		FacePragma("ignore");
		if(self:orientation == XmVERTICAL)
			@ = True;
        type = Boolean
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = MFC_CLASS
        get = script get_MFCMenuSeparator_MFC_CLASS:
		FacePragma("ignore");
		if(self:@MFC_ISMENUSEPARATOR){
			@ = "CXfmMenuItem";
		}
		else
		{
			@ = "CSeparator";
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    resources {
    }
    templates {
        MFCCommon = Fm/MFCCommon.fm
    }
} separator
