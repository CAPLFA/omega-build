    activevalue {
        name = MFC_CLASS
        get = script get_MFCMenu_MFC_CLASS:
		FacePragma("ignore");
		if(self:@MFC_ISCOMBOBOX){
			@ = "CComboBox";
		}
		else
		if(self:@MFC_ISMENUBAR){
			@ = "CXfmMenuBar";
		}
		else
		if(self:@MFC_ISMENUPOPUP){
			@ = "CXfmPopupMenu";
		}
		else
		if(self:@MFC_ISPULLDOWN){
			@ = "CXfmPulldownMenu";
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
