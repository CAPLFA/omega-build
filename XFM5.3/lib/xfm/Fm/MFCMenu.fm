widget XmRowColumn {
    flag {
        mapped
    }
    activevalue {
        name = MFC_ISCOMBOBOX
        get = script get_MFCMenu_MFC_ISCOMBOBOX:
		FacePragma("ignore");
		if(self:rowColumnType == XmMENU_OPTION){
			@ = True;
			Widget pd = self:subMenuId;
			if(pd){
				pd:@MFC_ISPULLDOWN = False;
				pd:@MFC_CLASS = "";
				function None _FmWinIgnoreOptSubMenus(Widget pd, Int level)
				{
					Int n = pd:numChildren;
					if(n > 0){
						Widget children[Int] = new_c_array(Pointer(pd:children), n);
						for(i = 0; i < n; i = i+1){
							Widget w = children[i];
							if(level > 0
							&& _FmIsOfSubClass(w, "XmLabel")
							&& !_FmIsOfSubClass(w, "XmCascadeButton")){
								_FmTargetWarning(w, "sub-menus in option menus are not supported");
								w:@MFC_ISMENUITEM = False;
								w:@MFC_CLASS = "";
							}
							else
							if(_FmIsOfSubClass(w, "XmCascadeButton")){
								_FmTargetWarning(w, "sub-menus in option menus are not supported");
								w:@MFC_ISMENUCASCADE = False;
								w:@MFC_CLASS = "";
								Widget subpd = w:subMenuId;
								if(subpd){
									subpd:@MFC_ISPULLDOWN = False;
									subpd:@MFC_CLASS = "";
									_FmWinIgnoreOptSubMenus(subpd, level+1);
								}
							}
						}
						destroy(children);
					}
				}
				_FmWinIgnoreOptSubMenus(pd, 0);
			}
		}
        type = Boolean
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = MFC_R_packing
        get = script get_MFCMenu_MFC_R_packing:
		FacePragma("ignore");
		if(self:rowColumnType == XmWORK_AREA){
			Int p = Int(self:packing);
			if(p == XmPACK_TIGHT)
				@ = "XmPACK_TIGHT";
			else
			if(p == XmPACK_COLUMN)
				@ = "XmPACK_COLUMN";
			else
			if(p == XmPACK_NONE)
				@ = "XmPACK_NONE";
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
