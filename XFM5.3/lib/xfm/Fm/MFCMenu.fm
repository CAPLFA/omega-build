    activevalue {
        name = MFC_R_items
        get = script get_MFCMenu_MFC_R_items:
		FacePragma("ignore");
		if(self:@MFC_ISCOMBOBOX){
			Widget p = self:subMenuId;
			if(p){
				Int n = p:numChildren;
				if(n > 0){
					Widget children[Int] = new_c_array(Pointer(p:children), n);
					String items[Int] = new_array();
					Int length = 1;
					for(Int i = 0; i < n; i = i+1){
						Widget b = children[i];
						items[i] = FmGetString(b:labelString);
						length = length + strlen(items[i]) + 1;
					}
					String choices = XtMalloc(length);
					strcpy(choices, "");
					for(i = 0; i < n; i = i+1){
						strcat(choices, items[i]);
						if(i < n-1)
							strcat(choices, ",");
					}
					@ = _FmWinQuoteString(choices);
				}
			}
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = MFC_N_CBN_CLOSEUP
        get = script get_MFCMenu_MFC_N_CBN_CLOSEUP:
		FacePragma("ignore");
		if(self:@MFC_ISCOMBOBOX){
			Widget p = self:subMenuId;
			if(p){
				Int n = p:numChildren;
				if(n > 0){
					Widget children[Int] = new_c_array(Pointer(p:children), n);
					for(Int i = 0; i < n; i = i+1){
						Widget b = children[i];
						String buf = XtMalloc(1000);
						sprintf(buf,
	'(Widget)FmWGetValue(%%self, "menuHistory") == FmWGetWidget(%%self, 1, "%s.%s")?$XtCallCallbacks(FmWGetWidget(%%self, 1, "%s.%s"), "activateCallback", 0);$none',
							XtName(p), XtName(b),
							XtName(p), XtName(b));
						@ = _FmConcatString(@, buf , "|");
					}
				}
			}
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = MFC_COMBOBOXITEM
        get = script get_MFCMenu_MFC_COMBOBOXITEM:
		FacePragma("ignore");
		if(self:@MFC_ISCOMBOBOX){
			Widget w = self:menuHistory;
			if(w)
				@ = w;
			else {
				Widget p = self:subMenuId;
				if(p){
					Int n = p:numChildren;
					if(n > 0){
						Widget children[Int] = new_c_array(Pointer(p:children), n);
						@ = children[0];
					}
				}
			}
		}
        type = Widget
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
    activevalue {
        name = MFC_R_menuHistory
        get = script get_MFCMenu_MFC_R_menuHistory:
		FacePragma("ignore");
		Widget mh = self:@MFC_COMBOBOXITEM;
		if(mh){
			String name = XtName(mh);
			String pname = XtName(XtParent(mh));
			String mhname = XtMalloc(strlen(pname) + 1 + strlen(name) + 1);
			sprintf(mhname, "%s.%s", pname, name);
			@ = _FmWinQuoteString(mhname);
		}
        type = String
        storage = object
        automatic = true
        autoget = true
        genvalue = true
    }
