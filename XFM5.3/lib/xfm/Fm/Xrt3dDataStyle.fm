	TextFieldSetInsertionPosition (w,TextFieldGetLastPosition (w));\
}\
SetValues (self,1,userData,1);\
function void _Xrt3dDataStyleDownButton (Widget w,Int m) {
	s = w:value;
	n = atoi (String (s));
	if (n > m)
		_Xrt3dDataStyleSetTextFieldIntValue (w,n - 1);
	free (String (s));\
}
