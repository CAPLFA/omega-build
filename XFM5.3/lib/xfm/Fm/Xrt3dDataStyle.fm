	s = w:value;
	n = atoi (String (s));
	if (n < m)
		_Xrt3dDataStyleSetTextFieldIntValue (w,m);
	else
		_Xrt3dDataStyleSetTextFieldIntValue (w,n + 1);
	free (String (s));\
}
