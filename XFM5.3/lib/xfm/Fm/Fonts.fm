                        set = _FmSetFontListSelection (parent.parent,self,$);
                    }
                    resources {
                        listSizePolicy = constant
                        browseSelectionCallback = local XmListCallback cb;\
cb = $;\
if (cb->item_position > 0)
	name = FmGetString(cb->item);\
else
	name = String(0);\
_FmSetFontItem (self,name);\
if (name) {
	form = parent.parent;
	_FmSetFontItem (form.familyscroller.list,String (0));
	XmListDeselectAllItems (form.familyscroller.list);
	form.name:value = name;
	form.samplescroller.sample:fontList = String (name);\
}
