                widget XmRowColumn {
                    flag {
                        mapped
                        autosize
                        autopos
                        menu_option
                    }
                    activevalue {
                        name = _FmFontStyleList
                        set = _FmFillFontOptionMenu (self,$);
                    }
                    activevalue {
                        name = _FmFontStyleItem
                        set = _FmSetFontOptionMenuItem (self,$);
                    }
                    resources {
                        subMenuId = parent.styleMenu
                        marginWidth = 0
                        marginHeight = 0
                        topAttachment = attach_widget
                        topWidget = styleLabel
                        leftAttachment = attach_none
                        spacing = 0
                        labelString = <null>
                    }
                } styleButton
                widget XmLabel {
                    flag {
