#### all: `LCNAME'
#### 
#### `NAME'XfmMain.lo: `NAME'XfmMain.c
#### 	$(LIBTOOL_COMPILE) $(CC) $(CFLAGS) -c `NAME'XfmMain.c
#### 
#### `LCNAME': `NAME'XfmMain.lo
#### 	$(LIBTOOL_LINK) $(CC) $(LDFLAGS) -o `LCNAME' `NAME'XfmMain.lo $(EXTRA_E_LIBS) $(XFM_E_LIBS) $(STD_LIBS)
#### end pattern interface
