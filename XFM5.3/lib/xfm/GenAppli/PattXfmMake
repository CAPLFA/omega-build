#### 					end pattern define
      LIBTOOL = libtool
      LIBTOOL_COMPILE = $(LIBTOOL) --mode=compile
      LIBTOOL_LINK    = $(LIBTOOL) --mode=link
      LIBTOOL_EXEC    = $(LIBTOOL) --mode=execute
      LIBTOOL_CLEAN   = $(LIBTOOL) --mode=clean
      LIBTOOL_INSTALL = $(LIBTOOL) --mode=install

MOTIF_INCPATH = -I/usr/include
MOTIF_LIBPATH = -L/usr/lib
MOTIF_LIBNAME = -lXm

   XT_INCPATH = 
   XT_LIBPATH = 
   XT_LIBNAME = -lXt  -lSM -lICE

 XLIB_INCPATH = 
 XLIB_LIBPATH = 
 XLIB_LIBNAME = -lX11 

 XEXT_INCPATH = 
 XEXT_LIBPATH = 
 XEXT_LIBNAME = -lXext

XFM_E_LIBNAME = -lFm_e

   XFM_E_LIBS = $(XFM_E_LIBNAME)

#### 					begin pattern interface
#### EXTRA_INCPATH = ##-I`XTRA_DIRS'# # $(LOC_INCPATH) XTRA_INCPATH 
#### EXTRA_LIBPATH = ##-L`XTRA_DIRS'# # $(LOC_LIBPATH) XTRA_LIBPATH 
####  EXTRA_E_LIBS = XTRA_E_LIBS XTRA_LIBS
#### 					end pattern interface

   XM_INCPATH = $(MRM_INCPATH) $(MOTIF_INCPATH) $(XT_INCPATH) $(XEXT_INCPATH) $(XLIB_INCPATH)

      INCPATH = -I. $(EXTRA_INCPATH) $(XM_INCPATH) $(XFM_INCPATH)
       X_LIBS =  $(XT_LIBPATH) $(XT_LIBNAME) $(XEXT_LIBPATH) $(XEXT_LIBNAME) $(XLIB_LIBPATH) $(XLIB_LIBNAME)
   MOTIF_LIBS =  $(MRM_LIBPATH) $(MRM_LIBNAME) $(MOTIF_LIBPATH) $(MOTIF_LIBNAME) $(X_LIBS)

     SYS_LIBS =

   SYS_CFLAGS =  -DMOTIF_1_2 -DMOTIF_2_1 -DMOTIF_2_2 -D__GLIBC_2_3_2__ -DHAS_GLS -DINTERNATIONALIZATION
  SYS_LDFLAGS =
  CDEBUGFLAGS =

     STD_LIBS = $(MOTIF_LIBS) -lm $(SYS_LIBS)

      LIBPATH = -L. $(EXTRA_LIBPATH) $(XFM_LIBPATH)

       CFLAGS = $(INCPATH) $(SYS_CFLAGS) $(CDEBUGFLAGS)

      LDFLAGS = $(LIBPATH) $(SYS_LDFLAGS) $(CDEBUGFLAGS)

           RM = rm -f
           CP = cp
           LN = ln -s

#### begin pattern interface
