   WINDOWSDIR = Windows
    WINOUTDIR = WinOut

#### begin pattern interface
#### 	set global ALLWINFILES = WINAPPFILES
####   WINAPPFILES = \\
#### 	begin if [ SHORTWINDOWSFILENAMES ]
#### 		set local LNAME5 = [ lower (NAME left 5) ]
#### 		set local LNAME8 = [ lower (NAME left 8) ]
#### 	ifelse
#### 		set local LNAME5 = NAME
#### 		set local LNAME8 = NAME
#### 	end if
#### 	$(WINDOWSDIR)/`LNAME8'.mak \\
#### 	$(WINDOWSDIR)/`LNAME8'.h \\
#### 	$(WINDOWSDIR)/`LNAME8'.cpp \\
#### 	$(WINDOWSDIR)/`LNAME8'.rc \\
#### 	$(WINDOWSDIR)/`LNAME5'App.h \\
#### 	$(WINDOWSDIR)/`LNAME5'App.cpp \\
#### 	$(WINDOWSDIR)/`LNAME5'Res.h \\
#### 	$(WINDOWSDIR)/stdafx.cpp \\
#### 	$(WINDOWSDIR)/stdafx.h
#### 
#### 	begin if [ PROJECTFILE != "" ]
#### 		set local FMFILES = PROJECTFILE
#### 	ifelse
#### 		set local FILES = FILES`'
#### 		set local I = 1
#### 		set local F = [ FILES [ I ]
#### 		set local SEP = `'
#### 		set local FMFILES = `'
#### 		begin while [ F != "" ]
#### 			set local FMFILES = FMFILES`SEP'F
#### 			set local I = [ I + 1 ]
#### 			set local F = [ FILES [ I ]
#### 			set local SEP = ` '
#### 		end while
