#### begin pattern module
#### 	begin if [ SHORTWINDOWSFILENAMES ]
#### 		set local LNAME5 = NAME
#### 	ifelse
#### 		set local LNAME5 = NAME
#### 	end if
#### 	set local UNAME = [ upper NAME ]
#### 	set local MODULEFILES = WIN`UNAME'MODFILES
#### 	set local MODULEFILES = [ MODULEFILES ]
#### 	set global ALLWINFILES = ALLWINFILES MODULEFILES
