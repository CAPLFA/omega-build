#### begin pattern module
#### 	begin if [ FILE right 3 == ".fm" ]
#### 		set local BASEFILE = [ FILE left (length FILE - 3) ]
#### 	ifelse
#### 		set local BASEFILE = FILE
#### 	end if
#### 	begin if [ BASEFILES == "" ]
#### 		set global BASEFILES = BASEFILE
#### 	ifelse
#### 		set global BASEFILES = BASEFILES BASEFILE
#### 	end if
#### 	begin if [ MAINCFILE == "" ]
#### 		set global MAINCFILE = BASEFILE.c
#### 	end if
#### end pattern module

