#!/bin/csh -f

#set verbose=1

############################################################
############################################################
##
## xfmwincvt : 	Convert files generated by XFaceMaker/Win
##		to DOS format, and optionally copy them
##		to a DOS system through the network.
##
## Usage: xfmwincvt [ files... ]
## 
## If no files are specified, all the files in the `Windows'
## directory are converted.
## 
## Converted files are stored in a directory called `WinOut'.
## 
############################################################
############################################################

set windowsdir=Windows
set winoutdir=WinOut
set unix2dos=xfmunix2dos

if ( ! ${?XFMWIN_PROTOCOL} ) 		set XFMWIN_PROTOCOL=""
if ( ! ${?XFMWIN_PC_NAME} ) 		set XFMWIN_PC_NAME=""
if ( ! ${?XFMWIN_PC_PART} ) 		set XFMWIN_PC_PART=""
if ( ! ${?XFMWIN_PC_DIR} ) 		set XFMWIN_PC_DIR=""
if ( ! ${?XFMWIN_PC_HOME} ) 		set XFMWIN_PC_HOME=""

if ( ${#argv} == 0 ) then
	set files=${windowsdir}/*
else
	set files=($*)
endif

if ( ! ${?XFMWIN_PROTOCOL} || ( "${XFMWIN_PROTOCOL}" != "SMB" && "${XFMWIN_PROTOCOL}" != "NFS" )) then
	set copy=false
	goto doit
endif
if ( "${XFMWIN_PROTOCOL}" == "SMB" ) then
	if ( ! ${?XFMWIN_PC_NAME} || "${XFMWIN_PC_NAME}" == "" ) then
		set copy=false
		goto doit
	endif
	if ( ! ${?XFMWIN_PC_PART} || "${XFMWIN_PC_PART}" == "" ) then
		set XFMWIN_PC_PART=c
	endif
endif
set copy=true
if ( ! ${?XFMWIN_PC_DIR} || "${XFMWIN_PC_DIR}" == "" ) then
	set XFMWIN_PC_DIR=$cwd
	set XFMWIN_PC_DIR=${XFMWIN_PC_DIR:t}
endif

if ( ${?XFMWIN_PC_HOME} && "${XFMWIN_PC_HOME}" != "" ) then
	set XFMWIN_PC_DIR=${XFMWIN_PC_HOME}/${XFMWIN_PC_DIR}
endif

if ( "${XFMWIN_PROTOCOL}" == "SMB" ) then
	set dstdisk=\\\\${XFMWIN_PC_NAME}\\${XFMWIN_PC_PART}
	set dstdir=${XFMWIN_PC_DIR}
	set prtdstdir=//${XFMWIN_PC_NAME}/${XFMWIN_PC_PART}:${dstdir}
	echo "prompt\
mkdir ${dstdir}" | smbclient "${dstdisk}" -U ${USER}% > /dev/null
else if ( "${XFMWIN_PROTOCOL}" == "NFS" ) then
	set dstdir=${XFMWIN_PC_DIR}
	set prtdstdir=${dstdir}
	if ( ! -d ${dstdir} ) then
		mkdir ${dstdir}
	endif
endif

doit:

if ( ! -d ${winoutdir} ) then
	mkdir ${winoutdir}
endif

foreach f ( ${files} )
	set b=${f:t}
	if ( ${b} !~ *~ ) then
		set dir=${f:h}
		if ( ${dir} == ${f} ) then
			set dir=.
		endif
		set cached=${dir}/.last.${b}
		
		set w=${winoutdir}/${b}
		
		if ( -f ${cached} && -f ${w} ) then
			if { cmp -s ${f} ${cached} } then
				continue
			endif
		endif
		
		rm -f ${w}
		
		set ok=false
		if ( ${b} !~ *.bmp && ${b} !~ *.ico && ${b} !~ *.hlp && ${b} !~ *.exe && ${b} !~ *.lib && ${b} !~ *.dll ) then
			if { (sed -e '\|//## |d' -e '\|#### |d' ${f} | xfmunix2dos > ${w}) } then
				set ok=true
			endif
		else
			if { cp ${f} ${w} } then
				set ok=true
			endif
		endif
		if ( ${copy} == true ) then
			set wf=${w}
			set wb=${wf:t}
			set dstfile=${dstdir}/${wb}
			
			# Look at the cached version (last version sent) to see if the file is actually modified.
			
			echo "Copying ${wf} to ${prtdstdir}/${wb}..."
			if ( "${XFMWIN_PROTOCOL}" == "SMB" ) then
				if { (echo "prompt\
put ${wf} ${dstfile}" | smbclient "${dstdisk}" -U ${USER}% | grep ERR ) } then
					true
					set ok=false
				else
					set ok=true
				endif
			else if ( "${XFMWIN_PROTOCOL}" == "NFS" ) then
				if { cp ${wf} ${dstfile} } then
					set ok=true
				else
					set ok=false
				endif
			endif
		endif
		
		if ( ${ok} == "true" ) then
			rm -f ${cached}
			cp ${f} ${cached}
		endif
	endif
end
